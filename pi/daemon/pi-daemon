#!/usr/bin/env python3
"""Locate the library beside this entry point and run the daemon."""

import os
import sys

# A checkout has pi/daemon/pi-daemon and pi/lib/; an installed generation
# has daemon/pi-daemon and lib/. The whole lib directory goes first on the
# path so the package and the seam modules it imports resolve exactly as
# they were installed, never from some other Python environment.
LIB = os.path.abspath(os.path.join(
    os.path.dirname(os.path.realpath(__file__)), os.pardir, "lib"))
sys.path.insert(0, LIB)
# The library lives in a published release, which nothing may write to: a
# __pycache__ beside the modules would change the tree a newer install
# hashes for retention.
sys.dont_write_bytecode = True

from pi_daemon.entry import DaemonEntry


if __name__ == "__main__":
    sys.exit(DaemonEntry().main())
