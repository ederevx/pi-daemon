def ext_root_fingerprint(roots):
	"""{(abs_path): (mtime_ns, size)} for every file under roots; missing
	paths are skipped and directories are walked. Cheap per-poll change
	detection for the extension-reload watcher. Values are int tuples so
	the on-disk snapshot round-trips exactly (JSON arrays become tuples
	again on read)."""
	fp = {}
	for root in roots:
		try:
			if os.path.isfile(root):
				st = os.stat(root)
				fp[os.path.abspath(root)] = (st.st_mtime_ns, st.st_size)
			elif os.path.isdir(root):
				for dirpath, _dirs, files in os.walk(root):
					for fn in files:
						path = os.path.join(dirpath, fn)
						try:
							st = os.stat(path)
						except OSError:
							continue
						fp[path] = (st.st_mtime_ns, st.st_size)
		except OSError:
			continue
	return fp


def ext_diff_files(old, new):
	"""File-level diff between two fingerprints: added / removed / changed
	absolute paths, each sorted."""
	added = sorted(set(new) - set(old))
	removed = sorted(set(old) - set(new))
	changed = sorted(p for p in set(old) & set(new) if old[p] != new[p])
	return {"added": added, "removed": removed, "changed": changed}


def _read_ext_snapshot():
	"""Last-known extension fingerprint, or None before any baseline.
	JSON turns the stored mtime/size tuples into arrays; fold them back
	into tuples so the comparison on read is exact."""
	rec = pi_platform.AtomicStateFile(EXT_SNAPSHOT_PATH).read()
	if not isinstance(rec, dict):
		return None
	fp = rec.get("fingerprint")
	if not isinstance(fp, dict):
		return None
	return {k: tuple(v) for k, v in fp.items()}


def _write_ext_snapshot(fp, diff):
	pi_platform.AtomicStateFile(EXT_SNAPSHOT_PATH).write(
		{"fingerprint": fp, "diff": diff})


def _write_ext_diff(diff):
	pi_platform.AtomicStateFile(EXT_DIFF_PATH).write(diff)


def _new_reload_token():
	"""A fresh one-shot token for one reload round: signals consumed in
	earlier rounds (same session, same token) can never fire again."""
	return "%s-%d" % (os.urandom(8).hex(), time.time_ns())


def _reload_signal_path(name):
	return os.path.join(EXT_RELOAD_SIGNAL_DIR, "%s.json" % name)


def _write_reload_signal(name, token):
	"""Persist one session's reload signal atomically (the extension
	watches the directory and reads the final file only). Returns False
	when the name is not a safe single file component or the write
	fails; the caller then falls back to typing into the PTY."""
	if not name or name in (".", "..") or os.sep in name \
			or (os.altsep and os.altsep in name):
		return False
	path = _reload_signal_path(name)
	try:
		pi_platform.AtomicStateFile(path).write(
			{"token": token, "written": time.time()})
	except OSError:
		return False
	return True


def _clear_reload_signal(name):
	try:
		os.unlink(_reload_signal_path(name))
	except OSError:
		pass


def _purge_signal_dir(directory):
	# Remove every .json a previous daemon run left under a per-session
	# signal directory; a stale signal must never drive a fresh session.
	try:
		for fn in os.listdir(directory):
			if fn.endswith(".json"):
				try:
					os.unlink(os.path.join(directory, fn))
				except OSError:
					pass
	except OSError:
		pass


def _clear_stale_reload_signals():
	"""Daemon startup: signals left behind by a previous daemon run
	targeted sessions that are gone; a fresh session with the same name
	would otherwise consume a stale round token on first watch. Drop
	them: the extension only ever fires on a token the daemon wrote for
	the live round."""
	_purge_signal_dir(EXT_RELOAD_SIGNAL_DIR)


def _clear_stale_idle_warnings():
	"""Daemon startup: idle-warning files from a previous daemon run
	name sessions that are gone. A respawned session with the same name
	would otherwise be steered by an ask no live window backs, so drop
	them; only a warning this run writes opens a real window."""
	_purge_signal_dir(IDLE_WARNING_DIR)


