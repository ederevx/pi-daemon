def argv_session_file(argv):
	"""The conversation file a registry argv resumes (the element after
	--session), or None for a blank-start argv. One conversation key per
	registry entry; duplicates of the same conversation file must never
	be respawned side by side."""
	argv = list(argv or [])
	for i, arg in enumerate(argv):
		if arg == "--session" and i + 1 < len(argv):
			return argv[i + 1]
	return None


class LineReader:
	"""Incremental JSON-line reader over a control socket."""

	def __init__(self, sock):
		self.sock = sock
		self.buf = b""

	def readline(self):
		while b"\n" not in self.buf:
			if len(self.buf) > MAX_BUF:
				raise ValueError("line too long")
			data = self.sock.recv(65536)
			if not data:
				if self.buf:
					raise ValueError("truncated line")
				return None
			self.buf += data
		line, self.buf = self.buf.split(b"\n", 1)
		return line


class Registry:
	"""The on-disk session registry: daemon-restart respawn state. Every
	persistent byte flows through AtomicStateFile (its single owner)."""

	def __init__(self, path):
		self.path = path
		self._file = pi_platform.AtomicStateFile(path)
		self._lock = threading.Lock()

	def load(self):
		return self._file.read_dict()

	def write(self, data):
		# Atomic replacement so readers never see a partial file.
		with self._lock:
			self._store(data)

	def _store(self, data):
		# Caller holds _lock: every mutation is one load-modify-write
		# under the lock, so a concurrent set_argv can no longer resurrect
		# a name drop() just removed (a stale respawn on daemon restart).
		self._file.write(data)

	def add(self, name, dir_, argv):
		with self._lock:
			data = self.load()
			data[name] = {"dir": dir_, "argv": list(argv)}
			self._store(data)

	def drop(self, name):
		with self._lock:
			data = self.load()
			if name in data:
				del data[name]
				self._store(data)

	def set_argv(self, name, argv):
		# An announced session file rewrites the resume argv so a daemon
		# restart respawns the same conversation instead of a blank one.
		with self._lock:
			data = self.load()
			if name in data:
				data[name]["argv"] = list(argv)
				self._store(data)

	def dedupe(self, file_of, prefer=None):
		"""Keep one entry per conversation file: races and earlier daemon
		eras can leave two registry names resuming the same --session
		file, and respawning both would run diverging copies of one
		conversation. Entries whose argv carries no conversation file
		(blank starts) are never duplicates and stay untouched. Ties are
		broken by the lexicographically first name; a prefer(name)
		callback (the live session's viewer count) pulls the attached
		session's entry forward instead. Returns (keep, drop) name
		lists; dropped entries are removed from the store."""
		keep, drop = {}, []
		with self._lock:
			data = self.load()
			for name in sorted(data):
				key = file_of(data[name].get("argv"))
				if not key:
					continue
				if key not in keep:
					keep[key] = name
					continue
				if prefer is not None and prefer(name) \
						and not prefer(keep[key]):
					drop.append(keep[key])
					keep[key] = name
				else:
					drop.append(name)
			for name in drop:
				del data[name]
			if drop:
				self._store(data)
		return keep, drop


class DaemonRoster:
	"""Live-daemon roster in the state dir: every daemon publishes its
	control coordinates here at bind time and drops its entry at exit,
	and the newest daemon shuts older entries down at boot. This is the
	single-daemon guarantee: a restart (daemon-restart) and strays left
	by the endpoint-hijack eras (each start once overwrote the endpoint
	file while older daemons kept running) converge to exactly one live
	daemon. A peer is stopped gracefully through its own roster
	coordinates; a peer whose port refuses connections is dead and its
	stale entry is pruned. Each entry also records the publisher's
	process start token, so a lingering pid is only ever signalled
	while it is still the daemon that published it - a recycled pid is
	never killed. Daemons that predate the roster publish no
	coordinates and are invisible to it: stop them once manually
	(pi-rc daemon-stop against their endpoint, or a process kill as the
	documented fallback)."""

	def __init__(self, path):
		self.path = path
		self._file = pi_platform.AtomicStateFile(path)
		# Reentrant: shutdown_others prunes entries (remove) while it
		# holds the lock over its whole candidate pass.
		self._lock = threading.RLock()

	def register(self, pid, host, port, token):
		with self._lock:
			data = self._load()
			data[str(int(pid))] = {"host": str(host), "port": int(port),
								   "token": str(token),
								   "started": time.time(),
								   "start_token": PROCESS.process_start_token(pid)}
			self._store(data)

	@staticmethod
	def _wait_peer_gone(pid, token, timeout):
		"""Wait (bounded) until a stopped peer's process is fully gone:
		its control port can die before its exit teardown runs, and that
		teardown removes the shared endpoint file - the boot must not
		publish its own endpoint until the peer has actually exited.
		A live pid whose start token no longer matches the peer's
		published one is a recycled pid: the original is gone. Returns
		True once the peer is gone, False if it lingers."""
		deadline = time.time() + timeout
		while PROCESS.pid_alive(pid) \
				and PROCESS.pid_matches_token(pid, token):
			if time.time() >= deadline:
				return False
			time.sleep(0.05)
		return True

	def remove(self, pid):
		with self._lock:
			data = self._load()
			if str(int(pid)) in data:
				del data[str(int(pid))]
				self._store(data)

	def _load(self):
		return self._file.read_dict()

	def _store(self, data):
		self._file.write(data)

	def shutdown_others(self, pid, started, timeout=2.0):
		"""Gracefully stop every roster entry strictly older than
		(started, pid): one candidate order, so two concurrent boots
		never shut each other down - only the newer wins. Unreachable
		(but listening) peers are left alone and reported; dead peers'
		entries are pruned. Returns (stopped, pruned)."""
		stopped, pruned = 0, 0
		with self._lock:
			data = self._load()
			mine = (float(started), int(pid))
			for key in sorted(data):
				rec = data[key]
				try:
					peer = (float(rec.get("started", 0)), int(key))
				except (TypeError, ValueError):
					continue
				if peer >= mine:
					continue
				outcome = self._peer_shutdown(rec, timeout)
				if outcome == "unreachable":
					log("roster: live peer at %s:%s did not accept a "
						"shutdown; left running" % (rec.get("host"),
													rec.get("port")))
					continue
				self.remove(int(key))
				if outcome == "stopped":
					if not self._wait_peer_gone(int(key),
												rec.get("start_token"),
												timeout):
						# The peer acknowledged the shutdown but its exit
						# teardown is still running (or it lied): the boot
						# must not proceed beside a live older daemon,
						# whose exit cleanup would race the newcomer's
						# endpoint publish. Kill it by its roster pid.
						self._force_kill_peer(int(key),
											  rec.get("start_token"))
					stopped += 1
					log("roster: shut down older daemon pid %s" % key)
				else:
					pruned += 1
					log("roster: pruned dead daemon pid %s" % key)
		return stopped, pruned

	@staticmethod
	def _peer_shutdown(rec, timeout):
		"""One graceful control shutdown through a roster entry's own
		{host, port, token}: the exact handshake the endpoint publishes,
		aimed at the peer's published coordinates instead. Returns
		"stopped", "dead" (port refused: no process owns it), or
		"unreachable" (something answered badly or the connection failed
		mid-handshake)."""
		try:
			sock = socket.create_connection(
				(str(rec.get("host")), int(rec.get("port"))), timeout)
		except (ConnectionRefusedError, TimeoutError):
			return "dead"
		except OSError:
			return "unreachable"
		try:
			sock.settimeout(timeout)
			reader = LineReader(sock)
			send_json(sock, {"cmd": "hello", "token": rec.get("token") or ""})
			ack = json.loads(reader.readline().decode())
			if not ack.get("ok"):
				return "unreachable"
			send_json(sock, {"cmd": "shutdown"})
			reply = json.loads(reader.readline().decode())
			return "stopped" if reply.get("ok") else "unreachable"
		except (OSError, ValueError, AttributeError):
			return "unreachable"
		finally:
			kill_socket(sock)

	@staticmethod
	def _force_kill_peer(pid, token, grace=KILL_GRACE):
		"""Kill a lingering peer by the pid it published in the roster:
		TERM, a bounded reap wait, then KILL. Best effort - a peer that
		vanishes mid-kill or cannot be signalled just logs. The pid is only
		signalled while it still matches the peer's published start token:
		a recycled pid must never receive the kill."""
		if not pid or not hasattr(os, "kill"):
			return
		if not PROCESS.pid_matches_token(pid, token):
			log("roster: pid %d is not the published daemon anymore; "
				"left alone" % pid)
			return
		log("roster: peer pid %d lingers after shutdown; killing" % pid)
		try:
			os.kill(pid, signal.SIGTERM)
		except OSError:
			return
		if DaemonRoster._wait_peer_gone(pid, token, grace):
			return
		try:
			os.kill(pid, signal.SIGKILL)
		except OSError:
			pass


class TicketStore:
	"""Durable offloaded-command ticket state: one tickets.json plus one
	output log per ticket. The in-memory dict is authoritative; every
	mutation is written through atomically like Registry. The store's
	lock doubles as the wait condition so ticket completion signals
	blocked ticket-wait callers."""

	def __init__(self, path, log_dir):
		self.path = path
		self.log_dir = log_dir
		self._file = pi_platform.AtomicStateFile(path)
		self.lock = threading.Lock()
		self.cond = threading.Condition(self.lock)
		self._tickets = {}
		self._next = 1

	def load(self):
		data = self._file.read_dict()
		tickets = data.get("tickets")
		self._tickets = tickets if isinstance(tickets, dict) else {}
		try:
			self._next = int(data.get("next", 1))
		except (TypeError, ValueError):
			self._next = 1
		if self._next < 1:
			self._next = 1

	def _write_locked(self):
		# Caller holds the lock: one atomic write-through (the AtomicStateFile
		# owns the temp-fsync-replace mechanics).
		self._file.write({"next": self._next, "tickets": self._tickets})

	def alloc_id_locked(self, session=None):
		# Caller holds the lock: ids must strictly increase across the
		# whole persisted history, so the counter rides the same file.
		# A short session segment rides the id itself (t-<seg>-<n>) so a
		# ticket names the session it belongs to without a separate
		# lookup; the global counter keeps ids unique across sessions.
		n = self._next
		self._next += 1
		seg = self._session_segment(session)
		if seg:
			return "t-%s-%d" % (seg, n)
		return "t-%d" % n

	@staticmethod
	def _session_segment(session):
		# The trailing token of the session key (hosted ``ederevx-5e9a``
		# -> ``5e9a``, a conversation file stem -> its UUID tail) is short,
		# stable, and usually unique. The record still stores the full key
		# for exact filtering; the id segment is for identification.
		if not session:
			return ""
		raw = str(session).rsplit("-", 1)[-1]
		return "".join(ch if ch.isalnum() or ch == "_" else "_" for ch in raw)

	def add(self, rec):
		with self.lock:
			self._tickets[rec["id"]] = rec
			self._write_locked()
			return dict(rec)

	def get(self, tid):
		with self.lock:
			rec = self._tickets.get(tid)
			return dict(rec) if rec is not None else None

	def get_locked(self, tid):
		# Caller already holds the lock (directly or via cond.wait).
		return self._tickets.get(tid)

	def snapshot(self, session=None, kind=None):
		with self.lock:
			recs = [dict(r) for r in self._tickets.values()
					if (session is None or r.get("session") == session)
					and (kind is None
						 or r.get("kind", "shell") == kind)]
		# Oldest first. The id carries a session segment, so it is no
		# longer numerically ordered across sessions; creation time is the
		# true order, with the id as a stable tiebreaker.
		return sorted(recs, key=lambda r: (r.get("created", 0), r.get("id", "")))

	def update(self, tid, **fields):
		# Mutate, persist, and broadcast under one lock; the broadcast
		# wakes every blocked ticket-wait caller.
		with self.cond:
			rec = self._tickets.get(tid)
			if rec is None:
				return None
			rec.update(fields)
			self._write_locked()
			self.cond.notify_all()
			return dict(rec)

	def mark_interrupted(self):
		# Daemon restart: subprocesses spawned with start_new_session
		# survive a hard kill of this process, so before declaring the
		# tickets lost, kill their process groups. A revived session's
		# replay of the same command is then a single fresh execution,
		# never a shadow twin of a still-running orphan. Logs survive
		# for inspection until GC.
		with self.lock:
			changed = False
			for rec in self._tickets.values():
				if rec.get("status") == "running":
					pid = rec.get("pid")
					if pid:
						PROCESS.signal_kill(pid)
					rec["status"] = "lost"
					rec["finished"] = time.time()
					rec["error"] = "interrupted by daemon restart"
					changed = True
			if changed:
				self._write_locked()

	def log_path(self, tid):
		return os.path.join(self.log_dir, "%s.log" % tid)

	def artifact_path(self, tid, kind):
		# Only the merged command/stdout log exists for shell tickets;
		# the suffix switch is kept for legacy agent artifacts.
		suffix = {"log": ".log", "err": ".err", "prompt": ".prompt"}[kind]
		return os.path.join(self.log_dir, "%s%s" % (tid, suffix))

	def unlink_artifacts(self, tid):
		for suffix in (".log", ".err", ".prompt"):
			try:
				os.unlink(os.path.join(self.log_dir, "%s%s" % (tid, suffix)))
			except OSError:
				pass

	def remove(self, tid):
		# Finished tickets drop from the store and disk; running tickets
		# must be cancelled first (raise ValueError("running")).
		with self.lock:
			rec = self._tickets.get(tid)
			if rec is None:
				return None
			if rec.get("status") == "running":
				raise ValueError("running")
			del self._tickets[tid]
			self._write_locked()
		self.unlink_artifacts(tid)
		return rec

	def reset(self):
		# Wipe every record and artifact and restart the id counter: a
		# clean ticketing slate for reset purposes. Callers cancel running
		# tickets first; any still marked running here are wiped regardless
		# (their processes were killed by the reset path).
		with self.lock:
			tids = list(self._tickets)
			count = len(tids)
			self._tickets = {}
			self._next = 1
			self._write_locked()
		for tid in tids:
			self.unlink_artifacts(tid)
		return count

	def read_range(self, path, offset, cap):
		# Returns (start, next, size, data); offset past size yields empty
		# data with next == offset so relays never stall on a bad offset.
		try:
			size = os.path.getsize(path)
		except OSError:
			size = 0
		if offset >= size:
			return offset, offset, size, b""
		length = min(cap, size - offset)
		try:
			with open(path, "rb") as f:
				f.seek(offset)
				data = f.read(length)
		except OSError:
			data = b""
		return offset, offset + len(data), size, data

	def gc(self, now, ttl, max_finished):
		# Running tickets never expire; finished tickets drop after ttl
		# seconds, plus the oldest ones beyond the finished cap. Expired
		# output logs are unlinked by the caller.
		with self.lock:
			finished = sorted(
				(tid for tid, r in self._tickets.items()
				 if r.get("status") != "running"),
				key=lambda tid: self._tickets[tid].get("finished") or 0.0)
			removed = [tid for tid in finished
					   if now - (self._tickets[tid].get("finished") or 0.0) > ttl]
			for tid in finished:
				if len(finished) - len(removed) <= max_finished:
					break
				if tid not in removed:
					removed.append(tid)
			for tid in removed:
				del self._tickets[tid]
			if removed:
				self._write_locked()
		return removed


class TicketRunner:
	"""Runs offloaded commands as daemon-owned subprocesses: one output
	log per ticket, condition-signalled completion, a periodic GC sweep,
	and a stop() that reaps children before daemon shutdown persists."""

	def __init__(self, store, shutdown_event):
		self.store = store
		self.shutdown_event = shutdown_event
		self._lock = threading.Lock()
		self._procs = {}    # tid -> Popen, under _lock
		self._stops = {}    # tid -> cancellation reason, under _lock

	def start(self):
		self.store.load()
		self.store.mark_interrupted()
		t = threading.Thread(target=self._gc_loop, daemon=True)
		t.start()

	def running_count(self):
		with self._lock:
			return len(self._procs)

	def submit(self, session, cwd, command, env=None):
		with self._lock:
			if len(self._procs) >= TICKET_MAX_RUNNING:
				return None
		with self.store.lock:
			tid = self.store.alloc_id_locked(session)
		rec = {"id": tid, "kind": "shell", "session": session, "cwd": cwd,
			   "command": command,
			   "status": "running", "created": time.time(),
			   "started": time.time(), "finished": None, "exit": None,
			   "term": None, "truncated": False, "error": None}
		os.makedirs(self.store.log_dir, exist_ok=True)
		run_env = env if env else os.environ.copy()
		argv = PROCESS.shell_command(command, run_env.get("PI_SHELL"))
		extra = PROCESS.group_kwargs()
		proc = subprocess.Popen(
			argv, cwd=cwd,
			env=run_env,
			stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
			stderr=subprocess.STDOUT, bufsize=0, **extra)
		rec["pid"] = proc.pid
		try:
			rec = self.store.add(rec)
		except OSError as exc:
			# The record never persisted, so no reader thread or cancel
			# path will ever own this child: close its output pipe, kill
			# it, and reap before reporting the failure so no orphan keeps
			# running unmanaged and no pipe fd is left behind.
			try:
				proc.stdout.close()
			except OSError:
				pass
			PROCESS.signal_kill(proc.pid)
			try:
				proc.wait(timeout=KILL_GRACE)
			except Exception:
				pass
			log("ticket-submit '%s' aborted: %s" % (tid, exc))
			raise
		with self._lock:
			self._procs[tid] = proc
		t = threading.Thread(target=self._run, args=(tid, proc), daemon=True)
		t.start()
		log("ticket-submit '%s' session '%s' in %s"
			% (tid, session, cwd))
		return rec

	def find_running(self, session, cwd, command):
		# Replay suppression: an identical (session, cwd, command) ticket
		# that is still running is the same logical request re-emitted
		# (soft-compaction continuation, crash-resume replay) - a session
		# runs one blocking shell ticket at a time, so a concurrent twin
		# is never an independent second request. Reuse it instead of
		# executing the command twice.
		for rec in self.store.snapshot(session, "shell"):
			if (rec.get("status") == "running"
					and rec.get("cwd") == cwd
					and rec.get("command") == command):
				return rec
		return None

	def wait(self, tid, timeout):
		deadline = time.time() + max(0.0, min(float(timeout or 0), TICKET_MAX_WAIT))
		with self.store.cond:
			rec = self.store.get_locked(tid)
			if rec is None:
				return None
			while rec["status"] == "running" and time.time() < deadline:
				self.store.cond.wait(deadline - time.time())
				rec = self.store.get_locked(tid)
				if rec is None:
					return None
			rec = self.store.get_locked(tid)
			if rec is None:
				return None
			if rec["status"] == "running":
				with self._lock:
					proc = self._procs.get(tid)
				if proc is not None and proc.poll() is not None:
					settle_deadline = time.time() + 0.5
					while rec["status"] == "running" and time.time() < settle_deadline:
						self.store.cond.wait(0.05)
						rec = self.store.get_locked(tid)
						if rec is None:
							return None
			return dict(rec)

	def output(self, tid, offset):
		rec = self.store.get(tid)
		if rec is None:
			return None
		path = self.store.log_path(tid)
		try:
			size = os.path.getsize(path)
		except OSError:
			size = 0
		if offset >= size:
			return {"offset": offset, "next": offset, "size": size,
					"data": b""}
		length = min(TICKET_CHUNK, size - offset)
		try:
			with open(path, "rb") as f:
				f.seek(offset)
				data = f.read(length)
		except OSError:
			data = b""
		return {"offset": offset, "next": offset + len(data), "size": size,
				"data": data}

	def cancel(self, tid):
		rec = self.store.get(tid)
		if rec is None:
			return None
		if rec["status"] != "running":
			return rec
		with self._lock:
			proc = self._procs.get(tid)
			if proc is not None and proc.poll() is None:
				self._stops[tid] = "cancelled"
				target = proc
			else:
				target = None
		if target is None:
			# Reaped between the record read and here: the runner thread's
			# final update lands within a moment; wait for it.
			self.wait(tid, 5.0)
			return self.store.get(tid)
		PROCESS.signal_term(target.pid)
		deadline = time.time() + KILL_GRACE
		while time.time() < deadline and target.poll() is None:
			time.sleep(0.05)
		if target.poll() is None:
			PROCESS.signal_kill(target.pid)
		try:
			target.wait(timeout=KILL_GRACE)
		except Exception:
			pass
		return self.store.get(tid)

	def _run(self, tid, proc):
		# Reader thread: append the child's merged stdout/stderr to the
		# ticket log until the output cap, then record the exit.
		captured = 0
		truncated = False
		logf = None
		try:
			logf = open(self.store.log_path(tid), "wb")
		except OSError as exc:
			log("ticket '%s' log open failed: %s" % (tid, exc))
		try:
			while True:
				try:
					# bufsize=0: os.read returns whatever is available, so
					# incremental output lands in the log as it is produced.
					chunk = os.read(proc.stdout.fileno(), 65536)
				except OSError:
					chunk = b""
				if not chunk:
					break
				if logf is None:
					truncated = True
				elif captured < TICKET_OUTPUT_MAX:
					room = TICKET_OUTPUT_MAX - captured
					logf.write(chunk[:room])
					logf.flush()
					captured += min(len(chunk), room)
					if len(chunk) > room:
						truncated = True
						logf.close()
						logf = None
				else:
					truncated = True
		finally:
			if logf is not None:
				logf.close()
			try:
				proc.stdout.close()
			except OSError:
				pass
			code = proc.wait()
		self._finish(tid, code, truncated)

	def _finish(self, tid, code, truncated):
		with self._lock:
			self._procs.pop(tid, None)
			reason = self._stops.pop(tid, None)
		fields = {"status": "done" if code == 0 else "failed",
				  "exit": code if code >= 0 else None,
				  "term": -code if code < 0 else None,
				  "finished": time.time(), "truncated": truncated}
		if reason is not None:
			fields["status"] = "cancelled"
			fields["error"] = reason
		self.store.update(tid, **fields)
		log("ticket-done '%s' status %s" % (tid, fields["status"]))

	def _gc_loop(self):
		while not self.shutdown_event.wait(TICKET_GC_TICK):
			try:
				removed = self.store.gc(time.time(), TICKET_TTL,
										TICKET_MAX_FINISHED)
				for tid in removed:
					self.store.unlink_artifacts(tid)
				if removed:
					log("ticket-gc removed %d" % len(removed))
			except Exception as exc:
				log("ticket-gc error: %r" % (exc,))

	def stop(self):
		# Daemon shutdown: TERM every running child, bounded grace, KILL,
		# then force any record the reader threads lost the race on to
		# "lost" so the persisted state never claims a live process.
		with self._lock:
			procs = list(self._procs.values())
			tids = list(self._procs.keys())
			for tid in tids:
				self._stops.setdefault(tid, "interrupted by daemon shutdown")
		for proc in procs:
			PROCESS.signal_term(proc.pid)
		deadline = time.time() + KILL_GRACE
		while time.time() < deadline:
			with self._lock:
				if not self._procs:
					break
			time.sleep(0.05)
		with self._lock:
			alive = list(self._procs.values())
		for proc in alive:
			PROCESS.signal_kill(proc.pid)
		for proc in alive:
			try:
				proc.wait(timeout=KILL_GRACE)
			except Exception:
				pass
		for tid in tids:
			rec = self.store.get(tid)
			if rec is not None and rec["status"] == "running":
				self.store.update(tid, status="lost", finished=time.time(),
							  error="interrupted by daemon shutdown")


class RestartPlanner:
	"""Prepares the handover to a successor daemon: one registry entry
	per conversation, then a detached successor launch."""

	def __init__(self, registry, table):
		self.registry = registry
		self.table = table

	def dedupe_registry(self):
		"""One registry entry per conversation file before the successor
		respawns it. The live table breaks ties toward the session a
		viewer is attached to; absent that, the lexicographically first
		name survives. Returns (keep, drop) name lists."""
		with self.table.lock:
			def prefer(name):
				sess = self.table.get(name)
				return sess is not None and sess.count_clients() > 0
			return self.registry.dedupe(argv_session_file, prefer)

	def spawn_successor(self, script, log_path):
		"""Start the detached successor daemon from the installed script
		this process runs, exactly like pi-rc daemon-start launches one
		(windowless interpreter, daemon log for output). Returns False
		when the launch fails; the registry is left in place either way,
		so the next pi-rc daemon-start still respawns everything."""
		os.makedirs(os.path.dirname(log_path), exist_ok=True)
		try:
			logf = open(log_path, "ab")
		except OSError as exc:
			log("restart: successor log unavailable: %s" % exc)
			return False
		try:
			PROCESS.launch_detached(
				[PROCESS.windowless_python(sys.executable), script], logf)
		except OSError as exc:
			log("restart: successor launch failed: %s" % exc)
			return False
		finally:
			logf.close()
		return True


class IdleShutdownWatch:
	"""Whole-daemon idle shutdown: a periodic sweep that performs the
	normal graceful shutdown (pi-rc daemon-stop semantics) once the
	daemon has been fully quiet for DAEMON_IDLE_TIMEOUT seconds
	continuously. Quiet means every signal at once: no session has a
	bridge viewer, every session's published model state is idle (the
	in-session extension publishes busy/idle per turn via pi-rc state;
	"waiting" - parked on a blocking daemon wait - counts as active
	too), no offload ticket is running, and no handover connection is
	parked waiting for a handing-over pi to exit. PI_DAEMON_IDLE_TIMEOUT
	(env, seconds, default 300, 0 disables) configures it; a successor
	daemon starts its own idle clock at boot, so a restart never
	inherits quiet time."""

	def __init__(self, daemon, shutdown_event):
		self.daemon = daemon
		self.shutdown_event = shutdown_event

	def start(self):
		if DAEMON_IDLE_TIMEOUT <= 0:
			return
		t = threading.Thread(target=self._sweep_loop, daemon=True)
		t.start()

	def quiescent(self):
		"""Whether every idle signal is quiet right now: one owner per
		signal, checked in one place."""
		if self.daemon.tickets.running_count() > 0:
			return False
		with self.daemon.handover_lock:
			if self.daemon.handover_wait:
				return False
		# snapshot() takes the table lock itself.
		sessions = self.daemon.table.snapshot()
		for sess in sessions:
			if sess.count_clients() > 0 or sess.state != "idle":
				return False
		return True

	def _sweep_loop(self):
		idle_since = None
		while not self.shutdown_event.wait(IDLE_SWEEP_TICK):
			if self.quiescent():
				now = time.time()
				if idle_since is None:
					idle_since = now
				elif now - idle_since >= DAEMON_IDLE_TIMEOUT:
					log("idle shutdown: quiet for %gs" % DAEMON_IDLE_TIMEOUT)
					t = threading.Thread(target=self.daemon.shutdown,
						 daemon=True)
					t.start()
					return
			else:
				idle_since = None


class IdleWarnings:
	"""Outstanding idle warnings, one grace window per session.

	Before the daemon reaps a detached model-idle session it leaves a
	timestamped warning file the in-session extension surfaces to its
	agent: deleting the file is a working answer, while leaving it past
	the grace is consent to end the session. This class owns both the
	file and the per-session window record; the daemon only warns,
	inspects, or clears."""

	def __init__(self, directory, grace):
		self.directory = directory
		self.grace = float(grace)
		# session name -> {"sent": time, "written": bool}; the written
		# flag disables deletion-detection when the file could not be
		# written, so that case falls back to silence consent.
		self._outstanding = {}

	def path(self, name):
		# The warning file for one session.
		return os.path.join(self.directory, "%s.json" % name)

	def warn(self, name, now=None):
		# Writes the timestamped warning file and opens the window;
		# returns whether a deletable file exists.
		written = self._write(name, now)
		self._outstanding[name] = {"sent": self._now(now),
								   "written": written}
		return written

	def deleted(self, name):
		# Whether the warned session deleted its file: the working answer.
		record = self._outstanding.get(name)
		return record is not None and record["written"] \
			and not os.path.exists(self.path(name))

	def get(self, name):
		# The open window record, or None.
		return self._outstanding.get(name)

	def expired(self, name, now=None):
		# Whether the window for one session has passed; silence past the
		# grace is consent to end the session.
		record = self._outstanding.get(name)
		if record is None:
			return False
		return self._now(now) - record["sent"] >= self.grace

	def close(self, name):
		# Drops a window once it is answered.
		self._outstanding.pop(name, None)

	def remove(self, name):
		# Drops a window and its file (the session left or was reaped).
		self._outstanding.pop(name, None)
		try:
			os.unlink(self.path(name))
		except OSError:
			pass

	def ids(self):
		# The names with an open window.
		return set(self._outstanding)

	def clear(self):
		# Shutdown leaves no window state behind.
		self._outstanding.clear()

	def _write(self, name, now):
		# A safe single file component or the write fails, leaving the
		# window open with nothing for the agent to delete (silence then
		# ends the session).
		if not name or name in (".", "..") or os.sep in name \
				or (os.altsep and os.altsep in name):
			return False
		try:
			pi_platform.AtomicStateFile(self.path(name)).write(
				{"id": name, "ts": self._now(now), "grace": self.grace})
		except OSError:
			return False
		return True

	@staticmethod
	def _now(now):
		return time.time() if now is None else now


class SessionTable:
	"""Live sessions plus the single lock guarding them."""

	def __init__(self):
		self._sessions = {}
		self.lock = threading.Lock()

	def get(self, name):
		return self._sessions.get(name)

	def put(self, sess, refuse_if_exists=False):
		# Returns False when a refuse_if_exists put lost a race for the
		# name; the existing session is left untouched.
		with self.lock:
			if refuse_if_exists and self._sessions.get(sess.name) is not None:
				return False
			self._sessions[sess.name] = sess
			return True

	def remove_if(self, sess):
		# Drop only when the live entry is this very session (a respawn
		# may have taken the name). Returns the dropped name or None.
		with self.lock:
			if self._sessions.get(sess.name) is sess:
				del self._sessions[sess.name]
				return sess.name
			return None

	def snapshot(self):
		with self.lock:
			return list(self._sessions.values())

	def holders_of(self, file):
		# All live sessions backing this conversation file: the announced
		# file first (the extension recorded it), then a --session argv
		# match, which covers handover/revive spawns and announce-less
		# spawns that resume the same file. Caller holds the table lock.
		hits = []
		for sess in self._sessions.values():
			if sess.file == file:
				hits.append(sess)
		for sess in self._sessions.values():
			if sess in hits:
				continue
			argv = sess.argv or []
			for i, arg in enumerate(argv[:-1]):
				if arg == "--session" and argv[i + 1] == file:
					hits.append(sess)
					break
		return hits


class HandoffLedger:
	# Resume takeover: a duplicate holder of a live conversation announces
	# with takeover, yields to a busy holder or absorbs idle holders, and
	# shuts down; the ledger remembers where a shut-down duplicate's
	# viewers went so pi-rc attach can follow, surviving until the target
	# itself dies.

	def __init__(self):
		self._entries = {}

	def record(self, source, target):
		self._entries[source] = target

	def pop(self, source):
		self._entries.pop(source, None)

	def pending(self, source):
		return source in self._entries

	def follow(self, source, table):
		# The live holder a handed-off duplicate's viewers should follow,
		# or None. A dead intermediate target re-points at its own handoff
		# so a chain of simultaneous duplicates resolves to a live holder
		# instead of ending the follow.
		seen = set()
		while True:
			entry = self._entries.get(source)
			if entry is None or entry in seen:
				return None
			seen.add(entry)
			target = table.get(entry)
			if target is not None:
				return {"name": target.name, "state": target.state}
			# The holder died before the viewers followed; follow its own
			# handoff when it was itself a duplicate, else give up.
			self._entries.pop(source, None)
			source = entry

	def repoint_on_drop(self, dropped):
		# Handoff bookkeeping for a dead session: its own entry (as a
		# duplicate) survives — late viewers still follow it after the
		# duplicate shut down, and it dies with its target instead. But
		# as a TARGET it can no longer take viewers: re-point handoffs
		# through its own handoff when it was itself a duplicate, else
		# clear them.
		next_hop = self._entries.get(dropped)
		for key, val in list(self._entries.items()):
			if val == dropped:
				if next_hop and next_hop != key:
					self._entries[key] = next_hop
				else:
					self._entries.pop(key, None)


class Session:
	"""One hosted pi: its PTY, its bridge viewers, and the relay loop
	that owns the master fd."""

	def __init__(self, name, dir_, argv, pid, master_fd, child=None):
		self.name = name
		self.dir = dir_
		self.argv = list(argv)
		self.pid = pid
		self.master_fd = master_fd
		# The PTY seam owns every OS-specific fd/handle operation. A
		# caller that only exercises the session bookkeeping (unit
		# tests) may omit it; the POSIX child is then a thin adapter
		# over the raw pid/fd it was given.
		self.child = (child if child is not None
					  else pi_platform.PosixPtyChild(pid, master_fd, PROCESS))
		self.clients = {}      # bridge sockets -> per-client output buffer
		self.lock = threading.Lock()
		self.file = None       # announced pi session file, for revival
		self.state = "idle"    # model run state, published by the extension
		self.last_activity = time.time()
		self.stopping = False  # set by an explicit stop: never revive
		# An in-place /reload was typed into this session: an abnormal
		# death right after must not be revived into a fresh spawn (a
		# broken extension update could otherwise respawn every session
		# it crashed). Cleared by the next announce (session_start).
		self.reload_injected = False
		# When the guard was armed (extensions_reload): the survive window
		# for revival suppression. A death inside [armed_at, armed_at +
		# RELOAD_GUARD_GRACE) is the reload's fault and stays dead; after
		# it the session survived the reload and is revivable again.
		self.reload_injected_at = 0.0
		self.spawned_at = time.time()
		self.carry_to = None   # live Session: viewers move there (loop-side)
		self.absorbing_until = 0.0
		self.yielded_to = None

	# -- bridge viewers ----------------------------------------------------

	def count_clients(self):
		with self.lock:
			return len(self.clients)

	def touch_activity(self):
		# Any viewer or model-state activity keeps the session alive.
		self.last_activity = time.time()

	def idle_exceeded(self, now=None):
		# True when the daemon should end this session on its own: a
		# detached session whose model has been idle past the reap
		# grace. Busy or attached sessions are never reapable.
		if IDLE_REAP <= 0:
			return False
		if self.state != "idle" or self.count_clients() > 0:
			return False
		now = time.time() if now is None else now
		return now - self.last_activity > IDLE_REAP

	def install_client(self, client, initial=b""):
		# Control-side: install a new bridge client. Returns the client
		# count after the join.
		with self.lock:
			self.clients[client] = bytearray(initial)
			self.touch_activity()
			return len(self.clients)

	def take_clients(self):
		# Move out every current viewer (carry): stale old-TUI buffers are
		# dropped by the mover; returns [(socket, buffer)] pairs.
		with self.lock:
			moved = list(self.clients.items())
			self.clients = {}
		return moved

	def drop_and_close(self, client):
		# Session-loop side: drop a client after an EOF/error the loop
		# itself observed; the pinned close happens here, never in the
		# control thread. A carry may have moved this socket to another
		# session: skip when the entry is already gone, so a stale loop
		# snapshot never closes a live bridge owned elsewhere.
		with self.lock:
			if self.clients.pop(client, None) is None:
				return
		kill_socket(client)

	def signal_closed(self):
		# Control-side detach: signal every bridge socket without closing;
		# the session loop observes the EOFs and does the pinned closes
		# itself, so no recycled fd can be caught mid-flight.
		self.touch_activity()
		with self.lock:
			clients = list(self.clients)
		for c in clients:
			try:
				c.shutdown(socket.SHUT_RDWR)
			except OSError:
				pass

	def close_bridge(self):
		# Child-side teardown: flush every client's remaining buffer, then
		# drop and close all bridge sockets.
		with self.lock:
			clients = list(self.clients.items())
			self.clients = {}
		for c, buf in clients:
			try:
				while buf:
					sent = c.send(bytes(buf[:65536]))
					del buf[:sent]
			except OSError:
				pass
			kill_socket(c)

	# -- child process / PTY -------------------------------------------------

	def winsize(self):
		rows, cols = self.child.get_winsize()
		if not (rows > 0 and cols > 0):
			rows, cols = DEFAULT_ROWS, DEFAULT_COLS
		return rows, cols

	def resize(self, cols, rows):
		# Apply the size and ask the child to repaint at it. The repaint
		# mechanism belongs to the child: both seams force a real size
		# change (POSIX toggles the PTY size around SIGWINCH, Windows the
		# pseudoconsole size) because pi redraws only on a change. Callers
		# must have installed the client first: the full-frame repaint pi
		# produces is forwarded exclusively to installed clients.
		self.child.set_winsize(cols, rows)
		self.child.signal_winch()

	def kill_and_wait(self, grace):
		self.child.kill_tree(grace)

	def terminate(self, grace=KILL_GRACE):
		# Mark before the first signal lands so the exit path never
		# revives a session the user explicitly stopped.
		self.stopping = True
		self.kill_and_wait(grace)

	# -- projections ---------------------------------------------------------

	def holds_dir(self, dir_):
		try:
			return os.path.realpath(self.dir) == os.path.realpath(dir_)
		except OSError:
			return self.dir == dir_

	def view(self):
		# Projection for the list command; caller holds no locks.
		attached = self.count_clients()
		return {
			"name": self.name,
			"dir": self.dir,
			"pid": self.pid,
			"attached": attached > 0,
			"clients": attached,
			"file": self.file,
			"state": self.state,
			"argv": self.argv,
		}

	# -- relay loop ------------------------------------------------------------

	def relay_loop(self, daemon):
		# Owns the master fd: bridge relay to every attached client plus
		# child reaping. Clients share one view: all of them receive the
		# child's output, and any client's input is forwarded to the child
		# (interleaved, like a shared tmux pane). Per-client output buffers
		# keep one slow viewer from stalling the others or the child; a
		# client that falls too far behind loses its bridge instead.
		master = self.child.output_handle()
		pid = self.pid
		name = self.name
		to_master = bytearray()
		dead_input = False
		status = 0
		while True:
			# A reap-check error must never kill the relay thread (the
			# session's bridge); log it and keep serving the child.
			try:
				daemon.reap_idle_if_due(self)
			except Exception as exc:
				log("reap check '%s' failed: %s" % (name, exc))
			carry_to = self.carry_to
			if carry_to is not None:
				self._transfer_viewers(carry_to)
			reaped, status = self.child.wait_nohang()
			if reaped:
				break
			clients = self._snapshot()
			rlist = []
			wlist = []
			if not dead_input:
				rlist.append(master)
			if to_master:
				wlist.append(master)
			for c, buf in clients.items():
				rlist.append(c)
				if buf:
					wlist.append(c)
			if not rlist and not wlist:
				# Detached after the master hit EOF: nothing left to
				# poll, so just wait for the child like the reap check
				# above.
				time.sleep(REAP_TICK)
				continue
			try:
				r, w, _ = select.select(rlist, wlist, [], REAP_TICK)
			except OSError:
				# A polled fd vanished; the next iteration re-evaluates.
				continue
			to_master = self._relay_client_input(clients, r, to_master)
			dead_input = self._relay_child_output(clients, r, dead_input)
			if master in w:
				written = self.child.write_input(bytes(to_master[:65536]))
				if written:
					del to_master[:written]
				else:
					# The pty refused the chunk (closed or dead). Drop it so
					# the always-writable master cannot spin the loop.
					del to_master[:]
			self._flush_clients(clients, w)
		# Child gone: flush whatever is still buffered per client, drop
		# every bridge, then tear the session down and decide on revival.
		self.close_bridge()
		daemon.drop(self, status)
		daemon.revive(self, status)

	def _snapshot(self):
		# Snapshot {socket: outbuf}; the session loop is the only writer
		# of existing entries, control threads only add new ones.
		with self.lock:
			return dict(self.clients)

	def _relay_client_input(self, clients, ready, to_master):
		for c, _buf in clients.items():
			if c not in ready:
				continue
			try:
				data = c.recv(65536)
			except OSError:
				data = b""
			if data:
				to_master += data
				if len(to_master) > MAX_BUF:
					del to_master[: len(to_master) - MAX_BUF]
			else:
				log("client-exit '%s'" % self.name)
				self.drop_and_close(c)
		return to_master

	def _relay_child_output(self, clients, ready, dead_input):
		if self.child.output_handle() not in ready:
			return dead_input
		data = self.child.read_output(65536)
		if data:
			stalled = []
			with self.lock:
				for c, buf in self.clients.items():
					buf.extend(data)
					if len(buf) > MAX_BUF:
						stalled.append(c)
			for c in stalled:
				self.drop_and_close(c)
				log("drop slow client '%s'" % self.name)
		else:
			dead_input = True
			# The child closed its tty (or died without reaping yet);
			# flush and drop the bridges like a single client did.
			self.close_bridge()
		return dead_input

	def _flush_clients(self, clients, ready):
		for c, buf in clients.items():
			if c not in ready:
				continue
			try:
				sent = c.send(bytes(buf[:65536]))
				del buf[:sent]
			except OSError:
				self.drop_and_close(c)

	def _transfer_viewers(self, carry_to):
		# /new + /resume carry: move every bridge viewer to the target
		# session here, between iterations, so exactly one loop ever
		# recvs on a moved socket. Stale old-TUI buffers are dropped;
		# each viewer gets a clear followed by the target TUI's full
		# repaint (nudged below).
		self.carry_to = None
		moved = self.take_clients()
		for client, _buf in moved:
			with carry_to.lock:
				carry_to.clients[client] = bytearray(CLEAR_SEQ)
		rows, cols = self.winsize()
		carry_to.resize(cols, rows)
		log("carried '%s' -> '%s' (%d viewers)"
			% (self.name, carry_to.name, len(moved)))


class SessionSpawner:
	"""Spawns hosted pi children through the platform PTY backend."""

	def __init__(self, table, registry, owner=None, backend=None):
		self.table = table
		self.registry = registry
		# owner: the Daemon, injected after construction (the relay loop
		# needs its drop/revive).
		self.owner = owner
		# Resolved on first spawn so the control plane starts even when
		# no PTY backend is available for this platform.
		self._backend = backend

	def backend(self):
		if self._backend is None:
			self._backend = pi_platform.select_pty_backend()
		return self._backend

	def spawn(self, name, dir_, argv, cols=DEFAULT_COLS, rows=DEFAULT_ROWS,
			  verb="start", registry_argv=None, refuse_if_exists=False):
		env = os.environ.copy()
		env.update({
			"TERM": "xterm-256color",
			"COLORTERM": "truecolor",
			"COLUMNS": str(cols),
			"LINES": str(rows),
			"PI_HOSTED": "1",
			"PI_HOSTED_SESSION": name,
		})
		child = self.backend().spawn(argv, dir_, env, cols, rows)
		sess = Session(name, dir_, argv, child.pid,
					   getattr(child, "master_fd", -1), child=child)
		if not self.table.put(sess, refuse_if_exists=refuse_if_exists):
			# Lost a race for the name: kill our child so nothing is left
			# behind, and leave the existing session untouched.
			child.kill_tree(KILL_GRACE)
			child.close()
			log("%s '%s' skipped: name taken during spawn" % (verb, name))
			return None
		self.registry.add(name, dir_,
						  list(registry_argv) if registry_argv else list(argv))
		log("%s '%s' pid %d in %s" % (verb, name, child.pid, dir_))
		t = threading.Thread(target=sess.relay_loop, args=(self.owner,),
							 daemon=True)
		t.start()
		return sess


class Daemon:
	"""The PTY host: session table, takeover policy, control socket."""

	def __init__(self, registry, sock_path=SOCK_PATH):
		self.registry = registry
		self.sock_path = sock_path
		self.endpoint = pi_platform.EndpointFile(sock_path)
		self.token = os.urandom(16).hex()
		self.handshake = pi_platform.ControlHandshake(self.token)
		self.server = pi_platform.ControlServer(self.endpoint)
		self.handover_lock = threading.Lock()
		self.handover_wait = {}
		self.table = SessionTable()
		self.ledger = HandoffLedger()
		self.idle_warnings = IdleWarnings(IDLE_WARNING_DIR, IDLE_WARN_GRACE)
		self.shutdown_event = threading.Event()
		self.spawner = SessionSpawner(self.table, registry, owner=self)
		self.tickets = TicketRunner(
			TicketStore(TICKETS_PATH, TICKET_LOG_DIR), self.shutdown_event)
		self.roster = DaemonRoster(ROSTER_PATH)
		self.restart_planner = RestartPlanner(self.registry, self.table)
		self.idle_watch = IdleShutdownWatch(self, self.shutdown_event)
		self.control = Control(self)
		# Signals a previous daemon run left behind never fire a fresh
		# session's watcher or steer its agent; drop them before anything
		# is hosted.
		_clear_stale_reload_signals()
		_clear_stale_idle_warnings()

	# -- control socket ------------------------------------------------------

	def serve(self):
		if hasattr(os, "getuid") and os.getuid() == 0:
			log("refusing to run as root")
			return 1
		signal.signal(signal.SIGTERM, _on_signal)
		signal.signal(signal.SIGINT, _on_signal)
		# Converge to a single daemon before publishing anything: the
		# older daemon's exit cleanup unlinks the shared endpoint file,
		# so a peer that dies after this bind would strand the freshly
		# published coordinates (clients see no daemon at all).
		started = time.time()
		self.roster.shutdown_others(os.getpid(), started)
		try:
			self.server.bind(self.token)
		except OSError as exc:
			log("cannot bind control endpoint %s: %s"
				% (self.sock_path, exc))
			return 1
		log("listening on %s:%d (endpoint %s, registry %s)"
			% (self.server.host, self.server.port, self.sock_path,
			   self.registry.path))
		self.roster.register(os.getpid(), self.server.host,
							 self.server.port, self.token)
		self.respawn_from_registry()
		self.tickets.start()
		self.idle_watch.start()
		try:
			self._accept_loop(self.server)
		except SystemExit:
			pass
		finally:
			self.server.close()
		if not self.shutdown_event.is_set():
			self.shutdown()
		return 0

	def _accept_loop(self, srv):
		while not self.shutdown_event.is_set():
			try:
				conn, _ = srv.accept()
			except OSError as exc:
				if self.shutdown_event.is_set():
					break
				log("accept error: %s" % exc)
				time.sleep(0.1)
				continue
			t = threading.Thread(target=self._conn_thread, args=(conn,),
								 daemon=True)
			t.start()

	def _conn_thread(self, conn):
		handed_off = False
		try:
			conn.settimeout(10)
			reader = LineReader(conn)
			if not self._handshake(conn, reader):
				return
			while not self.shutdown_event.is_set():
				try:
					line = reader.readline()
				except (ValueError, OSError):
					break
				if line is None:
					break
				if not line.strip():
					continue
				try:
					req = json.loads(line.decode())
				except (ValueError, UnicodeDecodeError):
					send_json(conn, bad_request())
					continue
				resp = self._dispatch(conn, req)
				if resp is _BRIDGE_HANDOFF:
					handed_off = True
					return
				if resp is not None:
					send_json(conn, resp)
		except Exception as exc:
			if not handed_off:
				log("control connection error: %r" % (exc,))
		finally:
			if not handed_off:
				self.connection_closed(conn)
				try:
					conn.close()
				except OSError:
					pass

	def _dispatch(self, conn, req):
		cmd = req.get("cmd")
		if not isinstance(cmd, str):
			return bad_request()
		if cmd == "attach":
			# attach may have already delivered the response itself before
			# installing the client bridge; its second return value says
			# the connection is now the bridge and must not be read or
			# written again.
			resp, became_bridge = self.control.attach(req, conn)
			if resp is not None:
				send_json(conn, resp)
			if became_bridge:
				return _BRIDGE_HANDOFF
			return None
		if cmd == "shutdown":
			return self.control.shutdown(req)
		if cmd == "handover":
			# handover needs the connection itself: with hold, the
			# daemon hosts the session when this connection reaches EOF
			# (the handing-over process exited), never by pid probing.
			return self.control.handover(req, conn)
		if cmd in _WIRE_COMMANDS:
			# wire names use dashes; methods use underscores
			return getattr(self.control, cmd.replace("-", "_"))(req)
		return bad_request()

	def shutdown(self):
		if self.shutdown_event.is_set():
			return
		self.shutdown_event.set()
		log("shutdown")
		self.tickets.stop()
		self._terminate_sessions(self.table.snapshot())
		self.roster.remove(os.getpid())
		self.registry.write({})
		self.endpoint.remove_if(self.server.host, self.server.port,
								self.token)
		os._exit(0)

	def _terminate_sessions(self, sessions):
		# Shared teardown for shutdown and restart: TERM every child, a
		# bounded reap wait, KILL the survivors, close every PTY. Nothing
		# is left behind: each child's process tree goes with it.
		for sess in sessions:
			PROCESS.signal_term(sess.pid)
		deadline = time.time() + KILL_GRACE
		while time.time() < deadline:
			alive = False
			for sess in sessions:
				reaped, _ = sess.child.wait_nohang()
				if not reaped:
					alive = True
			if not alive:
				break
			time.sleep(0.1)
		for sess in sessions:
			PROCESS.signal_kill(sess.pid)
		for sess in sessions:
			sess.signal_closed()
			sess.child.close()

	def restart(self):
		"""Hand the daemon over to a fresh successor of the installed
		build: dedupe the registry, kill every hosted child, spawn the
		detached successor and exit. Unlike shutdown() the registry and
		endpoint file are left in place - the graceful shutdown path
		intentionally drops detached idle sessions, but a restart must
		respawn ALL hosted sessions - and the successor publishes its own
		endpoint over the old one. The successor launch happens after
		this daemon's children are dead, so no conversation is ever
		hosted twice; if the launch fails the registry still stands and
		the next pi-rc daemon-start respawns everything."""
		if self.shutdown_event.is_set():
			return
		keep, dropped = self.restart_planner.dedupe_registry()
		if dropped:
			log("restart: dropped duplicate registry entries: %s"
				% ", ".join(sorted(dropped)))
		self.shutdown_event.set()
		log("restart (registry holds %d session(s))" % len(keep))
		self.tickets.stop()
		self._terminate_sessions(self.table.snapshot())
		self.roster.remove(os.getpid())
		self.restart_planner.spawn_successor(os.path.abspath(__file__),
											 LOG_PATH)
		os._exit(0)

	# -- session lifecycle -----------------------------------------------------

	def spawn(self, name, dir_, argv, cols=DEFAULT_COLS, rows=DEFAULT_ROWS,
			  verb="start", registry_argv=None, refuse_if_exists=False):
		return self.spawner.spawn(name, dir_, argv, cols, rows, verb,
								  registry_argv, refuse_if_exists)

	def _handshake(self, conn, reader):
		# Mandatory first line: the random-token hello that authenticates
		# the loopback connection before any wire command is served.
		try:
			line = reader.readline()
		except (ValueError, OSError):
			return False
		if line is None:
			return False
		try:
			msg = json.loads(line.decode())
		except (ValueError, UnicodeDecodeError):
			send_json(conn, self.handshake.reject())
			return False
		if not self.handshake.validate(msg):
			send_json(conn, self.handshake.reject())
			return False
		send_json(conn, self.handshake.ack())
		return True

	def drop(self, sess, code):
		sess.carry_to = None
		sess.signal_closed()
		sess.child.close()
		dropped = self.table.remove_if(sess)
		if dropped is not None:
			self.ledger.repoint_on_drop(dropped)
		self.registry.drop(sess.name)
		# A dropped session can no longer answer its idle warning: drop
		# the window and remove the file so no stale ask survives it.
		self.idle_warnings.remove(sess.name)
		self._discard_session_file(sess)
		log("child-exit '%s' pid %d status %s" % (sess.name, sess.pid, code))

	def _discard_session_file(self, sess):
		# A session the daemon ended itself (an explicit `stop`, or the
		# idle-reap of a stale detached phantom) is a discard: drop its
		# conversation file too so it stops surfacing in pi's /resume
		# picker. Never on a clean user quit (stopping is False - that
		# stays resumable), and never when another live session still
		# hosts the same conversation (takeover/absorption of a duplicate
		# passes the file to its survivor, so it must not be unlinked).
		if not (sess.stopping and sess.file):
			return
		with self.table.lock:
			remaining = self.table.holders_of(sess.file)
		if remaining:
			return
		try:
			if os.path.isfile(sess.file):
				os.unlink(sess.file)
				log("discard '%s' conversation %s" % (sess.name, sess.file))
		except OSError as exc:
			log("discard '%s' conversation failed: %s" % (sess.name, exc))

	def reap_idle_if_due(self, sess):
		# End a hosted session the daemon should not keep: detached and
		# model-idle past the grace. An explicit stop path (never
		# revived) removes it from the table and registry; a session
		# with a viewer or a running model is never touched.
		if not sess.idle_exceeded():
			return
		if self.idle_warnings.grace <= 0:
			log("reap '%s' ended: detached and idle past %ss"
				% (sess.name, IDLE_REAP))
			self.idle_warnings.remove(sess.name)
			sess.terminate()
			return
		# A warning is outstanding. Deleting the file is the working
		# answer: close the window and re-arm the idle clock. A file
		# still present past the grace is silence, which is consent.
		if self.idle_warnings.deleted(sess.name):
			self.idle_warnings.close(sess.name)
			sess.touch_activity()
			log("idle-warning '%s': deleted; session spared" % sess.name)
			return
		if self.idle_warnings.get(sess.name) is not None:
			record = self.idle_warnings.get(sess.name)
			if sess.last_activity > record["sent"]:
				# Real work happened after the warning: it is stale, so drop
				# it and warn fresh on the next due reap rather than letting
				# the old ask turn into a silent termination.
				self.idle_warnings.remove(sess.name)
				return
			if not self.idle_warnings.expired(sess.name):
				return
			log("reap '%s' ended: detached and idle past %ss (idle "
				"warning unanswered)" % (sess.name, IDLE_REAP))
			self.idle_warnings.remove(sess.name)
			sess.terminate()
			return
		# First due reap: leave the warning the agent deletes to stay
		# alive and open its window; deletion is detected by later sweeps.
		written = self.idle_warnings.warn(sess.name)
		log("idle-warning '%s': detached and idle past %ss; warning %s"
			% (sess.name, IDLE_REAP,
			   "left at %s" % self.idle_warnings.path(sess.name) if written
			   else "could not be written"))

	def revive(self, sess, status):
		# Backgrounding must always happen unless the user ended the
		# session themselves: re-host an abnormally dying pi from its
		# announced session file under the same name. Deliberate quits,
		# explicit stops, daemon shutdown, deleted files, and
		# crash-loop-short lifetimes stay dead.
		if self.shutdown_event.is_set() or sess.stopping:
			return
		if sess.reload_injected:
			# The session was given an in-place /reload: an abnormal death
			# inside the survive grace is the reload's fault (a broken
			# extension update, for example) and must not be revived into
			# a fresh spawn. Leave it dead; reattach recreates it from its
			# saved conversation, and once the grace has elapsed the
			# session is treated as having survived the reload so normal
			# crash revival resumes. Cleared by the next announce that
			# names a different conversation file.
			if time.time() - sess.reload_injected_at < RELOAD_GUARD_GRACE:
				log("revive '%s' skipped: died after a reload injection"
					% sess.name)
				return
		if not sess.child.exit_abnormal(status):
			return
		if time.time() - sess.spawned_at < MIN_REVIVE_LIFE:
			log("revive '%s' skipped: lived under %ss"
				% (sess.name, MIN_REVIVE_LIFE))
			return
		file = sess.file
		if not file or not os.path.isfile(file):
			log("revive '%s' skipped: no session file" % sess.name)
			return
		if self.table.get(sess.name) is not None:
			return
		try:
			spawned = self.spawn(sess.name, sess.dir,
								 PROCESS.pi_argv(["--session", file]),
								 verb="revive", refuse_if_exists=True)
		except OSError as exc:
			log("revive '%s' failed: %s" % (sess.name, exc))
			return
		if spawned is None:
			log("revive '%s' skipped: name taken during revive" % sess.name)

	def respawn_from_registry(self):
		# One entry per conversation file: a registry inherited from an
		# earlier era can hold duplicates, and respawning both would run
		# diverging copies of one conversation. No table exists yet, so
		# the lexicographically first name per file survives.
		keep, dropped = self.registry.dedupe(argv_session_file)
		if dropped:
			log("respawn: dropped duplicate registry entries: %s"
				% ", ".join(sorted(dropped)))
		data = self.registry.load()
		for name, rec in sorted(data.items()):
			try:
				dir_ = rec["dir"]
				argv = rec["argv"]
				if not (isinstance(dir_, str) and isinstance(argv, list)
						and argv):
					raise ValueError("bad record")
				self.spawn(name, dir_, argv, verb="respawn")
			except Exception as exc:
				log("respawn '%s' failed: %s" % (name, exc))
				self.registry.drop(name)

	# -- takeover + carry policy -----------------------------------------------

	def carry_target_name(self, base, exclude):
		# Unique carry/relay target name: "<base>-<hash>", collision-
		# checked against live sessions (a refuse_if_exists backstop
		# covers races).
		for attempt in range(8):
			suffix = hashlib.sha256(
				("%d-%d-%d" % (time.time_ns(), os.getpid(), attempt)).encode()
			).hexdigest()[:4]
			candidate = "pi-%s-%s" % (base, suffix)
			if candidate != exclude and self.table.get(candidate) is None:
				return candidate
		return None

	def begin_carry(self, sess, target, verb):
		# Record the viewer handoff on the source session loop (it
		# performs the move at its next iteration boundary): two loops
		# recv()ing on one socket would split the viewer's input between
		# the two TUIs. Returns False when the source died before the
		# handoff could be recorded.
		with self.table.lock:
			if self.table.get(sess.name) is not sess:
				return False
			sess.carry_to = target
		log("%s '%s' -> '%s'" % (verb, sess.name, target.name))
		return True

	def handover_target(self, dir_, file):
		# Mirrors pi-rc's session_for/handover_name target logic.
		base = os.path.basename(dir_)
		base = base.replace(":", "_")
		if base.startswith("="):
			base = base[1:]
		primary = "pi-" + base
		holder = self.table.get(primary)
		if holder is None or holder.holds_dir(dir_):
			return primary
		digest = hashlib.sha256(file.encode()).hexdigest()[:6]
		return "pi-%s-%s" % (base, digest)

	def register_handover(self, conn, target, dir_, file, message):
		# A handover request parks on its control connection: the client
		# holds the connection until the handing-over pi exits, so EOF is
		# the exit signal (connection-EOF liveness). Never a pid probe.
		# Clear the read timeout: a held handover socket must stay idle
		# until the handing-over process really exits, not be torn down
		# by the 10s control-connection timeout.
		conn.settimeout(None)
		with self.handover_lock:
			self.handover_wait[conn] = (target, dir_, file, message)

	def connection_closed(self, conn):
		with self.handover_lock:
			pending = self.handover_wait.pop(conn, None)
		if pending is None:
			return
		target, dir_, file, message = pending
		threading.Thread(target=self.host_handover,
						 args=(target, dir_, file, message),
						 daemon=True).start()

	def host_handover(self, target, dir_, file, message=None):
		# The held control connection reached EOF, so the handing-over pi
		# has exited; a short settle lets its session file finish flushing
		# before the daemon resumes it under `pi --session <file>`.
		time.sleep(0.3)
		if self.shutdown_event.is_set():
			return
		if not os.path.isfile(file):
			log("handover '%s' skipped: session file gone: %s" % (target, file))
			return
		if self.table.get(target) is not None:
			log("handover '%s' skipped: name already hosted" % target)
			return
		args = ["--session", file]
		registry_argv = PROCESS.pi_argv(args)
		if message:
			# Legacy hook kept for protocol compatibility; the
			# daemon extension no longer sends a continuation
			# prompt, so hosted handovers start idle at the prompt.
			args = args + [message]
		argv = PROCESS.pi_argv(args)
		try:
			spawned = self.spawn(target, dir_, argv, verb="handover",
								 registry_argv=registry_argv,
								 refuse_if_exists=True)
		except OSError as exc:
			log("handover '%s' failed: %s" % (target, exc))
			return
		if spawned is None:
			log("handover '%s' skipped: name taken during handover" % target)

	def resolve_takeover(self, sess, others):
		# A second live pi on one conversation can only diverge. The
		# announcing session is the one the user is actively looking at,
		# so it never shuts down while every holder is merely idle at the
		# prompt: it absorbs them instead, and each of their viewers
		# follows here. Only a non-idle holder wins — never touch a working
		# agent; the announcer yields to it and shuts down. Holders
		# already handing off are neither followed nor absorbed. Returns
		# (handoff, took_over names).
		busy = [s for s in others
				if (s.state != "idle" or s.absorbing_until > time.time())
				and not self.ledger.pending(s.name)]
		if busy:
			busy.sort(key=lambda s: s.count_clients() == 0)
			target = busy[0]
			self.ledger.record(sess.name, target.name)
			sess.signal_closed()
			log("handoff '%s' -> '%s'" % (sess.name, target.name))
			return {"name": target.name, "state": target.state}, []
		# A concurrent announce must yield to an in-flight absorption
		# instead of absorbing the absorber.
		sess.absorbing_until = time.time() + ABSORB_GUARD
		took_over = []
		for holder in others:
			if self.ledger.pending(holder.name):
				continue
			# Record before the first signal so the holder's viewers
			# follow here, a concurrent announce sees it as already
			# absorbed, and an abnormal death in the settle window never
			# revives it.
			self.ledger.record(holder.name, sess.name)
			holder.stopping = True
			took_over.append(holder.name)
			threading.Thread(target=self.absorb_session,
							 args=(holder, sess.name), daemon=True).start()
			log("took-over '%s' <- '%s'" % (holder.name, sess.name))
		return None, took_over

	def absorb_session(self, holder, announcer):
		# Kill an absorbed idle holder — but only after a short settle
		# that rechecks the best-effort run state: a holder whose turn
		# just started (state publish still in flight) must not be killed
		# mid-turn.
		time.sleep(ABSORB_SETTLE)
		kill = False
		with self.table.lock:
			if holder.state == "idle":
				# terminate() blocks for the kill grace, so it must run
				# outside the table lock: held under it, every control
				# request (start/attach/list) stalls behind a dying
				# session. The kill decision was made under the lock; a
				# state flip after it is the same best-effort race the
				# settle window already accepts.
				kill = True
			else:
				# The holder started working during the settle: it wins
				# instead. Never kill a working agent — and never kill the
				# announcer while it is working either; if both sides started
				# within the window, sparing both leaves a divergence, but
				# aborting a working agent is worse. One yield wins; later
				# busy holders are only spared.
				holder.stopping = False
				self.ledger.pop(holder.name)
				sess = self.table.get(announcer)
				if sess is None:
					return
				sess.absorbing_until = 0
				if sess.yielded_to is not None:
					log("absorb spare '%s': announcer '%s' already yielded"
						% (holder.name, announcer))
					return
				if sess.state != "idle":
					log("absorb aborted '%s' vs working '%s': both working, left alone"
						% (announcer, holder.name))
					return
				sess.yielded_to = holder.name
				self.ledger.record(announcer, holder.name)
				sess.signal_closed()
				log("absorb yield '%s' -> working '%s'" % (announcer, holder.name))
				threading.Thread(target=sess.terminate, daemon=True).start()
		if kill:
			holder.terminate()


class Control:
	"""One method per wire command; every handler returns the response
	dict, except attach which may hand the connection to the bridge."""

	def __init__(self, daemon):
		self.daemon = daemon

	def ping(self, _req):
		return {"ok": True}

	def start(self, req):
		name = req.get("name")
		dir_ = req.get("dir")
		argv = req.get("argv")
		try:
			cols = int(req.get("cols", DEFAULT_COLS))
			rows = int(req.get("rows", DEFAULT_ROWS))
		except (TypeError, ValueError):
			return bad_request()
		if not (isinstance(name, str) and name and isinstance(dir_, str)
				and isinstance(argv, list) and argv
				and all(isinstance(a, str) for a in argv)):
			return bad_request()
		if not os.path.isdir(dir_):
			return err("no-dir")
		if self.daemon.table.get(name) is not None:
			return {"ok": True, "name": name, "created": False}
		try:
			self.daemon.spawn(name, dir_, argv, cols, rows)
		except OSError as exc:
			log("start '%s' failed: %s" % (name, exc))
			return err("spawn-failed")
		return {"ok": True, "name": name, "created": True}

	def attach(self, req, conn):
		name = req.get("name")
		try:
			cols = int(req.get("cols", DEFAULT_COLS))
			rows = int(req.get("rows", DEFAULT_ROWS))
		except (TypeError, ValueError):
			return bad_request(), False
		if not (isinstance(name, str) and name):
			return bad_request(), False
		table = self.daemon.table
		with table.lock:
			sess = table.get(name)
			follow = self.daemon.ledger.follow(name, table)
		if sess is None:
			if follow is None:
				return err("no-session"), False
			# The duplicate already shut down, but its handoff survives: a
			# late viewer follows it instead of recreating the duplicate.
			send_json(conn, {"ok": True, "name": name, "state": follow["state"],
							 "clients": 0, "handoff": follow})
			log("attach '%s' -> handoff '%s' (session gone)"
				% (name, follow["name"]))
			return None, False
		if follow is not None:
			# This duplicate already handed its viewers to a live holder
			# (resume takeover): reply with the handoff instead of
			# installing a bridge that would die the moment the duplicate
			# shuts down.
			send_json(conn, {"ok": True, "name": name,
							 "state": sess.state,
							 "clients": sess.count_clients(),
							 "handoff": follow})
			log("attach '%s' -> handoff '%s'" % (name, follow["name"]))
			return None, False
		# The attach response must reach the client BEFORE the connection
		# becomes a live bridge: install_client() starts relaying pi's
		# output on this socket immediately, and response bytes
		# interleaved with stream output made pi-rc read a non-JSON line
		# ("attach failed: no response"). Send the response first; the
		# client then enters bridge mode, and only after that do we
		# install the client and force the repaint.
		nclients = sess.count_clients() + 1
		send_json(conn, {"ok": True, "name": name, "state": sess.state,
						 "clients": nclients})
		conn.setblocking(False)
		sess.install_client(conn)
		if nclients > 1:
			# Multiple terminals share this session: every viewer sees the
			# same output and any of them can type into the child.
			log("attach '%s' %dx%d (%d clients)" % (name, cols, rows, nclients))
		else:
			log("attach '%s' %dx%d" % (name, cols, rows))
		sess.resize(cols, rows)
		# Response already sent above; tell conn_thread the connection is
		# now the bridge and must not be read or written again.
		return None, True

	def detach(self, req):
		name = req.get("name")
		if not isinstance(name, str):
			return bad_request()
		sess = self.daemon.table.get(name)
		if sess is None:
			# A detach of an unknown session must not report ok: callers
			# use the response to decide whether the user's terminal was
			# handed back, and a silent ok hid a name-mangling bug for a
			# day.
			return err("no-session")
		if sess.count_clients() > 0:
			log("detach '%s'" % name)
			sess.signal_closed()
		return {"ok": True}

	def resize(self, req):
		name = req.get("name")
		try:
			cols = int(req.get("cols"))
			rows = int(req.get("rows"))
		except (TypeError, ValueError):
			return bad_request()
		if not isinstance(name, str):
			return bad_request()
		sess = self.daemon.table.get(name)
		if sess is None:
			return err("no-session")
		try:
			sess.resize(cols, rows)
		except OSError:
			pass
		return {"ok": True}

	def list(self, _req):
		sessions = [s.view() for s in self.daemon.table.snapshot()]
		return {"ok": True, "sessions": sessions}

	def which(self, req):
		file = req.get("file")
		if not (isinstance(file, str) and file):
			return bad_request()
		with self.daemon.table.lock:
			holders = self.daemon.table.holders_of(file)
		# First match, preserving the historical exact-pass-wins-then-argv
		# order; pi-rc whichall exposes every holder.
		return {"ok": True, "name": holders[0].name if holders else None}

	def whichall(self, req):
		file = req.get("file")
		if not (isinstance(file, str) and file):
			return bad_request()
		with self.daemon.table.lock:
			holders = self.daemon.table.holders_of(file)
		return {"ok": True,
				"names": [{"name": s.name, "state": s.state}
						  for s in holders]}

	def state(self, req):
		name = req.get("name")
		state = req.get("state")
		if not (isinstance(name, str) and name) or state not in ("busy", "idle", "waiting"):
			return bad_request()
		sess = self.daemon.table.get(name)
		if sess is None:
			return err("no-session")
		sess.state = state
		sess.touch_activity()
		return {"ok": True}

	def stop(self, req):
		name = req.get("name")
		if not isinstance(name, str):
			return bad_request()
		sess = self.daemon.table.get(name)
		if sess is not None:
			t = threading.Thread(target=sess.terminate, daemon=True)
			t.start()
		# The session thread drops the entry once the reap lands.
		return {"ok": True}

	def handover(self, req, conn=None):
		file = req.get("file")
		dir_ = req.get("dir")
		after_pid = req.get("afterPid")
		hold = bool(req.get("hold"))
		message = req.get("message")  # legacy; unused by the current client
		if not (isinstance(file, str) and file and isinstance(dir_, str) and dir_):
			return bad_request()
		if after_pid is not None and not isinstance(after_pid, int):
			return bad_request()
		if message is not None and not (isinstance(message, str)
									   and 0 < len(message) <= 8192):
			return bad_request()
		if not os.path.isdir(dir_):
			return err("no-dir")
		target = self.daemon.handover_target(dir_, file)
		holder = self.daemon.table.get(target)
		if holder is not None and not holder.holds_dir(dir_):
			# Held by a session resuming this exact file already.
			log("handover '%s' already hosted" % target)
			return {"ok": True, "verdict": "hosted:%s" % target}
		if conn is not None and (hold or after_pid is not None):
			# The client holds this connection until it exits; the daemon
			# hosts the session when the connection closes.
			self.daemon.register_handover(conn, target, dir_, file, message)
			return {"ok": True, "verdict": "target:%s" % target}
		# No held connection: host now (or once this request's own
		# connection closes, for a client that does not wait).
		threading.Thread(
			target=self.daemon.host_handover,
			args=(target, dir_, file, message),
			daemon=True).start()
		return {"ok": True, "verdict": "target:%s" % target}

	def carry(self, req):
		# /new without termination: spawn a fresh hosted session and move
		# this session's bridge viewers onto it, leaving this pi running
		# headless with its own conversation (the extension cancels pi's
		# in-process switch, which would abort an in-flight turn). With
		# "to", an existing session receives the viewers instead.
		name = req.get("name")
		if not isinstance(name, str) or not name:
			return bad_request()
		argv = req.get("argv")
		if argv is not None and not (isinstance(argv, list) and argv
									and all(isinstance(a, str) for a in argv)):
			return bad_request()
		to_name = req.get("to")
		if to_name is not None and not isinstance(to_name, str):
			return bad_request()
		table = self.daemon.table
		with table.lock:
			sess = table.get(name)
			if sess is None:
				return err("no-session")
			dir_ = sess.dir
			rows, cols = sess.winsize()
			target = None
			new_name = None
			if to_name is not None:
				if to_name == name:
					return err("no-session")
				target = table.get(to_name)
				if target is None:
					return err("no-session")
			else:
				new_name = self.daemon.carry_target_name(_dir_base(dir_),
														 name)
				if new_name is None:
					return err("no-free-name")
		spawned = None
		if target is None:
			try:
				# A bare `pi` is a shell shim Windows cannot exec
				# directly; route a default or `pi ...` argv through the
				# shell seam so the name resolves on every platform.
				spawn_argv = argv or PROCESS.pi_argv()
				if argv and argv[0] == "pi":
					spawn_argv = PROCESS.pi_argv(argv[1:])
				spawned = self.daemon.spawn(new_name, dir_, spawn_argv,
											cols, rows, verb="carry",
											refuse_if_exists=True)
			except OSError as exc:
				log("carry '%s' failed: %s" % (name, exc))
				return err("spawn-failed")
			if spawned is None:
				return err("name-taken")
			target = spawned
		if self.daemon.begin_carry(sess, target, "carry"):
			return {"ok": True, "name": target.name}
		# The source died between spawn and move: drop a freshly spawned
		# session rather than leave an unviewed pi behind.
		if spawned is not None:
			threading.Thread(target=spawned.terminate, daemon=True).start()
		return err("no-session")

	def resume(self, req):
		# /resume without termination: resolve the picked conversation to
		# its live holder when one exists (a busy one first — never touch
		# a working agent, just move this terminal's viewers there),
		# otherwise spawn a fresh session resuming the file, then move the
		# viewers. The source session keeps running headless with its own
		# conversation; the extension cancels pi's in-process switch.
		name = req.get("name")
		file = req.get("file")
		if not (isinstance(name, str) and name and isinstance(file, str)
				and file and os.path.isabs(file)):
			return bad_request()
		if not os.path.isfile(file):
			return err("no-file")
		table = self.daemon.table
		with table.lock:
			sess = table.get(name)
			if sess is None:
				return err("no-session")
			rows, cols = sess.winsize()
			holders = [s for s in table.holders_of(file)
					   if s is not sess
					   and not self.daemon.ledger.pending(s.name)]
			target = None
			new_name = None
			if holders:
				holders.sort(key=lambda s: (s.state == "idle",
											s.count_clients() == 0))
				target = holders[0]
			else:
				base = _dir_base(sess.dir)
				digest = hashlib.sha256(file.encode()).hexdigest()[:6]
				new_name = self.daemon.carry_target_name(
					"%s-%s" % (base, digest), name)
				if new_name is None:
					return err("no-free-name")
		spawned = None
		if target is None:
			try:
				spawned = self.daemon.spawn(
					new_name, sess.dir,
					PROCESS.pi_argv(["--session", file]),
					cols, rows, verb="resume", refuse_if_exists=True)
			except OSError as exc:
				log("resume '%s' failed: %s" % (name, exc))
				return err("spawn-failed")
			if spawned is None:
				return err("name-taken")
			target = spawned
		if self.daemon.begin_carry(sess, target, "resume"):
			return {"ok": True, "name": target.name}
		# The source died between spawn and move: drop a freshly spawned
		# session rather than leave an unviewed pi behind.
		if spawned is not None:
			threading.Thread(target=spawned.terminate, daemon=True).start()
		return err("no-session")

	def announce(self, req):
		name = req.get("name")
		file = req.get("file")
		if not (isinstance(name, str) and name and isinstance(file, str)
				and file and os.path.isabs(file)):
			return bad_request()
		table = self.daemon.table
		with table.lock:
			sess = table.get(name)
			if sess is None:
				return err("no-session")
			# Clear the reload guard only when this announce names a
			# genuinely different conversation file: pi reloads the
			# extension module during an in-place /reload and re-fires
			# session_start, which re-announces the SAME file mid-reload.
			# Clearing there would wipe the no-spawn guard while the
			# reload is still being applied, so a broken update that
			# crashes the session would be revived into a fresh spawn.
			# A changed file is a fresh boot / new conversation, where the
			# old reload guard is moot.
			if file != sess.file:
				sess.reload_injected = False
				sess.reload_injected_at = 0.0
			sess.file = file
			# Surface other live holders of the same conversation so the
			# extension can warn about a picker-opened duplicate
			# immediately.
			others = [s for s in table.holders_of(file) if s is not sess]
			also = [{"name": s.name, "state": s.state}
					for s in others
					if not (req.get("takeover")
							and self.daemon.ledger.pending(s.name))]
			handoff = None
			took_over = []
			if req.get("takeover") and others:
				handoff, took_over = self.daemon.resolve_takeover(
					sess, others)
		self.daemon.registry.set_argv(name,
							  PROCESS.pi_argv(["--session", file]))
		log("announce '%s' -> %s" % (name, file))
		return {"ok": True, "alsoLive": also, "handoff": handoff,
				"tookOver": took_over}

	def handoff_target(self, req):
		name = req.get("name")
		if not (isinstance(name, str) and name):
			return bad_request()
		with self.daemon.table.lock:
			target = self.daemon.ledger.follow(name, self.daemon.table)
		return {"ok": True, "target": target}

	# -- command offloading (tickets) -------------------------------------

	def ticket_submit(self, req):
		session = req.get("session")
		dir_ = req.get("cwd")
		command = req.get("command")
		env = req.get("env")
		if not (isinstance(session, str) and session
				and isinstance(dir_, str) and os.path.isabs(dir_)
				and os.path.isdir(dir_)
				and isinstance(command, str) and command):
			return bad_request()
		if env is not None and not (isinstance(env, dict)
									and all(isinstance(k, str) and isinstance(v, str)
										for k, v in env.items())):
			return bad_request()
		# Replay guard: a re-emitted identical command (compaction
		# continuation, crash-resume replay) joins the running ticket
		# instead of spawning a duplicate execution.
		existing = self.daemon.tickets.find_running(session, dir_, command)
		if existing is not None:
			return {"ok": True, "id": existing["id"],
					"ticket": existing, "reused": True}
		if self.daemon.tickets.running_count() >= TICKET_MAX_RUNNING:
			return err("too-busy")
		try:
			rec = self.daemon.tickets.submit(session, dir_, command, env)
		except OSError as exc:
			log("ticket-submit failed: %s" % exc)
			return err("spawn-failed")
		if rec is None:
			return err("too-busy")
		return {"ok": True, "id": rec["id"], "ticket": rec}

	def ticket_wait(self, req):
		tid = req.get("id")
		try:
			timeout = float(req.get("timeout", 0))
		except (TypeError, ValueError):
			return bad_request()
		if not (isinstance(tid, str) and tid) or timeout < 0:
			return bad_request()
		rec = self.daemon.tickets.store.get(tid)
		if rec is None:
			return err("no-ticket")
		res = self.daemon.tickets.wait(tid, timeout)
		if res is None:
			return err("no-ticket")
		return {"ok": True, "ticket": res}

	def ticket_output(self, req):
		tid = req.get("id")
		if not (isinstance(tid, str) and tid):
			return bad_request()
		offset = req.get("offset")
		if offset is not None:
			try:
				offset = int(offset)
			except (TypeError, ValueError):
				return bad_request()
			if offset < 0:
				return bad_request()
			out = self.daemon.tickets.output(tid, offset)
			if out is None:
				return err("no-ticket")
			return {"ok": True, "offset": out["offset"], "next": out["next"],
					"size": out["size"],
					"data": base64.b64encode(out["data"]).decode()}

		rec = self.daemon.tickets.store.get(tid)
		if rec is None:
			return err("no-ticket")
		output_text = rec.get("final_message") or rec.get("output")
		usage = rec.get("usage")
		log_path = self.daemon.tickets.store.artifact_path(tid, "log")
		if not output_text and os.path.isfile(log_path):
			try:
				with open(log_path, "r", encoding="utf-8", errors="replace") as f:
					output_text = f.read()
			except OSError:
				output_text = ""
		return {"ok": True, "id": tid, "status": rec.get("status"),
				"exit": rec.get("exit"), "output": output_text or "",
				"usage": usage}

	def ticket_list(self, req):
		session = req.get("session")
		if session is not None and not isinstance(session, str):
			return bad_request()
		kind = req.get("kind")
		if kind is not None and kind != "shell":
			return bad_request()
		return {"ok": True,
				"tickets": self.daemon.tickets.store.snapshot(session, kind)}

	def ticket_cancel(self, req):
		tid = req.get("id")
		if not (isinstance(tid, str) and tid):
			return bad_request()
		rec = self.daemon.tickets.store.get(tid)
		if rec is None:
			return err("no-ticket")
		rec = self.daemon.tickets.cancel(tid)
		if rec is None:
			return err("no-ticket")
		return {"ok": True, "ticket": rec}

	def ticket_remove(self, req):
		# Drop a finished ticket from the store and disk; running tickets
		# must be cancelled first.
		tid = req.get("id")
		if not (isinstance(tid, str) and tid):
			return bad_request()
		try:
			rec = self.daemon.tickets.store.remove(tid)
		except ValueError:
			return err("running")
		if rec is None:
			return err("no-ticket")
		return {"ok": True, "removed": tid}

	def tickets_reset(self, _req):
		# Kill the ticketing service state for a reset: cancel every
		# running ticket, wipe the persisted store and every artifact,
		# restart the id counter. Hosted sessions and the rest of the
		# daemon are untouched; a full stop remains `shutdown` /
		# pi-rc daemon-stop.
		cancelled = 0
		for rec in self.daemon.tickets.store.snapshot():
			if rec.get("status") != "running":
				continue
			self.daemon.tickets.cancel(rec["id"])
			cancelled += 1
		removed = self.daemon.tickets.store.reset()
		log("tickets-reset: cancelled %d, removed %d" % (cancelled, removed))
		return {"ok": True, "cancelled": cancelled, "removed": removed}

	def input(self, req):
		"""Write raw text into a hosted session's PTY master (the same path
		the attach bridge uses), e.g. to type a slash command into its TUI."""
		name = req.get("name")
		text = req.get("text")
		if not isinstance(name, str) or not isinstance(text, str):
			return bad_request()
		sess = self.daemon.table.get(name)
		if sess is None:
			return err("no-session")
		data = text.encode("utf-8", "replace")
		try:
			os.write(sess.master_fd, data)
		except OSError as exc:
			return err("write-failed: %s" % exc)
		return {"ok": True, "bytes": len(data)}

	def extensions_reload(self, req):
		"""Signal hosted conversation sessions to reload in place so pi
		re-scans extensions, skills, prompts, themes and context files.
		When the extension roots actually changed, the file-level diff is
		persisted for the in-session extension to relay to the agent once
		it settles. force=1 reloads even without changes.

		The reload is injected directly: the daemon writes a one-shot
		per-session signal file (fresh round token) under the state dir
		and the in-session daemon extension consumes it and runs pi's own
		reload flow programmatically (ctx.reload()) — the same flow as a
		typed /reload, without ever putting keystrokes into the TUI. A
		signal the extension does not consume within RELOAD_SIGNAL_GRACE
		(old extension without the watcher) is deleted again and the
		daemon falls back to typing "/reload" into the session's PTY, so
		first-adoption sessions still reload.

		Optional sessions=[names] narrows the round to exactly those
		sessions; the automatic watch uses it so every live reloadable
		session is owed exactly one reload per change while busy sessions
		retry in later rounds.

		Strictly in-place: this function only signals sessions that
		already exist; it never starts, respawns, or revives anything.
		A session that dies while processing the reload stays dead
		(reload_injected clears the revival path) instead of being
		spawned fresh, so a broken update cannot turn one reload into a
		spawn storm.

		The on-disk snapshot advances only when a full round completes;
		when any targeted reloadable session was skipped as not-idle, the
		deferred flag comes back true with the old snapshot (and the
		pending diff) left on disk so the caller retries rather than
		silently dropping the change for the busy session."""
		force = bool(req.get("force"))
		only = req.get("sessions")
		if not isinstance(only, (list, tuple, set, frozenset)):
			only = None
		prev_fp = _read_ext_snapshot()
		fp = ext_root_fingerprint(EXT_WATCH_ROOTS)
		diff = ext_diff_files(prev_fp, fp) if prev_fp else \
			{"added": [], "removed": [], "changed": []}
		if not force and prev_fp and not any(diff.values()):
			return {"ok": True, "reloaded": [], "skipped": [],
					"unchanged": True}
		reloaded, skipped = [], []
		deferred = False
		token = _new_reload_token()
		pending = []
		for sess in self.daemon.table.snapshot():
			if only is not None and sess.name not in only:
				continue
			if self._session_reloadable(sess):
				if sess.state != "idle":
					# Best-effort skip: pi refuses a reload while a
					# response is running, and a session parked on a blocking
					# daemon wait ('waiting') has its turn still open too;
					# defer this round instead of injecting into a session
					# that would deny it. Applies even with --force.
					skipped.append({"id": sess.name, "reason": "not-idle"})
					deferred = True
					continue
				if _write_reload_signal(sess.name, token):
					# The in-session extension consumes the signal and runs
					# pi's own reload flow. No spawn escape: if this session
					# dies while the reload is being processed (a broken
					# extension, for example), it stays dead instead of
					# being revived headless as a fresh spawn. The guard
					# stays armed (reload_injected_at) until the session
					# survives past the reload guard grace or announces a
					# different conversation file.
					sess.reload_injected = True
					sess.reload_injected_at = time.time()
					pending.append(sess)
				elif self._type_reload(sess):
					reloaded.append(sess.name)
				else:
					skipped.append({"id": sess.name,
									"reason": "write-failed"})
			else:
				skipped.append({"id": sess.name,
								"reason": "not-reloadable"})
		deadline = time.monotonic() + RELOAD_SIGNAL_GRACE
		consumed = []
		while pending and time.monotonic() < deadline:
			time.sleep(RELOAD_SIGNAL_POLL)
			# Consumed = the extension deleted the signal file after
			# queueing pi's reload; absent files are done.
			remaining = [s for s in pending
						 if os.path.exists(_reload_signal_path(s.name))]
			consumed += [s for s in pending if s not in remaining]
			pending = remaining
		for sess in consumed:
			reloaded.append(sess.name)
		for sess in pending:
			# Unconsumed: an extension without the watcher never picked
			# the signal up. Clear the stale file and fall back to typing
			# /reload into the PTY the old way so the session still
			# reloads; a failed PTY write disarms the guard again (a
			# reload that never started must not suppress revival).
			_clear_reload_signal(sess.name)
			if self._type_reload(sess):
				reloaded.append(sess.name)
			else:
				sess.reload_injected = False
				sess.reload_injected_at = 0.0
				skipped.append({"id": sess.name,
								"reason": "write-failed"})
		if only is None and reloaded and not deferred:
			# Stamp/reload stay atomic: persist the snapshot and diff only
			# when a whole-table round reloaded every targeted reloadable
			# session. While one is busy, the old snapshot stays on disk so
			# the watch retries a refreshed diff on later polls and the
			# busy session still gets its reload. Filtered (watch) rounds
			# never stamp here: the watch owns that once its owed set is
			# empty, exactly once per pending change.
			_write_ext_snapshot(fp, diff)
			if any(diff.values()):
				_write_ext_diff(diff)
		return {"ok": True, "reloaded": reloaded, "skipped": skipped,
				"deferred": deferred, "diff": diff,
				"live": [s.name for s in self.daemon.table.snapshot()
						 if self._session_reloadable(s)]}

	@staticmethod
	def _type_reload(sess):
		"""Fallback injection for extensions that predate the reload
		signal file: type "/reload" into the session's PTY the way the
		attach bridge would. Returns False when the PTY refuses the
		write (a dead or gone session)."""
		try:
			os.write(sess.master_fd, b"/reload\r")
		except OSError:
			return False
		return True

	@staticmethod
	def _session_reloadable(sess):
		"""An interactive hosted pi that announced a conversation file: its
		TUI can accept /reload in place. The live spawn argv carries no
		--session for `start`ed sessions (the file arrives via announce),
		so the announced file is the reliable marker. Ephemeral
		--no-session runs announce nothing and have no TUI to reload.

		Injection contract: a reload may re-scan/reload pi's loaded
		resources in place, but must never terminate sessions, remove them
		from the registry/table, or touch conversation files; injections
		happen via the per-session reload signal file (consumed by the
		in-session extension) or, as a fallback, via
		os.write(sess.master_fd, ...). State-based skipping
		is best-effort: pi denies a reload injected into a truly-busy
		session with its own warning."""
		argv = sess.argv or []
		return bool(sess.file) and "--no-session" not in argv

	def shutdown(self, _req):
		t = threading.Thread(target=self.daemon.shutdown, daemon=True)
		t.start()
		return {"ok": True}

	def daemon_restart(self, _req):
		"""Restart the daemon itself (see Daemon.restart): the response
		is sent first, exactly like the shutdown op, because the daemon
		exits mid-flow and the requesting session - a hosted pi running
		/daemon-reload - is killed with every other hosted session. The
		successor respawns it from its registry entry."""
		t = threading.Thread(target=self.daemon.restart, daemon=True)
		t.start()
		return {"ok": True, "restarting": True}


def _dir_base(dir_):
	# Mirrors handover_target's name base handling.
	base = os.path.basename(dir_).replace(":", "_")
	if base.startswith("="):
		base = base[1:]
	return base


# Sentinel returned by the attach dispatch: the connection is now a raw
# bridge and the connection thread must not touch it again.
_BRIDGE_HANDOFF = object()


def ext_watch_loop(daemon, stop_event):
	"""Poll the extension roots; on change, reload every hosted session
	(once per EXT_WATCH_DEBOUNCE window) so updated extensions go live in
	place. Seeds the baseline from the snapshot file so a daemon restart
	does not retrigger.

	Every live reloadable session is owed exactly one reload for a
	pending change. A session that is mid-turn or parked on a blocking
	daemon wait when its turn comes is retried on later polls (the diff
	is refreshed from the old snapshot each round, so newer edits
	supersede the pending one), and the snapshot advances only when
	every owed session has been reloaded or is gone. Sessions that start
	after the change boot the new code directly and never join the owed
	set."""
	if not EXT_WATCH_ENABLED:
		return
	prev_fp = _read_ext_snapshot()
	if prev_fp is None:
		prev_fp = ext_root_fingerprint(EXT_WATCH_ROOTS)
		_write_ext_snapshot(prev_fp, None)
	last_reload = 0.0
	owed = set()
	busy_rounds = 0
	reloaded_count = 0
	while not stop_event.wait(EXT_WATCH_INTERVAL):
		fp = ext_root_fingerprint(EXT_WATCH_ROOTS)
		now = time.monotonic()
		if not owed:
			if fp == prev_fp or now - last_reload < EXT_WATCH_DEBOUNCE:
				continue
			# A change arrived (the debounce window closed): every live
			# session is owed one reload; extensions_reload drops the
			# ones that are not reloadable from its live list.
			owed = {s.name for s in daemon.table.snapshot()}
			if not owed:
				# Nothing can take an in-place reload (none hosted,
				# headless workers only): sessions started from here load
				# the new code directly. Absorb and persist so the stored
				# snapshot matches what is live.
				diff = ext_diff_files(prev_fp, fp) if prev_fp else \
					{"added": [], "removed": [], "changed": []}
				_write_ext_snapshot(fp, diff)
				if any(diff.values()):
					_write_ext_diff(diff)
				prev_fp = fp
				last_reload = now
				log("extension change absorbed: no hosted session to reload")
				continue
			reloaded_count = 0
		res = daemon.control.extensions_reload(
			{"sessions": sorted(owed)})
		if res.get("unchanged"):
			# A whole-table round (manual pi-rc extensions-reload) already
			# stamped this change: nothing is owed anymore.
			prev_fp = fp
			owed.clear()
			continue
		reloaded_count += len(res.get("reloaded", []))
		owed -= set(res.get("reloaded", []))
		if res.get("deferred"):
			# Some owed session is mid-turn or waiting on a daemon wait
			# (skipped "not-idle"): keep the OLD fingerprint and retry
			# the pending diff every poll until it goes idle. Never give
			# up: absorbing the fingerprint without typing /reload would
			# silently lose the change for the busy session.
			busy_rounds += 1
			if busy_rounds == 1 or busy_rounds % 5 == 0:
				log("extension reload deferred: hosted session(s) "
					"busy (round %d)" % busy_rounds)
			continue
		busy_rounds = 0
		# Drop owed sessions that are gone or no longer reloadable: a
		# session that died mid-reload stays dead (reload guard), and one
		# that stopped or was replaced boots the new code directly at its
		# next start, so nothing more can (or should) reload it here.
		owed &= set(res.get("live") or [])
		# A session whose PTY refused the write cannot be reloaded here
		# either; it dies and boots the new code on revive instead.
		for entry in res.get("skipped") or []:
			if isinstance(entry, dict) \
					and entry.get("reason") == "write-failed":
				owed.discard(entry.get("id"))
		if not owed:
			diff = res.get("diff") or {}
			_write_ext_snapshot(fp, diff)
			if any(diff.values()):
				_write_ext_diff(diff)
			prev_fp = fp
			last_reload = now
			log("reloaded %d hosted session(s) after extension change"
				% reloaded_count)


def main(argv=None):
	if argv is None:
		argv = sys.argv[1:]
	if argv:
		# pi-daemon is a pure daemon entry point; every control command
		# lives in pi-rc. Accepting argv silently turned probes such as
		# `pi-daemon status` into full daemon instances whose stderr is
		# the probe's console pipe, which then dies under the daemon.
		try:
			sys.stderr.write("pi-daemon: takes no arguments (got %r); "
							 "control commands live in pi-rc\n" % (argv,))
		except Exception:
			pass
		return 2
	if not _stderr_writable():
		# A probe-spawned daemon inherits the caller's console pipe, which
		# can already be dead or may die while the daemon lives on; fall
		# back to appending to the daemon log so log() keeps a destination.
		try:
			sys.stderr = open(LOG_PATH, "a", buffering=1,
							  encoding="utf-8", errors="replace")
		except OSError:
			pass
	daemon = Daemon(Registry(REG_PATH))
	threading.Thread(target=ext_watch_loop,
					 args=(daemon, daemon.shutdown_event),
					 daemon=True).start()
	return daemon.serve()


def _stderr_writable():
	# Cheap probe so a daemon whose stderr is already unusable starts on
	# the daemon log instead of a dead pipe.
	try:
		sys.stderr.write("")
		sys.stderr.flush()
		return True
	except Exception:
		return False


if __name__ == "__main__":
	sys.exit(main())
