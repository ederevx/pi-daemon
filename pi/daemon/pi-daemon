def log(msg):
	# Daemon output goes to stderr (the journal); stdout is never used.
	# A broken stderr (a transient probe's dead console pipe) must never
	# take a request handler down mid-response, so every write failure is
	# swallowed; main() keeps real daemons on the journal or the log file.
	with LOG_LOCK:
		_rotate_log()
		try:
			sys.stderr.write("pi-daemon: %s\n" % msg)
			sys.stderr.flush()
		except Exception:
			pass


def _rotate_log():
	# The detached daemon appends to one log file forever; cap it by
	# rotating once past LOG_MAX_BYTES (single .1 generation, so the
	# footprint stays bounded). Only the daemon's own log is touched:
	# stderr must be the regular file at LOG_PATH (journald's stderr is
	# not). rename + fresh-open + dup2 under LOG_LOCK: sys.stderr keeps
	# writing through fd 2 into the fresh file. Windows rejects a rename
	# onto an existing target, so the stale rotation is removed first.
	try:
		st = os.fstat(2)
		logst = os.stat(LOG_PATH)
	except OSError:
		return
	if (not stat.S_ISREG(st.st_mode)
			or (st.st_dev, st.st_ino) != (logst.st_dev, logst.st_ino)
			or st.st_size <= LOG_MAX_BYTES):
		return
	try:
		try:
			os.replace(LOG_PATH, LOG_PATH + ".1")
		except OSError:
			os.remove(LOG_PATH + ".1")
			os.replace(LOG_PATH, LOG_PATH + ".1")
		fresh = os.open(LOG_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND,
						0o600)
		try:
			os.dup2(fresh, 2)
		finally:
			os.close(fresh)
	except OSError:
		pass


def kill_socket(client):
	# Shut the socket down and pin its fd number to devnull before closing
	# it: control threads and session loops run concurrently, so the moment
	# the number is released a fresh connection could claim it and inherit
	# a stray shutdown or close.
	try:
		client.shutdown(socket.SHUT_RDWR)
	except OSError:
		pass
	try:
		null = os.open(os.devnull, os.O_RDONLY)
		try:
			os.dup2(null, client.fileno())
		finally:
			os.close(null)
	except OSError:
		pass
	try:
		client.close()
	except OSError:
		pass


