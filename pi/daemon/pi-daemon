def log(msg):
	# Daemon output goes to stderr (the journal); stdout is never used.
	with LOG_LOCK:
		sys.stderr.write("pi-daemon: %s\n" % msg)
		sys.stderr.flush()


def set_winsize(fd, cols, rows):
	fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


def child_sigwinch(pid):
	try:
		os.killpg(pid, signal.SIGWINCH)
	except OSError:
		pass


def kill_socket(client):
	# Shut the socket down and pin its fd number to devnull before closing
	# it: control threads and session loops run concurrently, so the moment
	# the number is released a fresh connection could claim it and inherit
	# a stray shutdown or close.
	try:
		client.shutdown(socket.SHUT_RDWR)
	except OSError:
		pass
	try:
		null = os.open(os.devnull, os.O_RDONLY)
		try:
			os.dup2(null, client.fileno())
		finally:
			os.close(null)
	except OSError:
		pass
	try:
		client.close()
	except OSError:
		pass


def send_json(sock, obj):
	sock.sendall(json.dumps(obj).encode() + b"\n")


def bad_request():
	return {"ok": False, "error": "bad-request"}


def err(error):
	return {"ok": False, "error": error}


def _exit_abnormal(status):
	# waitpid status of an abnormally dying child (signal or nonzero
	# code); a clean exit is a deliberate quit (Ctrl+D, /exit) and is
	# final.
	if status and os.WIFSIGNALED(status):
		return True
	if status and os.WIFEXITED(status):
		return os.WEXITSTATUS(status) != 0
	return False


def _on_signal(_signum, _frame):
	raise SystemExit(0)


class LineReader:
	"""Incremental JSON-line reader over a control socket."""

	def __init__(self, sock):
		self.sock = sock
		self.buf = b""

	def readline(self):
		while b"\n" not in self.buf:
			if len(self.buf) > MAX_BUF:
				raise ValueError("line too long")
			data = self.sock.recv(65536)
			if not data:
				if self.buf:
					raise ValueError("truncated line")
				return None
			self.buf += data
		line, self.buf = self.buf.split(b"\n", 1)
		return line


class Registry:
	"""The on-disk session registry: daemon-restart respawn state."""

	def __init__(self, path):
		self.path = path
		self._lock = threading.Lock()

	def load(self):
		try:
			with open(self.path) as f:
				data = json.load(f)
			return data if isinstance(data, dict) else {}
		except (OSError, ValueError):
			return {}

	def write(self, data):
		# Atomic replacement so readers never see a partial file.
		with self._lock:
			os.makedirs(os.path.dirname(self.path), exist_ok=True)
			tmp = self.path + ".tmp"
			with open(tmp, "w") as f:
				json.dump(data, f)
				f.write("\n")
				f.flush()
				os.fsync(f.fileno())
			os.replace(tmp, self.path)

	def add(self, name, dir_, argv):
		data = self.load()
		data[name] = {"dir": dir_, "argv": list(argv)}
		self.write(data)

	def drop(self, name):
		data = self.load()
		if name in data:
			del data[name]
			self.write(data)

	def set_argv(self, name, argv):
		# An announced session file rewrites the resume argv so a daemon
		# restart respawns the same conversation instead of a blank one.
		data = self.load()
		if name in data:
			data[name]["argv"] = list(argv)
			self.write(data)


class TicketStore:
	"""Durable offloaded-command ticket state: one tickets.json plus one
	output log per ticket. The in-memory dict is authoritative; every
	mutation is written through atomically like Registry. The store's
	lock doubles as the wait condition so ticket completion signals
	blocked ticket-wait callers."""

	def __init__(self, path, log_dir):
		self.path = path
		self.log_dir = log_dir
		self.lock = threading.Lock()
		self.cond = threading.Condition(self.lock)
		self._tickets = {}
		self._next = 1

	def load(self):
		try:
			with open(self.path) as f:
				data = json.load(f)
		except (OSError, ValueError):
			data = {}
		if not isinstance(data, dict):
			data = {}
		tickets = data.get("tickets")
		self._tickets = tickets if isinstance(tickets, dict) else {}
		try:
			self._next = int(data.get("next", 1))
		except (TypeError, ValueError):
			self._next = 1
		if self._next < 1:
			self._next = 1

	def _write_locked(self):
		os.makedirs(os.path.dirname(self.path), exist_ok=True)
		tmp = self.path + ".tmp"
		with open(tmp, "w") as f:
			json.dump({"next": self._next, "tickets": self._tickets}, f)
			f.write("\n")
			f.flush()
			os.fsync(f.fileno())
		os.replace(tmp, self.path)

	def alloc_id_locked(self):
		# Caller holds the lock: ids must strictly increase across the
		# whole persisted history, so the counter rides the same file.
		tid = "t-%d" % self._next
		self._next += 1
		return tid

	def add(self, rec):
		with self.lock:
			self._tickets[rec["id"]] = rec
			self._write_locked()
			return dict(rec)

	def get(self, tid):
		with self.lock:
			rec = self._tickets.get(tid)
			return dict(rec) if rec is not None else None

	def get_locked(self, tid):
		# Caller already holds the lock (directly or via cond.wait).
		return self._tickets.get(tid)

	def snapshot(self, session=None, kind=None):
		with self.lock:
			recs = [dict(r) for r in self._tickets.values()
					if (session is None or r.get("session") == session)
					and (kind is None
						 or r.get("kind", "shell") == kind)]
		return sorted(recs, key=lambda r: r["id"])

	def update(self, tid, **fields):
		# Mutate, persist, and broadcast under one lock; the broadcast
		# wakes every blocked ticket-wait caller.
		with self.cond:
			rec = self._tickets.get(tid)
			if rec is None:
				return None
			rec.update(fields)
			self._write_locked()
			self.cond.notify_all()
			return dict(rec)

	def mark_interrupted(self):
		# Daemon restart: subprocesses died with the old process, so a
		# ticket can never finish. Logs survive for inspection until GC.
		with self.lock:
			changed = False
			for rec in self._tickets.values():
				if rec.get("status") == "running":
					rec["status"] = "lost"
					rec["finished"] = time.time()
					rec["error"] = "interrupted by daemon restart"
					changed = True
			if changed:
				self._write_locked()

	def log_path(self, tid):
		return os.path.join(self.log_dir, "%s.log" % tid)

	def artifact_path(self, tid, kind):
		# "log": command/agent stdout; "err": agent stderr; "prompt":
		# daemon-side copy of an agent's system prompt file.
		suffix = {"log": ".log", "err": ".err", "prompt": ".prompt"}[kind]
		return os.path.join(self.log_dir, "%s%s" % (tid, suffix))

	def unlink_artifacts(self, tid):
		for suffix in (".log", ".err", ".prompt"):
			try:
				os.unlink(os.path.join(self.log_dir, "%s%s" % (tid, suffix)))
			except OSError:
				pass

	def remove(self, tid):
		# Agents drop finished tickets from the store and disk; running
		# tickets must be cancelled first (raise ValueError("running")).
		with self.lock:
			rec = self._tickets.get(tid)
			if rec is None:
				return None
			if rec.get("status") == "running":
				raise ValueError("running")
			del self._tickets[tid]
			self._write_locked()
		self.unlink_artifacts(tid)
		return rec

	def reset(self):
		# Wipe every record and artifact and restart the id counter: a
		# clean ticketing slate for reset purposes. Callers cancel running
		# tickets first; any still marked running here are wiped regardless
		# (their processes were killed by the reset path).
		with self.lock:
			tids = list(self._tickets)
			count = len(tids)
			self._tickets = {}
			self._next = 1
			self._write_locked()
		for tid in tids:
			self.unlink_artifacts(tid)
		return count

	def read_range(self, path, offset, cap):
		# Returns (start, next, size, data); offset past size yields empty
		# data with next == offset so relays never stall on a bad offset.
		try:
			size = os.path.getsize(path)
		except OSError:
			size = 0
		if offset >= size:
			return offset, offset, size, b""
		length = min(cap, size - offset)
		try:
			with open(path, "rb") as f:
				f.seek(offset)
				data = f.read(length)
		except OSError:
			data = b""
		return offset, offset + len(data), size, data

	def gc(self, now, ttl, max_finished):
		# Running tickets never expire; finished tickets drop after ttl
		# seconds, plus the oldest ones beyond the finished cap. Expired
		# output logs are unlinked by the caller.
		with self.lock:
			finished = sorted(
				(tid for tid, r in self._tickets.items()
				 if r.get("status") != "running"),
				key=lambda tid: self._tickets[tid].get("finished") or 0.0)
			removed = [tid for tid in finished
					   if now - (self._tickets[tid].get("finished") or 0.0) > ttl]
			for tid in finished:
				if len(finished) - len(removed) <= max_finished:
					break
				if tid not in removed:
					removed.append(tid)
			for tid in removed:
				del self._tickets[tid]
			if removed:
				self._write_locked()
		return removed


class TicketRunner:
	"""Runs offloaded commands as daemon-owned subprocesses: one output
	log per ticket, condition-signalled completion, a periodic GC sweep,
	and a stop() that reaps children before daemon shutdown persists."""

	def __init__(self, store, shutdown_event, node_path=None, front_path=None):
		self.store = store
		self.shutdown_event = shutdown_event
		# When node and the pi-compatible front are available, delegation
		# children spawn through the front (marked PI_DAEMON_AGENT_CHILD so
		# the front runs pi instead of re-submitting) — its argv[1] keeps
		# the delegation's own children resolvable back to the daemon.
		self.node_path = node_path
		self.front_path = front_path
		self._lock = threading.Lock()
		self._procs = {}    # tid -> Popen, under _lock
		self._stops = {}    # tid -> cancellation reason, under _lock

	def start(self):
		self.store.load()
		self.store.mark_interrupted()
		t = threading.Thread(target=self._gc_loop, daemon=True)
		t.start()

	def running_count(self):
		with self._lock:
			return len(self._procs)

	def submit(self, session, cwd, command, env=None):
		with self._lock:
			if len(self._procs) >= TICKET_MAX_RUNNING:
				return None
		with self.store.lock:
			tid = self.store.alloc_id_locked()
		rec = {"id": tid, "kind": "shell", "session": session, "cwd": cwd,
			   "command": command,
			   "status": "running", "created": time.time(),
			   "started": time.time(), "finished": None, "exit": None,
			   "term": None, "truncated": False, "error": None}
		os.makedirs(self.store.log_dir, exist_ok=True)
		proc = subprocess.Popen(
			["bash", "-c", command], cwd=cwd,
			env=env if env else os.environ.copy(),
			stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
			stderr=subprocess.STDOUT, start_new_session=True, bufsize=0)
		rec = self.store.add(rec)
		with self._lock:
			self._procs[tid] = proc
		t = threading.Thread(target=self._run, args=(tid, proc), daemon=True)
		t.start()
		log("ticket-submit '%s' session '%s' in %s"
			% (tid, session, cwd))
		return rec

	def wait(self, tid, timeout):
		deadline = time.time() + max(0.0, min(float(timeout or 0), TICKET_MAX_WAIT))
		with self.store.cond:
			rec = self.store.get_locked(tid)
			if rec is None:
				return None
			while rec["status"] == "running" and time.time() < deadline:
				self.store.cond.wait(deadline - time.time())
				rec = self.store.get_locked(tid)
				if rec is None:
					return None
			return dict(rec)

	def output(self, tid, offset):
		rec = self.store.get(tid)
		if rec is None:
			return None
		path = self.store.log_path(tid)
		try:
			size = os.path.getsize(path)
		except OSError:
			size = 0
		if offset >= size:
			return {"offset": offset, "next": offset, "size": size,
					"data": b""}
		length = min(TICKET_CHUNK, size - offset)
		try:
			with open(path, "rb") as f:
				f.seek(offset)
				data = f.read(length)
		except OSError:
			data = b""
		return {"offset": offset, "next": offset + len(data), "size": size,
				"data": data}

	def cancel(self, tid):
		rec = self.store.get(tid)
		if rec is None:
			return None
		if rec["status"] != "running":
			return rec
		with self._lock:
			proc = self._procs.get(tid)
			if proc is not None and proc.poll() is None:
				self._stops[tid] = "cancelled"
				target = proc
			else:
				target = None
		if target is None:
			# Reaped between the record read and here: the runner thread's
			# final update lands within a moment; wait for it.
			self.wait(tid, 5.0)
			return self.store.get(tid)
		try:
			os.killpg(target.pid, signal.SIGTERM)
		except OSError:
			pass
		deadline = time.time() + KILL_GRACE
		while time.time() < deadline and target.poll() is None:
			time.sleep(0.05)
		if target.poll() is None:
			try:
				os.killpg(target.pid, signal.SIGKILL)
			except OSError:
				pass
		try:
			target.wait(timeout=KILL_GRACE)
		except Exception:
			pass
		return self.store.get(tid)

	def _run(self, tid, proc):
		# Reader thread: append the child's merged stdout/stderr to the
		# ticket log until the output cap, then record the exit.
		captured = 0
		truncated = False
		logf = None
		try:
			logf = open(self.store.log_path(tid), "wb")
		except OSError as exc:
			log("ticket '%s' log open failed: %s" % (tid, exc))
		try:
			while True:
				try:
					# bufsize=0: os.read returns whatever is available, so
					# incremental output lands in the log as it is produced.
					chunk = os.read(proc.stdout.fileno(), 65536)
				except OSError:
					chunk = b""
				if not chunk:
					break
				if logf is None:
					truncated = True
				elif captured < TICKET_OUTPUT_MAX:
					room = TICKET_OUTPUT_MAX - captured
					logf.write(chunk[:room])
					logf.flush()
					captured += min(len(chunk), room)
					if len(chunk) > room:
						truncated = True
						logf.close()
						logf = None
				else:
					truncated = True
		finally:
			if logf is not None:
				logf.close()
			try:
				proc.stdout.close()
			except OSError:
				pass
			code = proc.wait()
		self._finish(tid, code, truncated)

	def _finish(self, tid, code, truncated):
		with self._lock:
			self._procs.pop(tid, None)
			reason = self._stops.pop(tid, None)
		fields = {"status": "done" if code == 0 else "failed",
				  "exit": code if code >= 0 else None,
				  "term": -code if code < 0 else None,
				  "finished": time.time(), "truncated": truncated}
		if reason is not None:
			fields["status"] = "cancelled"
			fields["error"] = reason
		self.store.update(tid, **fields)
		log("ticket-done '%s' status %s" % (tid, fields["status"]))

	def _gc_loop(self):
		while not self.shutdown_event.wait(TICKET_GC_TICK):
			try:
				removed = self.store.gc(time.time(), TICKET_TTL,
										TICKET_MAX_FINISHED)
				for tid in removed:
					self.store.unlink_artifacts(tid)
				if removed:
					log("ticket-gc removed %d" % len(removed))
			except Exception as exc:
				log("ticket-gc error: %r" % (exc,))

	def stop(self):
		# Daemon shutdown: TERM every running child, bounded grace, KILL,
		# then force any record the reader threads lost the race on to
		# "lost" so the persisted state never claims a live process.
		with self._lock:
			procs = list(self._procs.values())
			tids = list(self._procs.keys())
			for tid in tids:
				self._stops.setdefault(tid, "interrupted by daemon shutdown")
		for proc in procs:
			try:
				os.killpg(proc.pid, signal.SIGTERM)
			except OSError:
				pass
		deadline = time.time() + KILL_GRACE
		while time.time() < deadline:
			with self._lock:
				if not self._procs:
					break
			time.sleep(0.05)
		with self._lock:
			alive = list(self._procs.values())
		for proc in alive:
			try:
				os.killpg(proc.pid, signal.SIGKILL)
			except OSError:
				pass
		for proc in alive:
			try:
				proc.wait(timeout=KILL_GRACE)
			except Exception:
				pass
		for tid in tids:
			rec = self.store.get(tid)
			if rec is not None and rec["status"] == "running":
				self.store.update(tid, status="lost", finished=time.time(),
							  error="interrupted by daemon shutdown")


class AgentTicketRunner:
	"""Runs headless subagent delegations (`pi --mode json -p`) as
	daemon-owned tickets, sharing the shell TicketStore: the stdout NDJSON
	event stream and stderr are captured to separate logs (never merged:
	the wrapper relay frames on NDJSON lines), the system-prompt file is
	copied daemon-side at submit (the caller's temp copy is deleted when
	its run ends, while the ticket may outlive it), and the turn budget is
	enforced by counting assistant message_end events."""

	def __init__(self, store, shutdown_event, node_path=None, front_path=None):
		self.store = store
		self.shutdown_event = shutdown_event
		# When node and the pi-compatible front are available, delegation
		# children spawn through the front (marked PI_DAEMON_AGENT_CHILD so
		# the front runs pi instead of re-submitting) — its argv[1] keeps
		# the delegation's own children resolvable back to the daemon.
		self.node_path = node_path
		self.front_path = front_path
		self._lock = threading.Lock()
		self._procs = {}    # tid -> Popen, under _lock
		self._stops = {}    # tid -> cancellation reason, under _lock

	def running_count(self):
		with self._lock:
			return len(self._procs)

	def submit(self, session, cwd, pi_path, args, env, max_turns):
		with self._lock:
			if len(self._procs) >= AGENT_MAX_RUNNING:
				return None
		with self.store.lock:
			tid = self.store.alloc_id_locked()
		# Copy the system prompt daemon-side before acking and repoint the
		# argv at the copy: the caller's temp file is deleted on cleanup.
		run_args = list(args)
		os.makedirs(self.store.log_dir, exist_ok=True)
		for i, arg in enumerate(run_args):
			if arg == "--append-system-prompt" and i + 1 < len(run_args):
				src = run_args[i + 1]
				if src and os.path.isfile(src):
					os.makedirs(self.store.log_dir, exist_ok=True)
					prompt_copy = self.store.artifact_path(tid, "prompt")
					try:
						shutil.copyfile(src, prompt_copy)
						run_args[i + 1] = prompt_copy
					except OSError as exc:
						log("agent-submit '%s' prompt copy failed: %s"
							% (tid, exc))
				break
		argv = [pi_path] + run_args
		env_run = env if env else os.environ.copy()
		if self.front_path and self.node_path:
			# Route through the front so the child's own delegation
			# children resolve back to the daemon; the marker makes the
			# front run pi instead of re-submitting this same task.
			argv = [self.node_path, self.front_path] + run_args
			env_run = dict(env_run)
			env_run["PI_DAEMON_AGENT_CHILD"] = "1"
		# A delegation child is a plain worker, not a hosted session: strip
		# the hosting identity so the child's own daemon extension cannot
		# announce or publish state against the parent's live session.
		env_run.pop("PI_HOSTED", None)
		env_run.pop("PI_HOSTED_SESSION", None)
		rec = {"id": tid, "kind": "agent", "session": session, "cwd": cwd,
			   "command": " ".join(argv), "status": "running",
			   "created": time.time(), "started": time.time(),
			   "finished": None, "exit": None, "term": None,
			   "truncated": False, "error": None,
			   "max_turns": max_turns, "turns": 0}
		proc = subprocess.Popen(
			argv, cwd=cwd, env=env_run,
			stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
			stderr=subprocess.PIPE, start_new_session=True, bufsize=0)
		rec = self.store.add(rec)
		with self._lock:
			self._procs[tid] = proc
		t = threading.Thread(target=self._run, args=(tid, proc), daemon=True)
		t.start()
		log("agent-submit '%s' session '%s' in %s" % (tid, session, cwd))
		return rec

	def wait(self, tid, timeout):
		# Same contract as TicketRunner.wait; the store condition is shared.
		deadline = time.time() + max(0.0, min(float(timeout or 0), TICKET_MAX_WAIT))
		with self.store.cond:
			rec = self.store.get_locked(tid)
			if rec is None:
				return None
			while rec["status"] == "running" and time.time() < deadline:
				self.store.cond.wait(deadline - time.time())
				rec = self.store.get_locked(tid)
				if rec is None:
					return None
			return dict(rec)

	def output(self, tid, out_offset, err_offset):
		rec = self.store.get(tid)
		if rec is None:
			return None
		out = self.store.read_range(self.store.artifact_path(tid, "log"),
									out_offset, AGENT_CHUNK)
		err = self.store.read_range(self.store.artifact_path(tid, "err"),
									err_offset, AGENT_CHUNK)
		return {"out": out, "err": err}

	def cancel(self, tid):
		rec = self.store.get(tid)
		if rec is None:
			return None
		if rec["status"] != "running":
			return rec
		with self._lock:
			proc = self._procs.get(tid)
			if proc is not None and proc.poll() is None:
				self._stops[tid] = "cancelled"
				target = proc
			else:
				target = None
		if target is None:
			self.wait(tid, 5.0)
			return self.store.get(tid)
		try:
			os.killpg(target.pid, signal.SIGTERM)
		except OSError:
			pass
		deadline = time.time() + KILL_GRACE
		while time.time() < deadline and target.poll() is None:
			time.sleep(0.05)
		if target.poll() is None:
			try:
				os.killpg(target.pid, signal.SIGKILL)
			except OSError:
				pass
		try:
			target.wait(timeout=KILL_GRACE)
		except Exception:
			pass
		return self.store.get(tid)

	def _count_event(self, tid, line, max_turns):
		# One complete stdout line: an assistant message_end is one turn.
		# Budget exhaustion kills the process group; the record keeps the
		# flag so the relay can report the real cause.
		try:
			obj = json.loads(line.decode("utf-8", "replace"))
		except (ValueError, UnicodeDecodeError):
			return
		if not isinstance(obj, dict) or obj.get("type") != "message_end":
			return
		event = obj.get("event") if isinstance(obj.get("event"), dict) else {}
		message = event.get("message") if isinstance(event.get("message"), dict) \
			else obj.get("message")
		if not isinstance(message, dict) or message.get("role") != "assistant":
			return
		rec = self.store.get(tid)
		if rec is None:
			return
		turns = int(rec.get("turns") or 0) + 1
		fields = {"turns": turns}
		if max_turns and turns >= max_turns \
				and rec.get("status") == "running" \
				and not rec.get("turn_budget_exhausted"):
			fields["turn_budget_exhausted"] = True
			with self._lock:
				proc = self._procs.get(tid)
			if proc is not None and proc.poll() is None:
				try:
					os.killpg(proc.pid, signal.SIGTERM)
				except OSError:
					pass
				log("agent '%s' turn budget exhausted (%d)"
					% (tid, max_turns))
		self.store.update(tid, **fields)

	def _run(self, tid, proc):
		rec = self.store.get(tid)
		max_turns = rec.get("max_turns") if rec else None
		t = threading.Thread(target=self._pump,
							 args=(tid, proc.stderr), daemon=True)
		t.start()
		truncated = False
		captured = 0
		logf = None
		try:
			logf = open(self.store.artifact_path(tid, "log"), "wb")
		except OSError as exc:
			log("agent '%s' log open failed: %s" % (tid, exc))
		line_buf = b""
		try:
			while True:
				try:
					chunk = os.read(proc.stdout.fileno(), 65536)
				except OSError:
					chunk = b""
				if not chunk:
					break
				if logf is None:
					truncated = True
				elif captured < AGENT_OUTPUT_MAX:
					room = AGENT_OUTPUT_MAX - captured
					logf.write(chunk[:room])
					logf.flush()
					captured += min(len(chunk), room)
					if len(chunk) > room:
						truncated = True
						logf.close()
						logf = None
				else:
					truncated = True
				line_buf += chunk
				while b"\n" in line_buf:
					line, line_buf = line_buf.split(b"\n", 1)
					self._count_event(tid, line, max_turns)
		finally:
			if logf is not None:
				logf.close()
			try:
				proc.stdout.close()
			except OSError:
				pass
			code = proc.wait()
		self._finish(tid, code, truncated)

	def _pump(self, tid, stream):
		# Stderr drain: separate log, never merged with the NDJSON stream.
		captured = 0
		logf = None
		try:
			logf = open(self.store.artifact_path(tid, "err"), "wb")
		except OSError as exc:
			log("agent '%s' err log open failed: %s" % (tid, exc))
		try:
			while True:
				try:
					chunk = os.read(stream.fileno(), 65536)
				except OSError:
					chunk = b""
				if not chunk:
					break
				if logf is None:
					continue
				if captured < AGENT_OUTPUT_MAX:
					room = AGENT_OUTPUT_MAX - captured
					logf.write(chunk[:room])
					logf.flush()
					captured += min(len(chunk), room)
		finally:
			if logf is not None:
				logf.close()
			try:
				stream.close()
			except OSError:
				pass

	def _finish(self, tid, code, truncated):
		with self._lock:
			self._procs.pop(tid, None)
			reason = self._stops.pop(tid, None)
		fields = {"status": "done" if code == 0 else "failed",
				  "exit": code if code >= 0 else None,
				  "term": -code if code < 0 else None,
				  "finished": time.time(), "truncated": truncated}
		if reason is not None:
			fields["status"] = "cancelled"
			fields["error"] = reason
		self.store.update(tid, **fields)
		log("agent-done '%s' status %s" % (tid, fields["status"]))

	def stop(self):
		# Daemon shutdown: identical contract to TicketRunner.stop.
		with self._lock:
			procs = list(self._procs.values())
			tids = list(self._procs.keys())
			for tid in tids:
				self._stops.setdefault(tid, "interrupted by daemon shutdown")
		for proc in procs:
			try:
				os.killpg(proc.pid, signal.SIGTERM)
			except OSError:
				pass
		deadline = time.time() + KILL_GRACE
		while time.time() < deadline:
			with self._lock:
				if not self._procs:
					break
			time.sleep(0.05)
		with self._lock:
			alive = list(self._procs.values())
		for proc in alive:
			try:
				os.killpg(proc.pid, signal.SIGKILL)
			except OSError:
				pass
		for proc in alive:
			try:
				proc.wait(timeout=KILL_GRACE)
			except Exception:
				pass
		for tid in tids:
			rec = self.store.get(tid)
			if rec is not None and rec["status"] == "running":
				self.store.update(tid, status="lost", finished=time.time(),
							  error="interrupted by daemon shutdown")


class SessionTable:
	"""Live sessions plus the single lock guarding them."""

	def __init__(self):
		self._sessions = {}
		self.lock = threading.Lock()

	def get(self, name):
		return self._sessions.get(name)

	def put(self, sess, refuse_if_exists=False):
		# Returns False when a refuse_if_exists put lost a race for the
		# name; the existing session is left untouched.
		with self.lock:
			if refuse_if_exists and self._sessions.get(sess.name) is not None:
				return False
			self._sessions[sess.name] = sess
			return True

	def remove_if(self, sess):
		# Drop only when the live entry is this very session (a respawn
		# may have taken the name). Returns the dropped name or None.
		with self.lock:
			if self._sessions.get(sess.name) is sess:
				del self._sessions[sess.name]
				return sess.name
			return None

	def snapshot(self):
		with self.lock:
			return list(self._sessions.values())

	def holders_of(self, file):
		# All live sessions backing this conversation file: the announced
		# file first (the extension recorded it), then a --session argv
		# match, which covers handover/revive spawns and announce-less
		# spawns that resume the same file. Caller holds the table lock.
		hits = []
		for sess in self._sessions.values():
			if sess.file == file:
				hits.append(sess)
		for sess in self._sessions.values():
			if sess in hits:
				continue
			argv = sess.argv or []
			for i, arg in enumerate(argv[:-1]):
				if arg == "--session" and argv[i + 1] == file:
					hits.append(sess)
					break
		return hits


class HandoffLedger:
	# Resume takeover: a duplicate holder of a live conversation announces
	# with takeover, yields to a busy holder or absorbs idle holders, and
	# shuts down; the ledger remembers where a shut-down duplicate's
	# viewers went so pi-rc attach can follow, surviving until the target
	# itself dies.

	def __init__(self):
		self._entries = {}

	def record(self, source, target):
		self._entries[source] = target

	def pop(self, source):
		self._entries.pop(source, None)

	def pending(self, source):
		return source in self._entries

	def follow(self, source, table):
		# The live holder a handed-off duplicate's viewers should follow,
		# or None. A dead intermediate target re-points at its own handoff
		# so a chain of simultaneous duplicates resolves to a live holder
		# instead of ending the follow.
		seen = set()
		while True:
			entry = self._entries.get(source)
			if entry is None or entry in seen:
				return None
			seen.add(entry)
			target = table.get(entry)
			if target is not None:
				return {"name": target.name, "state": target.state}
			# The holder died before the viewers followed; follow its own
			# handoff when it was itself a duplicate, else give up.
			self._entries.pop(source, None)
			source = entry

	def repoint_on_drop(self, dropped):
		# Handoff bookkeeping for a dead session: its own entry (as a
		# duplicate) survives — late viewers still follow it after the
		# duplicate shut down, and it dies with its target instead. But
		# as a TARGET it can no longer take viewers: re-point handoffs
		# through its own handoff when it was itself a duplicate, else
		# clear them.
		next_hop = self._entries.get(dropped)
		for key, val in list(self._entries.items()):
			if val == dropped:
				if next_hop and next_hop != key:
					self._entries[key] = next_hop
				else:
					self._entries.pop(key, None)


class Session:
	"""One hosted pi: its PTY, its bridge viewers, and the relay loop
	that owns the master fd."""

	def __init__(self, name, dir_, argv, pid, master_fd):
		self.name = name
		self.dir = dir_
		self.argv = list(argv)
		self.pid = pid
		self.master_fd = master_fd
		self.clients = {}      # bridge sockets -> per-client output buffer
		self.lock = threading.Lock()
		self.file = None       # announced pi session file, for revival
		self.state = "idle"    # model run state, published by the extension
		self.stopping = False  # set by an explicit stop: never revive
		self.spawned_at = time.time()
		self.carry_to = None   # live Session: viewers move there (loop-side)
		self.absorbing_until = 0.0
		self.yielded_to = None

	# -- bridge viewers ----------------------------------------------------

	def count_clients(self):
		with self.lock:
			return len(self.clients)

	def install_client(self, client, initial=b""):
		# Control-side: install a new bridge client. Returns the client
		# count after the join.
		with self.lock:
			self.clients[client] = bytearray(initial)
			return len(self.clients)

	def take_clients(self):
		# Move out every current viewer (carry): stale old-TUI buffers are
		# dropped by the mover; returns [(socket, buffer)] pairs.
		with self.lock:
			moved = list(self.clients.items())
			self.clients = {}
		return moved

	def drop_and_close(self, client):
		# Session-loop side: drop a client after an EOF/error the loop
		# itself observed; the pinned close happens here, never in the
		# control thread. A carry may have moved this socket to another
		# session: skip when the entry is already gone, so a stale loop
		# snapshot never closes a live bridge owned elsewhere.
		with self.lock:
			if self.clients.pop(client, None) is None:
				return
		kill_socket(client)

	def signal_closed(self):
		# Control-side detach: signal every bridge socket without closing;
		# the session loop observes the EOFs and does the pinned closes
		# itself, so no recycled fd can be caught mid-flight.
		with self.lock:
			clients = list(self.clients)
		for c in clients:
			try:
				c.shutdown(socket.SHUT_RDWR)
			except OSError:
				pass

	def close_bridge(self):
		# Child-side teardown: flush every client's remaining buffer, then
		# drop and close all bridge sockets.
		with self.lock:
			clients = list(self.clients.items())
			self.clients = {}
		for c, buf in clients:
			try:
				while buf:
					sent = c.send(bytes(buf[:65536]))
					del buf[:sent]
			except OSError:
				pass
			kill_socket(c)

	# -- child process / PTY -------------------------------------------------

	def winsize(self):
		try:
			pack = fcntl.ioctl(self.master_fd, termios.TIOCGWINSZ,
							   struct.pack("HHHH", 0, 0, 0, 0))
			rows, cols = struct.unpack("HHHH", pack)[:2]
		except OSError:
			rows, cols = 0, 0
		if not (rows > 0 and cols > 0):
			rows, cols = DEFAULT_ROWS, DEFAULT_COLS
		return rows, cols

	def resize(self, cols, rows):
		set_winsize(self.master_fd, cols, rows)
		child_sigwinch(self.pid)

	def nudge_repaint(self, cols, rows):
		# pi's TUI only repaints when the winsize actually changes (Node
		# fires the resize event on a change), so a reattach at the same
		# size would stay silent until the user types or resizes. Nudge the
		# size by one line first so the final size is always seen as a
		# change and the child redraws its whole frame. Callers must have
		# installed the client first: the full-frame repaint pi produces
		# from the resize is forwarded exclusively to installed clients.
		try:
			if rows > 1:
				set_winsize(self.master_fd, cols, rows - 1)
			else:
				set_winsize(self.master_fd, max(cols - 1, 1), rows)
			time.sleep(0.05)
		except OSError:
			pass
		try:
			set_winsize(self.master_fd, cols, rows)
		except OSError:
			pass
		child_sigwinch(self.pid)

	def kill_and_wait(self, grace):
		try:
			os.killpg(self.pid, signal.SIGTERM)
		except OSError:
			pass
		deadline = time.time() + grace
		while time.time() < deadline:
			try:
				if os.waitpid(self.pid, os.WNOHANG)[0] == self.pid:
					return
			except ChildProcessError:
				return
			time.sleep(0.1)
		try:
			os.killpg(self.pid, signal.SIGKILL)
		except OSError:
			pass

	def terminate(self, grace=KILL_GRACE):
		# Mark before the first signal lands so the exit path never
		# revives a session the user explicitly stopped.
		self.stopping = True
		self.kill_and_wait(grace)

	# -- projections ---------------------------------------------------------

	def holds_dir(self, dir_):
		try:
			return os.path.realpath(self.dir) == os.path.realpath(dir_)
		except OSError:
			return self.dir == dir_

	def view(self):
		# Projection for the list command; caller holds no locks.
		attached = self.count_clients()
		return {
			"name": self.name,
			"dir": self.dir,
			"pid": self.pid,
			"attached": attached > 0,
			"clients": attached,
			"file": self.file,
			"state": self.state,
			"argv": self.argv,
		}

	# -- relay loop ------------------------------------------------------------

	def relay_loop(self, daemon):
		# Owns the master fd: bridge relay to every attached client plus
		# child reaping. Clients share one view: all of them receive the
		# child's output, and any client's input is forwarded to the child
		# (interleaved, like a shared tmux pane). Per-client output buffers
		# keep one slow viewer from stalling the others or the child; a
		# client that falls too far behind loses its bridge instead.
		master = self.master_fd
		pid = self.pid
		name = self.name
		to_master = bytearray()
		dead_input = False
		while True:
			carry_to = self.carry_to
			if carry_to is not None:
				self._transfer_viewers(carry_to)
			try:
				reaped = os.waitpid(pid, os.WNOHANG)
			except ChildProcessError:
				reaped = (pid, 0)
			if reaped[0] == pid:
				break
			clients = self._snapshot()
			rlist = []
			wlist = []
			if not dead_input:
				rlist.append(master)
			if to_master:
				wlist.append(master)
			for c, buf in clients.items():
				rlist.append(c)
				if buf:
					wlist.append(c)
			if not rlist and not wlist:
				# Detached after the master hit EOF: nothing left to
				# poll, so just wait for the child like the reap check
				# above.
				time.sleep(REAP_TICK)
				continue
			try:
				r, w, _ = select.select(rlist, wlist, [], REAP_TICK)
			except OSError:
				# A polled fd vanished; the next iteration re-evaluates.
				continue
			to_master = self._relay_client_input(clients, r, to_master)
			dead_input = self._relay_child_output(clients, r, dead_input)
			if master in w:
				try:
					sent = os.write(master, bytes(to_master[:65536]))
					del to_master[:sent]
				except OSError:
					del to_master[:]
			self._flush_clients(clients, w)
		# Child gone: flush whatever is still buffered per client, drop
		# every bridge, then tear the session down and decide on revival.
		self.close_bridge()
		daemon.drop(self, reaped[1])
		daemon.revive(self, reaped[1])

	def _snapshot(self):
		# Snapshot {socket: outbuf}; the session loop is the only writer
		# of existing entries, control threads only add new ones.
		with self.lock:
			return dict(self.clients)

	def _relay_client_input(self, clients, ready, to_master):
		for c, _buf in clients.items():
			if c not in ready:
				continue
			try:
				data = c.recv(65536)
			except OSError:
				data = b""
			if data:
				to_master += data
				if len(to_master) > MAX_BUF:
					del to_master[: len(to_master) - MAX_BUF]
			else:
				log("client-exit '%s'" % self.name)
				self.drop_and_close(c)
		return to_master

	def _relay_child_output(self, clients, ready, dead_input):
		if self.master_fd not in ready:
			return dead_input
		try:
			data = os.read(self.master_fd, 65536)
		except OSError:
			# EIO is the normal PTY read failure after child exit.
			data = b""
		if data:
			stalled = []
			with self.lock:
				for c, buf in self.clients.items():
					buf.extend(data)
					if len(buf) > MAX_BUF:
						stalled.append(c)
			for c in stalled:
				self.drop_and_close(c)
				log("drop slow client '%s'" % self.name)
		else:
			dead_input = True
			# The child closed its tty (or died without reaping yet);
			# flush and drop the bridges like a single client did.
			self.close_bridge()
		return dead_input

	def _flush_clients(self, clients, ready):
		for c, buf in clients.items():
			if c not in ready:
				continue
			try:
				sent = c.send(bytes(buf[:65536]))
				del buf[:sent]
			except OSError:
				self.drop_and_close(c)

	def _transfer_viewers(self, carry_to):
		# /new + /resume carry: move every bridge viewer to the target
		# session here, between iterations, so exactly one loop ever
		# recvs on a moved socket. Stale old-TUI buffers are dropped;
		# each viewer gets a clear followed by the target TUI's full
		# repaint (nudged below).
		self.carry_to = None
		moved = self.take_clients()
		for client, _buf in moved:
			with carry_to.lock:
				carry_to.clients[client] = bytearray(CLEAR_SEQ)
		rows, cols = self.winsize()
		carry_to.nudge_repaint(cols, rows)
		log("carried '%s' -> '%s' (%d viewers)"
			% (self.name, carry_to.name, len(moved)))


class SessionSpawner:
	"""Fork/exec of hosted pi children onto fresh PTYs."""

	def __init__(self, table, registry, owner=None, shim_dir=None):
		self.table = table
		self.registry = registry
		self.shim_dir = shim_dir
		# owner: the Daemon, injected after construction (the relay loop
		# needs its drop/revive).
		self.owner = owner

	def spawn(self, name, dir_, argv, cols=DEFAULT_COLS, rows=DEFAULT_ROWS,
			  verb="start", registry_argv=None, refuse_if_exists=False):
		master, slave = os.openpty()
		set_winsize(slave, cols, rows)
		pid = os.fork()
		if pid == 0:
			self._exec_child(name, dir_, argv, slave, cols, rows)
		os.close(slave)
		sess = Session(name, dir_, argv, pid, master)
		if not self.table.put(sess, refuse_if_exists=refuse_if_exists):
			# Lost a race for the name: kill and reap our child so
			# nothing is left behind, and leave the existing session
			# untouched.
			try:
				os.kill(pid, signal.SIGTERM)
			except OSError:
				pass
			try:
				os.waitpid(pid, 0)
			except OSError:
				pass
			os.close(master)
			log("%s '%s' skipped: name taken during spawn" % (verb, name))
			return None
		self.registry.add(name, dir_,
						  list(registry_argv) if registry_argv else list(argv))
		log("%s '%s' pid %d in %s" % (verb, name, pid, dir_))
		t = threading.Thread(target=sess.relay_loop, args=(self.owner,),
							 daemon=True)
		t.start()
		return sess

	@staticmethod
	def _write_pi_shim(shim_dir, node_path, front_path, real_pi):
		# A `pi` that launches the front, placed first on hosted children's
		# PATH: every pi resolution inside a hosted session — the session
		# start command, revive/handover spawns, agent delegations, plain
		# `pi` shell calls — lands on the daemon's front, whose argv[1]
		# brings delegation spawns back to the daemon. The shim execs the
		# real pi when node or the front is unusable, so the daemon can
		# never block access to pi. Unhosted contexts never see this PATH
		# and keep resolving the installed wrapper.
		try:
			os.makedirs(shim_dir, exist_ok=True)
			shim = os.path.join(shim_dir, "pi")
			with open(shim, "w") as f:
				f.write(
					"#!/usr/bin/env bash\n"
					"# pi-daemon's hosted-session pi shim: prefer the\n"
					"# daemon's pi front; if the front or node is unusable,\n"
					"# exec the real pi so the daemon can never block\n"
					"# access to pi.\n"
					"front=%s\n"
					"node_bin=%s\n"
					"real_pi=%s\n"
					"if [[ -x \"$node_bin\" && -r \"$front\" ]]; then\n"
					"\texec \"$node_bin\" \"$front\" \"$@\"\n"
					"fi\n"
					"exec \"$real_pi\" \"$@\"\n"
					% (json.dumps(front_path), json.dumps(node_path),
					   json.dumps(real_pi)))
			os.chmod(shim, 0o755)
			return shim_dir
		except OSError as exc:
			log("pi shim setup failed: %s" % exc)
			return None

	def _exec_child(self, name, dir_, argv, slave, cols, rows):
		try:
			os.setsid()
			fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
			os.dup2(slave, 0)
			os.dup2(slave, 1)
			os.dup2(slave, 2)
			# the session's directory is the child's working directory,
			# like the tmux era's new-session -c <dir>
			os.chdir(dir_)
			maxfd = resource.getrlimit(resource.RLIMIT_NOFILE)[0]
			if maxfd == resource.RLIM_INFINITY or maxfd > 65536:
				maxfd = 65536
			os.closerange(3, maxfd)
			env = os.environ.copy()
			env.update({
				"TERM": "xterm-256color",
				"COLORTERM": "truecolor",
				"COLUMNS": str(cols),
				"LINES": str(rows),
				"PI_HOSTED": "1",
				"PI_HOSTED_SESSION": name,
			})
			if self.shim_dir:
				env["PATH"] = (self.shim_dir + os.pathsep
							   + env.get("PATH", ""))
			os.execvpe(argv[0], argv, env)
		except Exception as exc:
			try:
				sys.stderr.write("pi-daemon: exec failed for %s: %s\n" % (name, exc))
			except Exception:
				pass
			os._exit(127)


class Daemon:
	"""The PTY host: session table, takeover policy, control socket."""

	def __init__(self, registry, sock_path=SOCK_PATH):
		self.registry = registry
		self.sock_path = sock_path
		self.table = SessionTable()
		self.ledger = HandoffLedger()
		self.shutdown_event = threading.Event()
		# The pi-compatible front: hosted children get a PATH-shimmed `pi`
		# and offloaded delegation children get the front directly, both
		# only when node, the front entry, and a real-pi fallback are all
		# actually resolvable — the shim and the front must never become a
		# single point of failure for reaching pi.
		self.node_path = shutil.which("node")
		front = AGENT_ENTRY
		self.front_path = front if (self.node_path and front
									and os.path.isfile(front)) else None
		self.real_pi_path = None
		if self.front_path:
			skip = {AGENT_SHIM_DIR,
					os.path.join(os.path.expanduser("~"), ".local", "bin")}
			skip = {os.path.realpath(x) for x in skip}
			for dir_ in os.environ.get("PATH", "").split(os.pathsep):
				if not dir_ or os.path.realpath(dir_) in skip:
					continue
				cand = os.path.join(dir_, "pi")
				if os.path.isfile(cand) and os.access(cand, os.X_OK):
					self.real_pi_path = cand
					break
		shim_dir = None
		if self.front_path and self.real_pi_path:
			shim_dir = SessionSpawner._write_pi_shim(
				AGENT_SHIM_DIR, self.node_path, self.front_path,
				self.real_pi_path)
		self.spawner = SessionSpawner(self.table, registry, owner=self,
									  shim_dir=shim_dir)
		self.tickets = TicketRunner(
			TicketStore(TICKETS_PATH, TICKET_LOG_DIR), self.shutdown_event)
		self.agents = AgentTicketRunner(
			self.tickets.store, self.shutdown_event,
			self.node_path, self.front_path)
		self.control = Control(self)

	# -- control socket ------------------------------------------------------

	def serve(self):
		if os.getuid() == 0:
			log("refusing to run as root")
			return 1
		signal.signal(signal.SIGTERM, _on_signal)
		signal.signal(signal.SIGINT, _on_signal)
		try:
			os.unlink(self.sock_path)
		except FileNotFoundError:
			pass
		except OSError as exc:
			log("cannot unlink stale socket %s: %s" % (self.sock_path, exc))
			return 1
		srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
		try:
			srv.bind(self.sock_path)
			os.chmod(self.sock_path, 0o600)
			srv.listen(16)
		except OSError as exc:
			log("cannot bind %s: %s" % (self.sock_path, exc))
			return 1
		log("listening on %s (registry %s)" % (self.sock_path,
											   self.registry.path))
		self.respawn_from_registry()
		self.tickets.start()
		try:
			self._accept_loop(srv)
		except SystemExit:
			pass
		finally:
			try:
				srv.close()
			except OSError:
				pass
		if not self.shutdown_event.is_set():
			self.shutdown()
		return 0

	def _accept_loop(self, srv):
		while not self.shutdown_event.is_set():
			try:
				conn, _ = srv.accept()
			except OSError as exc:
				if self.shutdown_event.is_set():
					break
				log("accept error: %s" % exc)
				time.sleep(0.1)
				continue
			t = threading.Thread(target=self._conn_thread, args=(conn,),
								 daemon=True)
			t.start()

	def _conn_thread(self, conn):
		handed_off = False
		try:
			conn.settimeout(10)
			reader = LineReader(conn)
			while not self.shutdown_event.is_set():
				try:
					line = reader.readline()
				except (ValueError, OSError):
					break
				if line is None:
					break
				if not line.strip():
					continue
				try:
					req = json.loads(line.decode())
				except (ValueError, UnicodeDecodeError):
					send_json(conn, bad_request())
					continue
				resp = self._dispatch(conn, req)
				if resp is _BRIDGE_HANDOFF:
					handed_off = True
					return
				if resp is not None:
					send_json(conn, resp)
		except Exception as exc:
			if not handed_off:
				log("control connection error: %r" % (exc,))
		finally:
			if not handed_off:
				try:
					conn.close()
				except OSError:
					pass

	def _dispatch(self, conn, req):
		cmd = req.get("cmd")
		if not isinstance(cmd, str):
			return bad_request()
		if cmd == "attach":
			# attach may have already delivered the response itself before
			# installing the client bridge; its second return value says
			# the connection is now the bridge and must not be read or
			# written again.
			resp, became_bridge = self.control.attach(req, conn)
			if resp is not None:
				send_json(conn, resp)
			if became_bridge:
				return _BRIDGE_HANDOFF
			return None
		if cmd == "shutdown":
			return self.control.shutdown(req)
		if cmd in _WIRE_COMMANDS:
			# wire names use dashes; methods use underscores
			return getattr(self.control, cmd.replace("-", "_"))(req)
		return bad_request()

	def shutdown(self):
		if self.shutdown_event.is_set():
			return
		self.shutdown_event.set()
		log("shutdown")
		self.tickets.stop()
		self.agents.stop()
		sessions = self.table.snapshot()
		for sess in sessions:
			try:
				os.killpg(sess.pid, signal.SIGTERM)
			except OSError:
				pass
		deadline = time.time() + KILL_GRACE
		while time.time() < deadline:
			alive = False
			for sess in sessions:
				try:
					if os.waitpid(sess.pid, os.WNOHANG)[0] == 0:
						alive = True
				except ChildProcessError:
					pass
			if not alive:
				break
			time.sleep(0.1)
		for sess in sessions:
			try:
				os.killpg(sess.pid, signal.SIGKILL)
			except OSError:
				pass
		for sess in sessions:
			sess.signal_closed()
			try:
				os.close(sess.master_fd)
			except OSError:
				pass
		self.registry.write({})
		try:
			os.unlink(self.sock_path)
		except OSError:
			pass
		os._exit(0)

	# -- session lifecycle -----------------------------------------------------

	def spawn(self, name, dir_, argv, cols=DEFAULT_COLS, rows=DEFAULT_ROWS,
			  verb="start", registry_argv=None, refuse_if_exists=False):
		return self.spawner.spawn(name, dir_, argv, cols, rows, verb,
								  registry_argv, refuse_if_exists)

	def drop(self, sess, code):
		sess.carry_to = None
		sess.signal_closed()
		try:
			os.close(sess.master_fd)
		except OSError:
			pass
		dropped = self.table.remove_if(sess)
		if dropped is not None:
			self.ledger.repoint_on_drop(dropped)
		self.registry.drop(sess.name)
		log("child-exit '%s' pid %d status %s" % (sess.name, sess.pid, code))

	def revive(self, sess, status):
		# Backgrounding must always happen unless the user ended the
		# session themselves: re-host an abnormally dying pi from its
		# announced session file under the same name. Deliberate quits,
		# explicit stops, daemon shutdown, deleted files, and
		# crash-loop-short lifetimes stay dead.
		if self.shutdown_event.is_set() or sess.stopping:
			return
		if not _exit_abnormal(status):
			return
		if time.time() - sess.spawned_at < MIN_REVIVE_LIFE:
			log("revive '%s' skipped: lived under %ss"
				% (sess.name, MIN_REVIVE_LIFE))
			return
		file = sess.file
		if not file or not os.path.isfile(file):
			log("revive '%s' skipped: no session file" % sess.name)
			return
		if self.table.get(sess.name) is not None:
			return
		try:
			spawned = self.spawn(sess.name, sess.dir,
								 ["pi", "--session", file], verb="revive",
								 refuse_if_exists=True)
		except OSError as exc:
			log("revive '%s' failed: %s" % (sess.name, exc))
			return
		if spawned is None:
			log("revive '%s' skipped: name taken during revive" % sess.name)

	def respawn_from_registry(self):
		data = self.registry.load()
		for name, rec in sorted(data.items()):
			try:
				dir_ = rec["dir"]
				argv = rec["argv"]
				if not (isinstance(dir_, str) and isinstance(argv, list)
						and argv):
					raise ValueError("bad record")
				self.spawn(name, dir_, argv, verb="respawn")
			except Exception as exc:
				log("respawn '%s' failed: %s" % (name, exc))
				self.registry.drop(name)

	# -- takeover + carry policy -----------------------------------------------

	def carry_target_name(self, base, exclude):
		# Unique carry/relay target name: "<base>-<hash>", collision-
		# checked against live sessions (a refuse_if_exists backstop
		# covers races).
		for attempt in range(8):
			suffix = hashlib.sha256(
				("%d-%d-%d" % (time.time_ns(), os.getpid(), attempt)).encode()
			).hexdigest()[:4]
			candidate = "pi-%s-%s" % (base, suffix)
			if candidate != exclude and self.table.get(candidate) is None:
				return candidate
		return None

	def begin_carry(self, sess, target, verb):
		# Record the viewer handoff on the source session loop (it
		# performs the move at its next iteration boundary): two loops
		# recv()ing on one socket would split the viewer's input between
		# the two TUIs. Returns False when the source died before the
		# handoff could be recorded.
		with self.table.lock:
			if self.table.get(sess.name) is not sess:
				return False
			sess.carry_to = target
		log("%s '%s' -> '%s'" % (verb, sess.name, target.name))
		return True

	def handover_target(self, dir_, file):
		# Mirrors pi-rc's session_for/handover_name target logic.
		base = os.path.basename(dir_)
		base = base.replace(":", "_")
		if base.startswith("="):
			base = base[1:]
		primary = "pi-" + base
		holder = self.table.get(primary)
		if holder is None or holder.holds_dir(dir_):
			return primary
		digest = hashlib.sha256(file.encode()).hexdigest()[:6]
		return "pi-%s-%s" % (base, digest)

	def handover_thread(self, target, dir_, file, after_pid, message=None):
		# Wait for the handing-over pi to exit, then host its session file.
		if after_pid:
			while not self.shutdown_event.is_set():
				try:
					os.kill(after_pid, 0)
				except OSError:
					break
				time.sleep(0.2)
			time.sleep(0.5)
		if self.shutdown_event.is_set():
			return
		if not os.path.isfile(file):
			log("handover '%s' skipped: session file gone: %s" % (target, file))
			return
		if self.table.get(target) is not None:
			log("handover '%s' skipped: name already hosted" % target)
			return
		argv = ["pi", "--session", file]
		registry_argv = list(argv)
		if message:
			# Legacy hook kept for protocol compatibility; the
			# daemon extension no longer sends a continuation
			# prompt, so hosted handovers start idle at the prompt.
			argv.append(message)
		try:
			spawned = self.spawn(target, dir_, argv, verb="handover",
								 registry_argv=registry_argv,
								 refuse_if_exists=True)
		except OSError as exc:
			log("handover '%s' failed: %s" % (target, exc))
			return
		if spawned is None:
			log("handover '%s' skipped: name taken during handover" % target)

	def resolve_takeover(self, sess, others):
		# A second live pi on one conversation can only diverge. The
		# announcing session is the one the user is actively looking at,
		# so it never shuts down while every holder is merely idle at the
		# prompt: it absorbs them instead, and each of their viewers
		# follows here. Only a busy holder wins — never touch a working
		# agent; the announcer yields to it and shuts down. Holders
		# already handing off are neither followed nor absorbed. Returns
		# (handoff, took_over names).
		busy = [s for s in others
				if (s.state == "busy" or s.absorbing_until > time.time())
				and not self.ledger.pending(s.name)]
		if busy:
			busy.sort(key=lambda s: s.count_clients() == 0)
			target = busy[0]
			self.ledger.record(sess.name, target.name)
			sess.signal_closed()
			log("handoff '%s' -> '%s'" % (sess.name, target.name))
			return {"name": target.name, "state": target.state}, []
		# A concurrent announce must yield to an in-flight absorption
		# instead of absorbing the absorber.
		sess.absorbing_until = time.time() + ABSORB_GUARD
		took_over = []
		for holder in others:
			if self.ledger.pending(holder.name):
				continue
			# Record before the first signal so the holder's viewers
			# follow here, a concurrent announce sees it as already
			# absorbed, and an abnormal death in the settle window never
			# revives it.
			self.ledger.record(holder.name, sess.name)
			holder.stopping = True
			took_over.append(holder.name)
			threading.Thread(target=self.absorb_session,
							 args=(holder, sess.name), daemon=True).start()
			log("took-over '%s' <- '%s'" % (holder.name, sess.name))
		return None, took_over

	def absorb_session(self, holder, announcer):
		# Kill an absorbed idle holder — but only after a short settle
		# that rechecks the best-effort run state: a holder whose turn
		# just started (state publish still in flight) must not be killed
		# mid-turn.
		time.sleep(ABSORB_SETTLE)
		with self.table.lock:
			if holder.state != "busy":
				holder.terminate()
				return
			# The holder started working during the settle: it wins
			# instead. Never kill a working agent — and never kill the
			# announcer while it is working either; if both sides started
			# within the window, sparing both leaves a divergence, but
			# aborting a working agent is worse. One yield wins; later
			# busy holders are only spared.
			holder.stopping = False
			self.ledger.pop(holder.name)
			sess = self.table.get(announcer)
			if sess is None:
				return
			sess.absorbing_until = 0
			if sess.yielded_to is not None:
				log("absorb spare '%s': announcer '%s' already yielded"
					% (holder.name, announcer))
				return
			if sess.state == "busy":
				log("absorb aborted '%s' vs busy '%s': both working, left alone"
					% (announcer, holder.name))
				return
			sess.yielded_to = holder.name
			self.ledger.record(announcer, holder.name)
			sess.signal_closed()
			log("absorb yield '%s' -> busy '%s'" % (announcer, holder.name))
			threading.Thread(target=sess.terminate, daemon=True).start()


class Control:
	"""One method per wire command; every handler returns the response
	dict, except attach which may hand the connection to the bridge."""

	def __init__(self, daemon):
		self.daemon = daemon

	def ping(self, _req):
		return {"ok": True}

	def start(self, req):
		name = req.get("name")
		dir_ = req.get("dir")
		argv = req.get("argv")
		try:
			cols = int(req.get("cols", DEFAULT_COLS))
			rows = int(req.get("rows", DEFAULT_ROWS))
		except (TypeError, ValueError):
			return bad_request()
		if not (isinstance(name, str) and name and isinstance(dir_, str)
				and isinstance(argv, list) and argv
				and all(isinstance(a, str) for a in argv)):
			return bad_request()
		if not os.path.isdir(dir_):
			return err("no-dir")
		if self.daemon.table.get(name) is not None:
			return {"ok": True, "name": name, "created": False}
		try:
			self.daemon.spawn(name, dir_, argv, cols, rows)
		except OSError as exc:
			log("start '%s' failed: %s" % (name, exc))
			return err("spawn-failed")
		return {"ok": True, "name": name, "created": True}

	def attach(self, req, conn):
		name = req.get("name")
		try:
			cols = int(req.get("cols", DEFAULT_COLS))
			rows = int(req.get("rows", DEFAULT_ROWS))
		except (TypeError, ValueError):
			return bad_request(), False
		if not (isinstance(name, str) and name):
			return bad_request(), False
		table = self.daemon.table
		with table.lock:
			sess = table.get(name)
			follow = self.daemon.ledger.follow(name, table)
		if sess is None:
			if follow is None:
				return err("no-session"), False
			# The duplicate already shut down, but its handoff survives: a
			# late viewer follows it instead of recreating the duplicate.
			send_json(conn, {"ok": True, "name": name, "state": follow["state"],
							 "clients": 0, "handoff": follow})
			log("attach '%s' -> handoff '%s' (session gone)"
				% (name, follow["name"]))
			return None, False
		if follow is not None:
			# This duplicate already handed its viewers to a live holder
			# (resume takeover): reply with the handoff instead of
			# installing a bridge that would die the moment the duplicate
			# shuts down.
			send_json(conn, {"ok": True, "name": name,
							 "state": sess.state,
							 "clients": sess.count_clients(),
							 "handoff": follow})
			log("attach '%s' -> handoff '%s'" % (name, follow["name"]))
			return None, False
		# The attach response must reach the client BEFORE the connection
		# becomes a live bridge: install_client() starts relaying pi's
		# output on this socket immediately, and response bytes
		# interleaved with stream output made pi-rc read a non-JSON line
		# ("attach failed: no response"). Send the response first; the
		# client then enters bridge mode, and only after that do we
		# install the client and force the repaint.
		nclients = sess.count_clients() + 1
		send_json(conn, {"ok": True, "name": name, "state": sess.state,
						 "clients": nclients})
		conn.setblocking(False)
		sess.install_client(conn)
		if nclients > 1:
			# Multiple terminals share this session: every viewer sees the
			# same output and any of them can type into the child.
			log("attach '%s' %dx%d (%d clients)" % (name, cols, rows, nclients))
		else:
			log("attach '%s' %dx%d" % (name, cols, rows))
		sess.nudge_repaint(cols, rows)
		# Response already sent above; tell conn_thread the connection is
		# now the bridge and must not be read or written again.
		return None, True

	def detach(self, req):
		name = req.get("name")
		if not isinstance(name, str):
			return bad_request()
		sess = self.daemon.table.get(name)
		if sess is None:
			# A detach of an unknown session must not report ok: callers
			# use the response to decide whether the user's terminal was
			# handed back, and a silent ok hid a name-mangling bug for a
			# day.
			return err("no-session")
		if sess.count_clients() > 0:
			log("detach '%s'" % name)
			sess.signal_closed()
		return {"ok": True}

	def resize(self, req):
		name = req.get("name")
		try:
			cols = int(req.get("cols"))
			rows = int(req.get("rows"))
		except (TypeError, ValueError):
			return bad_request()
		if not isinstance(name, str):
			return bad_request()
		sess = self.daemon.table.get(name)
		if sess is None:
			return err("no-session")
		try:
			sess.resize(cols, rows)
		except OSError:
			pass
		return {"ok": True}

	def list(self, _req):
		sessions = [s.view() for s in self.daemon.table.snapshot()]
		return {"ok": True, "sessions": sessions}

	def which(self, req):
		file = req.get("file")
		if not (isinstance(file, str) and file):
			return bad_request()
		with self.daemon.table.lock:
			holders = self.daemon.table.holders_of(file)
		# First match, preserving the historical exact-pass-wins-then-argv
		# order; pi-rc whichall exposes every holder.
		return {"ok": True, "name": holders[0].name if holders else None}

	def whichall(self, req):
		file = req.get("file")
		if not (isinstance(file, str) and file):
			return bad_request()
		with self.daemon.table.lock:
			holders = self.daemon.table.holders_of(file)
		return {"ok": True,
				"names": [{"name": s.name, "state": s.state}
						  for s in holders]}

	def state(self, req):
		name = req.get("name")
		state = req.get("state")
		if not (isinstance(name, str) and name) or state not in ("busy", "idle"):
			return bad_request()
		sess = self.daemon.table.get(name)
		if sess is None:
			return err("no-session")
		sess.state = state
		return {"ok": True}

	def stop(self, req):
		name = req.get("name")
		if not isinstance(name, str):
			return bad_request()
		sess = self.daemon.table.get(name)
		if sess is not None:
			t = threading.Thread(target=sess.terminate, daemon=True)
			t.start()
		# The session thread drops the entry once the reap lands.
		return {"ok": True}

	def handover(self, req):
		file = req.get("file")
		dir_ = req.get("dir")
		after_pid = req.get("afterPid")
		message = req.get("message")  # legacy; unused by the current client
		if not (isinstance(file, str) and file and isinstance(dir_, str) and dir_):
			return bad_request()
		if after_pid is not None and not isinstance(after_pid, int):
			return bad_request()
		if message is not None and not (isinstance(message, str)
									   and 0 < len(message) <= 8192):
			return bad_request()
		if not os.path.isdir(dir_):
			return err("no-dir")
		target = self.daemon.handover_target(dir_, file)
		holder = self.daemon.table.get(target)
		if holder is not None and not holder.holds_dir(dir_):
			# Held by a session resuming this exact file already.
			log("handover '%s' already hosted" % target)
			return {"ok": True, "verdict": "hosted:%s" % target}
		t = threading.Thread(
			target=self.daemon.handover_thread,
			args=(target, dir_, file, after_pid, message),
			daemon=True)
		t.start()
		return {"ok": True, "verdict": "target:%s" % target}

	def carry(self, req):
		# /new without termination: spawn a fresh hosted session and move
		# this session's bridge viewers onto it, leaving this pi running
		# headless with its own conversation (the extension cancels pi's
		# in-process switch, which would abort an in-flight turn). With
		# "to", an existing session receives the viewers instead.
		name = req.get("name")
		if not isinstance(name, str) or not name:
			return bad_request()
		argv = req.get("argv")
		if argv is not None and not (isinstance(argv, list) and argv
									and all(isinstance(a, str) for a in argv)):
			return bad_request()
		to_name = req.get("to")
		if to_name is not None and not isinstance(to_name, str):
			return bad_request()
		table = self.daemon.table
		with table.lock:
			sess = table.get(name)
			if sess is None:
				return err("no-session")
			dir_ = sess.dir
			rows, cols = sess.winsize()
			target = None
			new_name = None
			if to_name is not None:
				if to_name == name:
					return err("no-session")
				target = table.get(to_name)
				if target is None:
					return err("no-session")
			else:
				new_name = self.daemon.carry_target_name(_dir_base(dir_),
														 name)
				if new_name is None:
					return err("no-free-name")
		spawned = None
		if target is None:
			try:
				spawned = self.daemon.spawn(new_name, dir_, argv or ["pi"],
											cols, rows, verb="carry",
											refuse_if_exists=True)
			except OSError as exc:
				log("carry '%s' failed: %s" % (name, exc))
				return err("spawn-failed")
			if spawned is None:
				return err("name-taken")
			target = spawned
		if self.daemon.begin_carry(sess, target, "carry"):
			return {"ok": True, "name": target.name}
		# The source died between spawn and move: drop a freshly spawned
		# session rather than leave an unviewed pi behind.
		if spawned is not None:
			threading.Thread(target=spawned.terminate, daemon=True).start()
		return err("no-session")

	def resume(self, req):
		# /resume without termination: resolve the picked conversation to
		# its live holder when one exists (a busy one first — never touch
		# a working agent, just move this terminal's viewers there),
		# otherwise spawn a fresh session resuming the file, then move the
		# viewers. The source session keeps running headless with its own
		# conversation; the extension cancels pi's in-process switch.
		name = req.get("name")
		file = req.get("file")
		if not (isinstance(name, str) and name and isinstance(file, str)
				and file and os.path.isabs(file)):
			return bad_request()
		if not os.path.isfile(file):
			return err("no-file")
		table = self.daemon.table
		with table.lock:
			sess = table.get(name)
			if sess is None:
				return err("no-session")
			rows, cols = sess.winsize()
			holders = [s for s in table.holders_of(file)
					   if s is not sess
					   and not self.daemon.ledger.pending(s.name)]
			target = None
			new_name = None
			if holders:
				holders.sort(key=lambda s: (s.state != "busy",
											s.count_clients() == 0))
				target = holders[0]
			else:
				base = _dir_base(sess.dir)
				digest = hashlib.sha256(file.encode()).hexdigest()[:6]
				new_name = self.daemon.carry_target_name(
					"%s-%s" % (base, digest), name)
				if new_name is None:
					return err("no-free-name")
		spawned = None
		if target is None:
			try:
				spawned = self.daemon.spawn(new_name, sess.dir,
											["pi", "--session", file],
											cols, rows, verb="resume",
											refuse_if_exists=True)
			except OSError as exc:
				log("resume '%s' failed: %s" % (name, exc))
				return err("spawn-failed")
			if spawned is None:
				return err("name-taken")
			target = spawned
		if self.daemon.begin_carry(sess, target, "resume"):
			return {"ok": True, "name": target.name}
		# The source died between spawn and move: drop a freshly spawned
		# session rather than leave an unviewed pi behind.
		if spawned is not None:
			threading.Thread(target=spawned.terminate, daemon=True).start()
		return err("no-session")

	def announce(self, req):
		name = req.get("name")
		file = req.get("file")
		if not (isinstance(name, str) and name and isinstance(file, str)
				and file and os.path.isabs(file)):
			return bad_request()
		table = self.daemon.table
		with table.lock:
			sess = table.get(name)
			if sess is None:
				return err("no-session")
			sess.file = file
			# Surface other live holders of the same conversation so the
			# extension can warn about a picker-opened duplicate
			# immediately.
			others = [s for s in table.holders_of(file) if s is not sess]
			also = [{"name": s.name, "state": s.state}
					for s in others
					if not (req.get("takeover")
							and self.daemon.ledger.pending(s.name))]
			handoff = None
			took_over = []
			if req.get("takeover") and others:
				handoff, took_over = self.daemon.resolve_takeover(
					sess, others)
		self.daemon.registry.set_argv(name, ["pi", "--session", file])
		log("announce '%s' -> %s" % (name, file))
		return {"ok": True, "alsoLive": also, "handoff": handoff,
				"tookOver": took_over}

	def handoff_target(self, req):
		name = req.get("name")
		if not (isinstance(name, str) and name):
			return bad_request()
		with self.daemon.table.lock:
			target = self.daemon.ledger.follow(name, self.daemon.table)
		return {"ok": True, "target": target}

	# -- command offloading (tickets) -------------------------------------

	def ticket_submit(self, req):
		session = req.get("session")
		dir_ = req.get("cwd")
		command = req.get("command")
		env = req.get("env")
		if not (isinstance(session, str) and session
				and isinstance(dir_, str) and os.path.isabs(dir_)
				and os.path.isdir(dir_)
				and isinstance(command, str) and command):
			return bad_request()
		if env is not None and not (isinstance(env, dict)
									and all(isinstance(k, str) and isinstance(v, str)
										for k, v in env.items())):
			return bad_request()
		if self.daemon.tickets.running_count() >= TICKET_MAX_RUNNING:
			return err("too-busy")
		try:
			rec = self.daemon.tickets.submit(session, dir_, command, env)
		except OSError as exc:
			log("ticket-submit failed: %s" % exc)
			return err("spawn-failed")
		if rec is None:
			return err("too-busy")
		return {"ok": True, "id": rec["id"], "ticket": rec}

	def ticket_wait(self, req):
		tid = req.get("id")
		try:
			timeout = float(req.get("timeout", 0))
		except (TypeError, ValueError):
			return bad_request()
		if not (isinstance(tid, str) and tid) or timeout < 0:
			return bad_request()
		rec = self.daemon.tickets.wait(tid, timeout)
		if rec is None:
			return err("no-ticket")
		return {"ok": True, "ticket": rec}

	def ticket_output(self, req):
		tid = req.get("id")
		try:
			offset = int(req.get("offset", 0))
		except (TypeError, ValueError):
			return bad_request()
		if not (isinstance(tid, str) and tid) or offset < 0:
			return bad_request()
		out = self.daemon.tickets.output(tid, offset)
		if out is None:
			return err("no-ticket")
		return {"ok": True, "offset": out["offset"], "next": out["next"],
				"size": out["size"],
				"data": base64.b64encode(out["data"]).decode()}

	def ticket_list(self, req):
		session = req.get("session")
		if session is not None and not isinstance(session, str):
			return bad_request()
		kind = req.get("kind")
		if kind is not None and kind not in ("shell", "agent"):
			return bad_request()
		return {"ok": True,
				"tickets": self.daemon.tickets.store.snapshot(session, kind)}

	def ticket_cancel(self, req):
		tid = req.get("id")
		if not (isinstance(tid, str) and tid):
			return bad_request()
		rec = self.daemon.tickets.store.get(tid)
		if rec is None:
			return err("no-ticket")
		runner = (self.daemon.agents if rec.get("kind") == "agent"
				  else self.daemon.tickets)
		rec = runner.cancel(tid)
		if rec is None:
			return err("no-ticket")
		return {"ok": True, "ticket": rec}

	def ticket_remove(self, req):
		# Drop a finished ticket from the store and disk; running tickets
		# must be cancelled first.
		tid = req.get("id")
		if not (isinstance(tid, str) and tid):
			return bad_request()
		try:
			rec = self.daemon.tickets.store.remove(tid)
		except ValueError:
			return err("running")
		if rec is None:
			return err("no-ticket")
		return {"ok": True, "removed": tid}

	def tickets_reset(self, _req):
		# Kill the ticketing service state for a reset: cancel every
		# running ticket (shell and agent), wipe the persisted store and
		# every artifact, restart the id counter. Hosted sessions and the
		# rest of the daemon are untouched; a full stop remains
		# `shutdown` / pi-rc daemon-stop.
		cancelled = 0
		for rec in self.daemon.tickets.store.snapshot():
			if rec.get("status") != "running":
				continue
			runner = (self.daemon.agents if rec.get("kind") == "agent"
					  else self.daemon.tickets)
			runner.cancel(rec["id"])
			cancelled += 1
		removed = self.daemon.tickets.store.reset()
		log("tickets-reset: cancelled %d, removed %d" % (cancelled, removed))
		return {"ok": True, "cancelled": cancelled, "removed": removed}

	# -- agent tickets (headless subagent delegations) ---------------------

	def agent_submit(self, req):
		session = req.get("session")
		dir_ = req.get("cwd")
		pi_path = req.get("pi")
		args = req.get("args")
		env = req.get("env")
		max_turns = req.get("max_turns")
		if not (isinstance(session, str) and session
				and isinstance(dir_, str) and os.path.isabs(dir_)
				and os.path.isdir(dir_)
				and isinstance(pi_path, str) and pi_path
				and isinstance(args, list) and args
				and all(isinstance(a, str) for a in args)):
			return bad_request()
		if env is not None and not (isinstance(env, dict)
									and all(isinstance(k, str) and isinstance(v, str)
										for k, v in env.items())):
			return bad_request()
		if max_turns is not None \
				and not (isinstance(max_turns, int) and max_turns > 0):
			return bad_request()
		if self.daemon.agents.running_count() >= AGENT_MAX_RUNNING:
			return err("too-busy")
		try:
			rec = self.daemon.agents.submit(session, dir_, pi_path, args,
											env, max_turns)
		except OSError as exc:
			log("agent-submit failed: %s" % exc)
			return err("spawn-failed")
		if rec is None:
			return err("too-busy")
		return {"ok": True, "id": rec["id"], "ticket": rec}

	def agent_wait(self, req):
		tid = req.get("id")
		try:
			timeout = float(req.get("timeout", 0))
		except (TypeError, ValueError):
			return bad_request()
		if not (isinstance(tid, str) and tid) or timeout < 0:
			return bad_request()
		rec = self.daemon.agents.wait(tid, timeout)
		if rec is None:
			return err("no-ticket")
		return {"ok": True, "ticket": rec}

	def agent_output(self, req):
		tid = req.get("id")
		try:
			out_offset = int(req.get("offset", 0))
			err_offset = int(req.get("err_offset", 0))
		except (TypeError, ValueError):
			return bad_request()
		if not (isinstance(tid, str) and tid) or out_offset < 0 or err_offset < 0:
			return bad_request()
		out = self.daemon.agents.output(tid, out_offset, err_offset)
		if out is None:
			return err("no-ticket")
		return {"ok": True, "ticket": self.daemon.agents.store.get(tid),
				"out_next": out["out"][1], "out_size": out["out"][2],
				"out": base64.b64encode(out["out"][3]).decode(),
				"err_next": out["err"][1], "err_size": out["err"][2],
				"err": base64.b64encode(out["err"][3]).decode()}

	def agent_cancel(self, req):
		tid = req.get("id")
		if not (isinstance(tid, str) and tid):
			return bad_request()
		rec = self.daemon.agents.cancel(tid)
		if rec is None:
			return err("no-ticket")
		return {"ok": True, "ticket": rec}

	def shutdown(self, _req):
		t = threading.Thread(target=self.daemon.shutdown, daemon=True)
		t.start()
		return {"ok": True}


def _dir_base(dir_):
	# Mirrors handover_target's name base handling.
	base = os.path.basename(dir_).replace(":", "_")
	if base.startswith("="):
		base = base[1:]
	return base


# Sentinel returned by the attach dispatch: the connection is now a raw
# bridge and the connection thread must not touch it again.
_BRIDGE_HANDOFF = object()


def main():
	daemon = Daemon(Registry(REG_PATH))
	return daemon.serve()


if __name__ == "__main__":
	sys.exit(main())
