#!/usr/bin/env bash
# pi — auto-hosting wrapper installed by pi-daemon.
#
# Every interactive `pi` call creates its OWN new hosted session through
# pi-rc (`attach --new`): a fresh conversation under a unique session
# name, attached to this terminal. Nothing is resumed implicitly — pass
# --resume / --continue to pi explicitly when an old conversation is
# wanted (they ride along into the hosted session as its pi args).
# Hosted sessions survive terminal exit, SSH logout, and reboot, and the
# daemon revives one headless from its session file if the pi process
# ever dies abnormally; only a clean quit (Ctrl+D) or deleting the
# session ends one for good.
#
# The PI_HOSTED guard keeps hosted subagent/worker sessions and nested
# starts out of the way: anything running inside the daemon already
# carries PI_HOSTED and execs the real pi untouched. One-shot invocations
# (-p/--print, --no-session) and help/version stay direct, non-tty stdin
# passes through, and if pi-rc is missing or the service is not running
# (attach exits nonzero) the wrapper degrades to the real pi so a bare
# start always works (unhosted; /bg then offers a handover).
#
# REAL_PI is rewritten to the actual pi binary at install time.
#
# Resume guard: backgrounding is solely a /bg feature, so a `pi --resume`,
# `--continue` (-c), or `--session` call must never open a conversation a
# live hosted session already has (pi has no cross-process session locking;
# two processes on one session file silently diverge). For --continue and
# --session the target file is resolved WITHOUT spawning pi and checked
# against the daemon (`pi-rc which <file>`); a live holder means the
# wrapper ATTACHES to it instead (entering an active session is not an
# interruption — only explicit user actions, such as the detach key, ever
# touch the running model). `--resume` is an interactive picker, so its
# target is only known after pi opens: the wrapper attaches when every
# live hosted session in this directory backs ONE distinct conversation
# (several terminals may share it), and otherwise warns that the picker
# may duplicate a live session and degrades open — daemon's
# post-resume notice then points at the live holder. An unreachable
# daemon, an unresolvable target, or no match degrades open: the call
# proceeds exactly as before. If the attach itself fails (e.g. the
# session died between check and attach), the wrapper degrades open with
# the original args rather than leaving the user stranded. Plain `pi`
# starts are unaffected.
set -euo pipefail

REAL_PI="@REAL_PI@"
PI_RC="$HOME/.local/bin/pi-rc"

# Attach to a live hosted session backing the requested resume target:
# print a one-line notice, then hand the TUI to the attach bridge, whose
# clean detach (Ctrl-\) ends the wrapper with exit 0. On failure (e.g.
# the session died between check and attach) return nonzero so the caller
# degrades open with the original args instead of stranding the user.
guard_attach() {
	printf 'attaching to active session %s...\n' "$1" >&2
	if "$PI_RC" attach "$1"; then
		exit 0
	fi
	return 1
}

# Resolve a conversation file without spawning pi. $1 = mode
# (continue|session), $2 = the --session argument (unused for continue).
# Prints the absolute session file, or nothing when the target cannot be
# determined outside pi (findMostRecentSession comes from pi's own
# session-manager.js, located by walking up from the real pi binary).
guard_resolve_file() {
	node --input-type=module -e '
import { closeSync, openSync, readdirSync, readSync, realpathSync, statSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { homedir } from "node:os";
import { pathToFileURL } from "node:url";
const [mode, arg, cwd] = process.argv.slice(2);
let dir = dirname(realpathSync(process.argv[1])), sm = null;
for (let i = 0; i < 8 && dir !== dirname(dir); i++) {
	try { sm = join(dir, "dist", "core", "session-manager.js"); statSync(sm); break; }
	catch { sm = null; dir = dirname(dir); }
}
if (!sm) process.exit(0);
const { findMostRecentSession } = await import(pathToFileURL(sm).href);
// Mirror pi getDefaultSessionDirPath (default agent dir, cwd-encoded name)
// without its mkdir side effect: nothing to continue when the dir is absent.
const agentDir = process.env.PI_CODING_AGENT_DIR
	|| join(homedir(), ".pi", "agent");
const safe = "--" + cwd.replace(/^[/\\]/, "").replace(/[/\\:]/g, "-") + "--";
const sessionDir = join(agentDir, "sessions", safe);
let file = null;
if (mode === "continue") {
	file = findMostRecentSession(sessionDir, cwd);
} else if (arg.includes("/") || arg.includes("\\") || arg.endsWith(".jsonl")) {
	file = resolve(cwd, arg);
} else {
	// Partial-UUID match, like pi resolveSessionPath: exact id first, then
	// an id prefix, scanned from each file session header line.
	const headerId = (path) => {
		try {
			const fd = openSync(path, "r");
			const buf = Buffer.alloc(65536);
			const n = readSync(fd, buf, 0, 65536, 0);
			closeSync(fd);
			const head = JSON.parse(buf.toString("utf8", 0, n).split("\n", 1)[0]);
			return head && typeof head.id === "string" ? head.id : null;
		} catch { return null; }
	};
	try {
		for (const f of readdirSync(sessionDir).filter((f) => f.endsWith(".jsonl"))) {
			const id = headerId(join(sessionDir, f));
			if (id === arg) { file = join(sessionDir, f); break; }
			if (!file && id !== null && id.startsWith(arg)) file = join(sessionDir, f);
		}
	} catch { file = null; }
}
process.stdout.write(file || "");
' "$REAL_PI" "$1" "$2" "$(pwd -P)" 2>/dev/null || true
}

# Guard entry: attach when the requested resume flags target a live hosted
# session (return nonzero if that attach fails); return (proceed as today)
# in every other case.
guard_check() {
	local -a args=("$@")
	local i arg mode="" value
	for (( i = 0; i < ${#args[@]}; i++ )); do
		arg=${args[i]}
		case "$arg" in
			--) return 0 ;;  # everything after -- is a message, not a flag
			--resume|-r) mode=resume; break ;;
			--continue|-c) mode=continue; break ;;
			--session)
				if (( i + 1 < ${#args[@]} )); then
					mode=session; value=${args[i + 1]}; break
				fi
				return 0 ;;  # pi would error on the missing value anyway
			esac
	done
	[[ -n $mode ]] || return 0
	if [[ $mode == resume ]]; then
		# An interactive picker cannot be resolved without spawning pi.
		# Attach when every live hosted session in this directory backs
		# ONE distinct conversation (several terminals may share it);
		# otherwise warn that the picker may duplicate a live session and
		# degrade open — daemon's post-resume notice catches that.
		local -a names=() files=() states=()
		local name dir _pid _marker state file
		while IFS=$'\t' read -r name dir _pid _marker state file; do
			[[ $dir == "$(pwd -P)" ]] || continue
			if [[ -z $file || $file == "-" ]]; then
				file="-"
			fi
			names+=("$name"); files+=("$file"); states+=("$state")
		done < <("$PI_RC" ls 2>/dev/null)
		if (( ${#names[@]} == 1 )); then
			guard_attach "${names[0]}" || return 1
			return 0
		fi
		if (( ${#names[@]} > 1 )); then
			local -a known=()
			for file in "${files[@]}"; do
				[[ $file != "-" ]] && known+=("$file")
			done
			if (( ${#known[@]} == ${#names[@]} )) \
				&& (( $(printf '%s\n' "${known[@]}" | sort -u | wc -l) == 1 )); then
				# Several views of one conversation: attach to the first.
				guard_attach "${names[0]}" || return 1
				return 0
			fi
			# Ambiguous picker target: warn (with state) and degrade open.
			printf 'pi: %d live hosted sessions in this directory; the resume picker may open a conversation that is already live:\n' "${#names[@]}" >&2
			local i
			for i in "${!names[@]}"; do
				printf '  %s\t%s\t%s\n' "${names[i]}" "${states[i]}" "${files[i]}" >&2
			done
		fi
		return 0
	fi
	local target
	target=$(guard_resolve_file "$mode" "${value:-}")
	[[ -n $target ]] || return 0
	local live
	live=$("$PI_RC" which "$target" 2>/dev/null) || return 0
	if [[ -n $live ]]; then
		guard_attach "$live" || return 1
	fi
	return 0
}

# Resolve the daemon-owned session for a plain start: the daemon owns
# one live session per directory's latest conversation, and terminals
# are interchangeable viewports of it, so plain `pi` attaches to that
# session (busy first — watching a working session never disturbs it)
# instead of spawning a duplicate. `pi --new` keeps the old behavior:
# a fresh conversation in its own new session. Candidates must back a
# real conversation (a session file on record) so --no-session children
# — subagent workers share the directory in the listing — are never
# attached. Prints the chosen name, or nothing when a fresh start is
# wanted (no candidates, or candidates whose files all vanished).
owned_session() {
	local name dir _pid _marker state file newest="" newest_file="" f
	while IFS=$'\t' read -r name dir _pid _marker state file; do
		[[ $dir == "$(pwd -P)" && -n $file && $file != "-" ]] || continue
		[[ -f $file ]] || continue
		f=$(stat -c %Y -- "$file" 2>/dev/null) || continue
		if [[ -z $newest_file || $f -gt $newest_file \
			|| ( $f -eq $newest_file && $state == busy ) ]]; then
			newest=$name; newest_file=$f
		fi
	done < <("$PI_RC" ls 2>/dev/null)
	printf '%s' "$newest"
}

# A wrapper-level flag, not a pi flag: force a fresh conversation in a
# new hosted session. Anything before -- that is exactly --new is
# consumed here; everything else rides through to pi untouched.
force_new=0
args=()
for arg in "$@"; do
	if [[ $force_new -eq 0 && $arg == --new ]]; then
		force_new=1
	else
		args+=("$arg")
	fi
done

if [[ -t 0 && -z "${PI_HOSTED:-}" && -x "$PI_RC" ]]; then
	direct=0
	for arg in "${args[@]}"; do
		case "$arg" in
			-p|--print|--no-session|-h|--help|-v|--version) direct=1; break ;;
		esac
	done
	if [[ $direct -eq 0 ]]; then
		if ! guard_check "${args[@]}"; then
			# Guard attach failed (session died between check and attach):
			# degrade open with the original args so the call still works.
			exec "$REAL_PI" "${args[@]}"
		fi
		if [[ $force_new -eq 0 ]]; then
			owned=$(owned_session)
			if [[ -n $owned ]]; then
				printf 'pi: attaching to the daemon-owned session %s (pi --new starts a fresh conversation)\n' "$owned" >&2
				if "$PI_RC" attach "$owned"; then
					exit 0
				fi
				# The session died between check and attach: fall through to
				# a fresh start instead of stranding the user.
			fi
		fi
		"$PI_RC" attach --new -- "${args[@]}" && exit 0
		# Attach failed (service down, or the bridge refused): degrade to
		# the real pi so a start always works.
		exec "$REAL_PI" "${args[@]}"
	fi
fi

exec "$REAL_PI" "${args[@]}"
