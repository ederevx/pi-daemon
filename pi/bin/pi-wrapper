#!/usr/bin/env bash
# pi — auto-hosting wrapper installed by pi-background-service.
#
# Every interactive `pi` call creates its OWN new hosted session through
# pi-rc (`attach --new`): a fresh conversation under a unique session
# name, attached to this terminal. Nothing is resumed implicitly — pass
# --resume / --continue to pi explicitly when an old conversation is
# wanted (they ride along into the hosted session as its pi args).
# Hosted sessions survive terminal exit, SSH logout, and reboot, and the
# daemon revives one headless from its session file if the pi process
# ever dies abnormally; only a clean quit (Ctrl+D) or deleting the
# session ends one for good.
#
# The PI_HOSTED guard keeps hosted subagent/worker sessions and nested
# starts out of the way: anything running inside the daemon already
# carries PI_HOSTED and execs the real pi untouched. One-shot invocations
# (-p/--print, --no-session) and help/version stay direct, non-tty stdin
# passes through, and if pi-rc is missing or the service is not running
# (attach exits nonzero) the wrapper degrades to the real pi so a bare
# start always works (unhosted; /bg then offers a handover).
#
# REAL_PI is rewritten to the actual pi binary at install time.
set -euo pipefail

REAL_PI="@REAL_PI@"
PI_RC="$HOME/.local/bin/pi-rc"

if [[ -t 0 && -z "${PI_HOSTED:-}" && -x "$PI_RC" ]]; then
	direct=0
	for arg in "$@"; do
		case "$arg" in
			-p|--print|--no-session|-h|--help|-v|--version) direct=1; break ;;
		esac
	done
	if [[ $direct -eq 0 ]]; then
		"$PI_RC" attach --new -- "$@" && exit 0
		# Attach failed (service down, or the bridge refused): degrade to
		# the real pi so a start always works.
		exec "$REAL_PI" "$@"
	fi
fi

exec "$REAL_PI" "$@"
