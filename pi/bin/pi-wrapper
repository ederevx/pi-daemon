#!/usr/bin/env bash
# pi — auto-hosting wrapper installed by pi-background-service.
#
# A bare interactive `pi` start runs inside the persistent hosted tmux
# server (see pi-rc), so /bg works from any pi and hosted sessions survive
# terminal exit, SSH logout, and reboot. Everything else — any explicit
# arguments or flags, non-tty stdin, invocations already inside tmux
# (hosted sessions, subagent workers) — execs the real pi untouched. If the
# service helper is missing, the wrapper degrades to the real pi.
#
# REAL_PI is rewritten to the actual pi binary at install time.
set -euo pipefail

REAL_PI="@REAL_PI@"
PI_RC="$HOME/.local/bin/pi-rc"

if [[ $# -eq 0 && -t 0 && -z "${TMUX:-}" && -x "$PI_RC" ]]; then
	exec "$PI_RC" attach
fi

exec "$REAL_PI" "$@"
