#!/usr/bin/env bash
# pi-rc — launcher for the pi-background-service.
#
# The systemd user service owns a persistent tmux server (socket "pi-rc")
# that hosts live pi TUI sessions. Inside a hosted pi, /bg (handled by the
# rc-background pi extension) detaches the client: pi keeps running
# hosted until it exits or its session is deleted through pi's own session
# manager. If the hosted pi is ever gone (reboot, server restart), the next
# attach/start recreates it and resumes the latest pi session from disk. A
# pi started outside tmux (non-wrapped) hands its saved session over to
# the service through /bg instead of being left behind.
#
# Usage:
#   pi-rc start [name] [dir] [--fresh]  create a detached pi session
#                                       (default name: dir basename; default
#                                       command resumes the latest pi session,
#                                       --fresh starts an empty one)
#   pi-rc attach [name] [dir]           attach, recreating + resuming if gone
#   pi-rc handover <file> [dir]         host a specific pi session file in a
#                                       new detached session; used by /bg
#                                       outside tmux to hand a live
#                                       conversation to the persistent
#                                       service (--check <file> [dir] only
#                                       reports the hosting verdict)
#   pi-rc ls                            list hosted sessions
#   pi-rc stop <name>                   kill one session (ends that pi)
#   pi-rc daemon-start                  ensure the persistent server is running
#   pi-rc daemon-stop                   stop the server and every hosted session
set -euo pipefail

# Quote a value for the shell tmux uses to run pane commands.
shquote() {
	local s="${1//\'/\'\\\'\'}"
	printf "'%s'" "$s"
}

SOCKET_NAME="pi-rc"
CONF="${HOME}/.config/pi-background-service/tmux.conf"

_tmux() {
	tmux -L "$SOCKET_NAME" -f "$CONF" "$@"
}

server_running() {
	_tmux has-session -t _host 2>/dev/null
}

session_name() {
	local name="${1:-}"
	if [[ -z "$name" ]]; then
		name="$(basename "$(pwd)")"
	fi
	# tmux targets treat ':' and a leading '=' specially.
	name="${name//:/_}"
	name="${name#=}"
	printf 'pi-%s' "$name"
}

# Resolve the session for a directory. An explicit name is used verbatim;
# otherwise the directory basename is used, disambiguated with a path-derived
# suffix when the basename is already hosted from a different directory.
# Every created session records its directory in the @dir session option.
session_for() {
	local explicit="$1" dir="$2" base cand existing
	if [[ -n "$explicit" ]]; then
		session_name "$explicit"
		return
	fi
	base="$(basename "$dir")"
	base="${base//:/_}"
	base="${base#=}"
	cand="pi-$base"
	if _tmux has-session -t "$cand" 2>/dev/null; then
		existing="$(_tmux show-options -qv -t "$cand" '@dir' 2>/dev/null || true)"
		if [[ "$existing" != "$dir" ]]; then
			cand="pi-$base-$(printf '%s' "$dir" | sha256sum | cut -c1-6)"
		fi
	fi
	printf '%s' "$cand"
}

resolve_dir() {
	local dir="${1:-$PWD}"
	if [[ ! -d "$dir" ]]; then
		echo "pi-rc: not a directory: $dir" >&2
		exit 1
	fi
	readlink -f "$dir"
}

cmd_daemon_start() {
	if server_running; then
		return 0
	fi
	# The host session keeps the server alive; it runs no pi instance.
	_tmux new-session -d -s _host -c "$HOME" "sleep infinity"
	# The host session is never attached; hide its status bar.
	_tmux set-option -t _host status off
}

cmd_daemon_stop() {
	if _tmux has-session -t _host 2>/dev/null || _tmux list-sessions &>/dev/null; then
		_tmux kill-server 2>/dev/null || true
	fi
}

cmd_start() {
	local name="" dir="" fresh=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--fresh) fresh=1; shift ;;
		*) if [[ -z "$name" ]]; then name="$1"; else dir="$1"; fi; shift ;;
		esac
	done
	local session
	dir="$(resolve_dir "${dir:-$PWD}")"
	session="$(session_for "$name" "$dir")"
	cmd_daemon_start
	if _tmux has-session -t "$session" 2>/dev/null; then
		echo "pi-rc: session '$session' already exists (attach with: pi-rc attach ${session#pi-})"
		return 0
	fi
	if [[ "$fresh" -eq 1 ]]; then
		_tmux new-session -d -s "$session" -c "$dir" "pi"
	else
		# Resume the latest pi session on disk so conversations survive the
		# hosted process dying; fall back to a fresh pi when none exists.
		_tmux new-session -d -s "$session" -c "$dir" "sh -c 'pi -c || exec pi'"
	fi
	_tmux set-option -t "$session" '@dir' "$dir"
	echo "pi-rc: started '$session' in $dir (attach: pi-rc attach ${session#pi-}; background: /bg)"
}

cmd_attach() {
	local name="" dir=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--fresh) echo "pi-rc: --fresh is a 'start' option" >&2; exit 2 ;;
		*) if [[ -z "$name" ]]; then name="$1"; else dir="$1"; fi; shift ;;
		esac
	done
	local session
	session="$(session_for "$name" "$(resolve_dir "${dir:-$PWD}")")"
	cmd_daemon_start
	if ! _tmux has-session -t "$session" 2>/dev/null; then
		dir="$(resolve_dir "${dir:-$PWD}")"
		_tmux new-session -d -s "$session" -c "$dir" "sh -c 'pi -c || exec pi'"
		_tmux set-option -t "$session" '@dir' "$dir"
		echo "pi-rc: recreated '$session' in $dir (resuming latest session)"
	fi
	# Exec replaces the shell so a /bg detach returns cleanly to it.
	exec _tmux attach-session -t "$session"
}

# Choose the hosted session name for a handover. The directory's primary
# name is used when free; when it is taken by another conversation, a
# distinct name derived from the session file lets a second conversation
# in the same directory be hosted too. Prints "target:<name>" when the
# caller should host under <name>, or "hosted:<name>" when a hosted pane
# already resumes this exact session file (attach, do not duplicate).
handover_name() {
	local dir="$1" file="$2" primary base cand
	primary="$(session_for "" "$dir")"
	if ! _tmux has-session -t "$primary" 2>/dev/null; then
		printf 'target:%s\n' "$primary"
		return 0
	fi
	base="$(basename "$dir")"
	base="${base//:/_}"
	base="${base#=}"
	cand="$(printf 'pi-%s-%s' "$base" "$(printf '%s' "$file" | sha256sum | cut -c1-6)")"
	if _tmux has-session -t "$cand" 2>/dev/null; then
		printf 'hosted:%s\n' "$cand"
	else
		printf 'target:%s\n' "$cand"
	fi
}

cmd_handover() {
	local check=0 file="" dir="" pid="" verdict session
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--check) check=1; shift ;;
		--after-exit)
			pid="${2:?usage: pi-rc handover <file> [dir] [--after-exit <pid>]}"
			shift 2
			;;
		*) if [[ -z "$file" ]]; then file="$1"; elif [[ -z "$dir" ]]; then dir="$1"; fi; shift ;;
		esac
	done
	dir="$(resolve_dir "${dir:-$PWD}")"
	verdict="$(handover_name "$dir" "$file")"
	session="${verdict#*:}"
	if [[ "$check" -eq 1 ]]; then
		# Read-only preflight used by the rc-background extension.
		printf '%s\n' "$verdict"
		return 0
	fi
	if [[ ! -f "$file" ]]; then
		echo "pi-rc: session file not found: $file" >&2
		exit 1
	fi
	if [[ -n "$pid" ]]; then
		# The handing-over pi asked us to wait: hold off until it exits so
		# the two processes never share the session file, then give it a
		# moment to finish flushing.
		while kill -0 "$pid" 2>/dev/null; do sleep 0.2; done
		sleep 0.5
	fi
	cmd_daemon_start
	if [[ "$verdict" == hosted:* ]]; then
		echo "pi-rc: '$session' already hosts this session (attach: pi-rc attach ${session#pi-})" >&2
		exit 3
	fi
	_tmux new-session -d -s "$session" -c "$dir" "pi --session $(shquote "$file")"
	_tmux set-option -t "$session" '@dir' "$dir"
	echo "pi-rc: hosting '$session' resumed from $(basename "$file") (attach: pi-rc attach ${session#pi-}; background: /bg)"
}

cmd_ls() {
	if ! _tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -v '^_host$'; then
		echo "pi-rc: no hosted sessions"
	fi
}

cmd_stop() {
	local session
	session="$(session_name "${1:?usage: pi-rc stop <name>}")"
	_tmux kill-session -t "$session"
	echo "pi-rc: stopped '$session'"
}

# Every command except help drives the tmux server; fail with a clear
# message instead of a bare "command not found" deep inside a helper.
if [[ -n "${1:-}" && "${1:-}" != "help" ]] && ! command -v tmux >/dev/null 2>&1; then
	echo "pi-rc: tmux not found on PATH; install tmux to host pi sessions" >&2
	exit 127
fi

case "${1:-help}" in
start) shift; cmd_start "$@" ;;
attach) shift; cmd_attach "$@" ;;
handover) shift; cmd_handover "$@" ;;
ls|list) cmd_ls ;;
stop) shift; cmd_stop "$@" ;;
daemon-start) cmd_daemon_start ;;
daemon-stop) cmd_daemon_stop ;;
help|*)
	sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
	;;
esac
