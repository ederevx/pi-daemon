#!/usr/bin/env python3
# pi-rc — client for the pi-daemon PTY host daemon.
#
# The systemd user service runs pi-ptyd, a persistent host for live pi TUI
# sessions, each on its own PTY. This client talks JSON lines over the
# daemon's unix control socket: start/stop sessions, list them, detach and
# resize them, and attach, which switches the connection into a raw byte
# bridge with the session's PTY (several viewers may share one session).
# Inside a hosted pi, /bg (the daemon extension) detaches the
# client: pi keeps running headless until the user quits it (Ctrl+D) or
# deletes the session through pi's own session manager. An abnormally
# dying hosted pi (crash, SIGKILL, OOM) is revived headless from its
# announced session file; clean exits and deleted files are final. If the
# hosted pi is ever gone (reboot, daemon restart), the next attach
# recreates it and resumes the latest pi session from disk. A pi started
# outside the daemon (non-wrapped) hands its saved session over through
# "handover" instead of being left behind.
#
# Usage:
#   pi-rc start [name] [dir] [--fresh]  create a detached pi session
#                                       (default name: dir basename; default
#                                       command resumes the latest pi session,
#                                       --fresh starts an empty one)
#   pi-rc attach [name] [dir]           attach, recreating + resuming if gone
#   pi-rc attach --new [-- <pi args...>]  start a NEW hosted pi session (unique
#                                       name; fresh conversation unless the
#                                       pi args explicitly resume one) and
#                                       attach; used by the pi wrapper so
#                                       every `pi` call gets its own session
#   pi-rc announce <name> <file>        record the pi session file backing a
#                                       hosted session (drives crash revival
#                                       and daemon-restart respawning); used
#                                       by the daemon extension, which
#                                       always asks for takeover: a resumed
#                                       duplicate of a live conversation
#                                       hands its viewers to the live holder
#                                       instead of diverging from it
#   pi-rc carry <name>                  /new without termination: ask the
#                                       daemon to spawn a fresh hosted
#                                       session and move this session's
#                                       viewers onto it; this session
#                                       keeps running headless. Used by
#                                       the daemon extension.
#   pi-rc resume <name> <file>          /resume without termination: ask
#                                       the daemon to move this session's
#                                       viewers onto a live holder of
#                                       the conversation (busy first) or
#                                       a fresh session resuming the
#                                       file; this session keeps running
#                                       headless. Used by the extension.
#   pi-rc detach <name>                 detach a client; the session lives on
#                                       (Ctrl-\ inside an attached session
#                                       detaches your terminal the same way
#                                       without touching the hosted pi)
#   pi-rc ls [--here]                   list hosted sessions; --here keeps
#                                       only those whose directory is this
#                                       process's own cwd (compared natively,
#                                       never by the caller's path spelling)
#   pi-rc owned                         print the directory's daemon-owned
#                                       session: this cwd, newest real
#                                       conversation file, busy preferred on
#                                       a tie; empty when none. Used by the pi
#                                       wrapper so it compares no paths in
#                                       shell (Git Bash reports /c/... while
#                                       the daemon records C:\...)
#   pi-rc which <file>                  print the short name of the live
#                                       hosted session backing that pi
#                                       session file (empty output, exit 0
#                                       when none; exit 4 when the daemon
#                                       is unreachable); used by the pi
#                                       wrapper's resume guard
#   pi-rc stop <name>                   kill one session (ends that pi)
#   pi-rc gc-reap-ack <name>            the daemon extension's answer to
#                                       the daemon's GC reap request: clear
#                                       the request and the registry entry
#                                       before the session reaps itself
#                                       through the daemon_gc_reap tool
#   pi-rc daemon-purge                  the operator's manual force purge:
#                                       stop every detached, model-idle
#                                       session past the configured GC idle
#                                       window immediately (attached and
#                                       busy sessions stay; the automatic
#                                       reaper only ever asks)
#   pi-rc ticket-submit [--session <n>] [--cwd <dir>] [--env KEY=VALUE]
#                       -- <command>... run a shell command as a
#                                       daemon-owned ticket: it outlives
#                                       the submitting agent, output is
#                                       captured server-side, and the
#                                       ticket is tracked in tickets.json
#                                       (prints "ticket <id>"); env is
#                                       this process's environment plus
#                                       --env overrides
#   pi-rc ticket-wait <id> [timeout]    block until the ticket finishes or
#                                       timeout (default 0) seconds pass;
#                                       prints the ticket record as one
#                                       JSON line
#   pi-rc ticket-output <id> [--json] [offset]
#                                       print the ticket's final output text
#                                       (or JSON record with --json; the base64
#                                       payload from offset when offset is
#                                       given, so binary output survives the
#                                       pipe byte-faithful)
#   pi-rc ticket-list [session]         print one ticket record JSON line
#                                       per ticket, oldest first
#   pi-rc ticket-cancel <id>            TERM then KILL a running ticket
#   pi-rc ticket-remove <id>            drop a finished ticket and its
#                                       artifacts from the store (running
#                                       tickets must be cancelled first)
#   pi-rc tickets-reset                 kill the ticketing state for a
#                                       reset: cancel every running
#                                       ticket, wipe the store and all
#                                       artifacts, restart the id counter
#                                       (hosted sessions are untouched)
#   pi-rc input <name> <text...>        type raw text into a hosted
#                                       session's PTY master (e.g. a slash
#                                       command)
#   pi-rc extensions-reload [--force]   re-scan extensions, skills,
#                                       prompts, themes and context files
#                                       in every hosted conversation
#                                       session (in-place reload, signaled
#                                       to the in-session extension
#                                       directly with a PTY-typing
#                                       fallback); the
#                                       file-level diff is relayed to each
#                                       agent once it settles; --force
#                                       reloads even without changes
#   pi-rc handover <file> [dir]         host a specific pi session file in a
#                                       new detached session; used by /bg
#                                       outside the host to hand a live
#                                       conversation to the persistent
#                                       service (--check only reports the
#                                       hosting verdict; --message passes
#                                       the initial prompt the hosted pi
#                                       starts with)
#   pi-rc daemon-start                  ensure the host daemon is running
#   pi-rc daemon-stop                   stop the daemon and every hosted
#                                       session
#   pi-rc daemon-restart                hand the daemon over to a fresh
#                                       successor of the installed build:
#                                       the daemon keeps its registry,
#                                       spawns a detached successor and
#                                       exits; every hosted session
#                                       respawns under the successor

import hashlib
import json
import os
import select
import signal
import socket
import subprocess
import sys
import time


def _platform_path():
	# The platform seam ships next to the installed scripts and under
	# pi/lib in the repo; either location is put on sys.path so the lazy
	# Windows imports inside it resolve too.
	here = os.path.dirname(os.path.abspath(__file__))
	for cand in (here, os.path.join(here, os.pardir, "lib")):
		cand = os.path.abspath(cand)
		if os.path.isfile(os.path.join(cand, "pi_platform.py")):
			return cand
	return here


sys.path.insert(0, _platform_path())
import pi_platform

# Runtime paths and the control transport are platform seams: POSIX uses
# XDG_RUNTIME_DIR + a loopback TCP endpoint file; Windows uses
# %LOCALAPPDATA%/%TEMP%. The .sock name is kept so no state migration is
# needed (its contents are now {host, port, token}).
LAYOUT = pi_platform.RuntimeLayout()
ENDPOINT = pi_platform.EndpointFile(LAYOUT.endpoint_path())
PROCESS = pi_platform.ProcessControl()
SOCK_PATH = LAYOUT.endpoint_path()
STATE_HOME = LAYOUT.state_home()
LOG_PATH = LAYOUT.daemon_log_path()

DEFAULT_COLS = 120
DEFAULT_ROWS = 40
CONTROL_TIMEOUT = 5.0    # seconds per control round-trip; never hang
DAEMON_START_WAIT = 2.0  # seconds to wait for the socket after spawning
DAEMON_RESTART_WAIT = 30.0  # seconds for the successor to publish
MAX_BUF = 1 << 20        # per-direction bridge buffer bound (backpressure)
RELAY_TICK = 0.1         # select bound: lets Windows poll for resize

EXIT_OK = 0
EXIT_USAGE = 1
EXIT_HOSTED = 3          # handover: the session is already hosted
EXIT_NO_DAEMON = 4       # control socket unreachable (before any request
                         # landed: safe to run the task locally instead)
EXIT_AMBIGUOUS = 7       # the request was sent but the outcome is unknown:
                         # the daemon may have acted on it, so callers must
                         # NOT blindly re-run the task locally

USAGE_LINE = "usage: pi-rc <command> [args]; run 'pi-rc help' for details"

DETACH_KEY = b"\x1c"  # Ctrl-\: pop out of an attached session without exiting pi

# Commands served by main(); ls has a list alias.
_COMMANDS = ("which", "whichall", "owned", "state", "carry", "resume", "start",
			 "attach", "announce", "detach", "stop", "gc-reap-ack", "handover",
			 "daemon-start", "daemon-stop", "daemon-restart",
			 "daemon-purge",
			 "input", "extensions-reload",
			 "ticket-submit", "ticket-wait", "ticket-output",
			 "ticket-list", "ticket-cancel", "ticket-remove", "tickets-reset")


def die(msg, code=EXIT_USAGE):
	sys.stderr.write("pi-rc: %s\n" % msg)
	sys.exit(code)


def usage_error(hint):
	if hint:
		die("%s\n%s" % (hint, USAGE_LINE))
	die(USAGE_LINE)


def short_name(full):
	# strip the "pi-" prefix for user-facing attach hints
	return full[3:] if full.startswith("pi-") else full


def session_base(name):
	# tmux-era target naming: ':' is special, a leading '=' is special
	name = name.replace(":", "_")
	if name.startswith("="):
		name = name[1:]
	return name


def session_name(name):
	# an explicit name is normalized exactly like a dir-basename one
	return "pi-" + session_base(name)


def session_for(explicit, dir_):
	if explicit:
		return session_name(explicit)
	return "pi-" + session_base(os.path.basename(dir_))


def resolve_dir(dir_arg):
	dir_ = dir_arg or os.getcwd()
	if not os.path.isdir(dir_):
		die("not a directory: %s" % dir_arg)
	return os.path.realpath(dir_)


def tty_size(fd=0):
	# Size of the controlling tty; callers without one get the default.
	# Windows resolves fd 0 to the console *input* handle, which
	# GetConsoleScreenBufferInfo rejects, so fall through to stdout/stderr
	# (both real console handles) before giving up. POSIX keeps fd 0.
	for candidate in dict.fromkeys((fd, 1, 2)):
		try:
			sz = os.get_terminal_size(candidate)
			return sz.columns, sz.lines
		except OSError:
			continue
	return DEFAULT_COLS, DEFAULT_ROWS


def same_dir(a, b):
	try:
		return os.path.realpath(a) == os.path.realpath(b)
	except OSError:
		return a == b


def unique_session_name(base, pid, taken):
	# "<base>-<hash>" names for --new starts; collision-checked against a
	# live-set callable, with a bounded attempt budget.
	for attempt in range(8):
		suffix = hashlib.sha256(
			("%d-%d-%d" % (time.time_ns(), pid, attempt)).encode()
		).hexdigest()[:4]
		candidate = "pi-%s-%s" % (base, suffix)
		if not taken(candidate):
			return candidate
	return None


def send_json(sock, obj):
	sock.sendall(json.dumps(obj).encode() + b"\n")


def read_json_line(sock):
	# one response line; returns (obj, unconsumed bytes after the line)
	buf = b""
	while b"\n" not in buf:
		try:
			data = sock.recv(65536)
		except OSError:
			return None, buf
		if not data:
			return None, buf
		buf += data
	line, rest = buf.split(b"\n", 1)
	try:
		obj = json.loads(line.decode())
	except (ValueError, UnicodeDecodeError):
		obj = None
	return obj, rest


class DaemonClient:
	"""Short-lived control connections to the daemon endpoint."""

	def __init__(self, sock_path=SOCK_PATH):
		self.sock_path = sock_path
		self.control_client = pi_platform.ControlClient(
			pi_platform.EndpointFile(sock_path))

	def connect(self, timeout=CONTROL_TIMEOUT):
		# The endpoint file carries the loopback host/port and the token
		# for the mandatory hello handshake; a missing or refused endpoint
		# means the daemon is not running.
		try:
			return self.control_client.connect(timeout)
		except OSError:
			die("background service is not running "
				"(systemctl --user start pi-daemon)",
				EXIT_NO_DAEMON)

	def control(self, req, timeout=None):
		# one JSON-line round-trip on a short-lived control connection;
		# wait-shaped requests pass their own (longer) timeout
		sock = self.connect(timeout if timeout is not None else CONTROL_TIMEOUT)
		try:
			send_json(sock, req)
			resp, _ = read_json_line(sock)
		except OSError as exc:
			# The request may already have been acted on: ambiguous.
			die("control connection failed: %s" % exc, EXIT_AMBIGUOUS)
		finally:
			sock.close()
		if resp is None:
			die("daemon closed the connection without a response",
				EXIT_AMBIGUOUS)
		return resp

	def alive(self):
		try:
			probe = self.control_client.connect(CONTROL_TIMEOUT)
		except OSError:
			return False
		probe.close()
		return True


def find_daemon():
	here = os.path.dirname(os.path.realpath(__file__))
	# installed layout: the daemon next to pi-rc; repo layout:
	# <repo>/pi/bin/pi-rc -> <repo>/pi/daemon/pi-daemon.
	candidates = [
		os.path.join(here, "pi-daemon"),
		os.path.join(here, "pi-ptyd"),
		os.path.join(os.path.dirname(here), "daemon", "pi-daemon"),
		os.path.join(os.path.dirname(here), "ptyd", "pi-ptyd"),
	]
	for cand in candidates:
		if os.path.isfile(cand):
			return cand
	return None


class Bridge:
	"""Raw byte relay between the terminal seam and the daemon bridge; the
	only unbounded phase, and the terminal is restored on every exit path.
	run() returns a short status word for the caller to report after the
	terminal is restored (the user must be able to tell they left the
	TUI)."""

	def __init__(self, client, sock, session, initial=b"", terminal=None):
		self.client = client
		self.sock = sock
		self.session = session
		self.initial = initial
		self.terminal = (pi_platform.select_terminal_mode()
						 if terminal is None else terminal)
		self.status = "lost"

	def run(self):
		prev = self._install_exit_handlers()
		try:
			# enter() is inside the guard: a half-entered terminal (raw
			# mode, wake pipe, console modes/CP) must still be restored.
			self.terminal.enter()
			self.sock.setblocking(False)
			self._relay()
		finally:
			self.terminal.restore()
			self._restore_exit_handlers(prev)
			self.sock.close()
		return self.status

	def _install_exit_handlers(self):
		# turn lethal signals into a normal unwind so the terminal is
		# restored; resize belongs to the terminal seam
		prev = {}

		def on_term(_signum, _frame):
			raise SystemExit(0)

		for name in ("SIGTERM", "SIGHUP"):
			if hasattr(signal, name):
				prev[name] = signal.getsignal(getattr(signal, name))
				signal.signal(getattr(signal, name), on_term)
		return prev

	def _restore_exit_handlers(self, prev):
		for name, handler in prev.items():
			signal.signal(getattr(signal, name), handler)

	def _resize(self):
		# the bridge connection is raw bytes; resize rides a second
		# short-lived control connection
		try:
			cols, rows = self.terminal.size()
			if cols <= 0 or rows <= 0:
				return
			self.client.control({"cmd": "resize", "name": self.session,
								 "cols": cols, "rows": rows})
		except (OSError, SystemExit):
			pass

	def _relay(self):
		to_sock = bytearray()
		to_tty = bytearray(self.initial)
		in_fd = self.terminal.input_fd()
		wake_fd = self.terminal.wake_fd()
		out_fd = self.terminal.writable_fd()
		# Push the terminal's real size once on entry: the attach request's
		# size can be stale (and Windows fd 0 cannot report it), while
		# take_resize only fires on a later change. Without this the hosted
		# TUI stays at the size it was created with until the user resizes.
		self._resize()
		while True:
			if self.terminal.take_resize():
				self._resize()
			rlist = []
			if wake_fd is not None:
				rlist.append(wake_fd)
			if in_fd is not None and len(to_sock) < MAX_BUF:
				rlist.append(in_fd)
			if len(to_tty) < MAX_BUF:
				rlist.append(self.sock)
			wlist = []
			if to_sock:
				wlist.append(self.sock)
			if to_tty and out_fd is not None:
				wlist.append(out_fd)
			try:
				rl, wl, _ = select.select(rlist, wlist, [], RELAY_TICK)
			except OSError:
				# a polled fd vanished; nothing left to relay
				break
			if not self._pump_input(rl, in_fd, to_sock):
				break
			if not self._pump_socket(rl, to_tty):
				break
			if not self._drain_to_socket(wl, to_sock):
				break
			if not self._drain_to_tty(wl, out_fd, to_tty):
				break
			if to_tty and out_fd is None:
				# Windows console output is not select-able; write directly
				if not self._write_direct(to_tty):
					break
		if to_tty:
			self._final_flush(to_tty)

	def _pump_input(self, ready, in_fd, to_sock):
		if in_fd is None or in_fd not in ready:
			return True
		data = self.terminal.read_input(65536)
		if data is None:
			return True
		if data == b"":
			# EOF on input: detach; the session keeps running
			self.status = "detached"
			return False
		# Ctrl-\ pops out: keep the hosted pi running, hand the
		# terminal back, and never forward the key to the TUI
		if DETACH_KEY in data:
			to_sock += data[:data.index(DETACH_KEY)]
			self.status = "detached"
			return False
		to_sock += data
		return True

	def _pump_socket(self, ready, to_tty):
		if self.sock not in ready:
			return True
		try:
			data = self.sock.recv(65536)
		except (BlockingIOError, InterruptedError):
			return True
		except OSError:
			self.status = "lost"
			return False
		if data == b"":
			# bridge closed: detached, child exited, or stolen
			self.status = "closed"
			return False
		if data:
			to_tty += data
			if len(to_tty) > MAX_BUF:
				del to_tty[:len(to_tty) - MAX_BUF]
		return True

	def _drain_to_socket(self, ready, to_sock):
		if self.sock not in ready or not to_sock:
			return True
		try:
			sent = self.sock.send(to_sock[:65536])
			del to_sock[:sent]
		except (BlockingIOError, InterruptedError):
			pass
		except OSError:
			self.status = "lost"
			return False
		return True

	def _drain_to_tty(self, ready, out_fd, to_tty):
		if out_fd is None or out_fd not in ready or not to_tty:
			return True
		return self._write_direct(to_tty)

	def _write_direct(self, to_tty):
		sent = self.terminal.write_output(bytes(to_tty[:65536]))
		if sent is None:
			self.status = "lost"
			return False
		if sent:
			del to_tty[:sent]
		return True

	def _final_flush(self, to_tty):
		# flush whatever the child produced before the bridge ended so the
		# final frame is not dropped
		deadline = time.monotonic() + 2.0
		while to_tty and time.monotonic() < deadline:
			sent = self.terminal.write_output(bytes(to_tty[:65536]))
			if sent is None:
				break
			if sent:
				del to_tty[:sent]
			else:
				time.sleep(0.05)


class AttachFlow:
	"""The attach lifecycle: start a fresh session when asked, handshake
	(with recreate-on-gone), follow daemon handoffs (both via the attach
	response and after a bridge closes), and report the outcome."""

	def __init__(self, client, session, cols, rows, fresh_new=False, dir_=None):
		self.client = client
		self.session = session
		self.cols = cols
		self.rows = rows
		self.fresh_new = fresh_new
		self.dir_ = dir_

	def start_new(self, pi_args):
		# Every call gets its own hosted session: a unique name per
		# invocation and always a fresh conversation unless the caller
		# passed pi's own resume flags through pi_args.
		base = session_base(os.path.basename(self.dir_))
		argv = PROCESS.pi_argv(pi_args)
		sock = self.client.connect()
		for _ in range(8):
			self.session = unique_session_name(base, os.getpid(),
											   lambda n: False)
			send_json(sock, {"cmd": "start", "name": self.session,
							 "dir": self.dir_, "argv": argv,
							 "cols": self.cols, "rows": self.rows})
			resp, _ = read_json_line(sock)
			if resp is None or not resp.get("ok"):
				die("start failed: %s"
					% (resp or {}).get("error", "no response"))
			if resp.get("created", True):
				break
		else:
			die("could not find a free session name")
		print("pi-rc: started '%s' in %s (background: /bg)"
			  % (self.session, self.dir_))
		return sock

	def handshake(self, sock):
		# Attach the current connection to self.session; recreates the
		# session (resuming the latest conversation) when it is gone.
		send_json(sock, {"cmd": "attach", "name": self.session,
						 "cols": self.cols, "rows": self.rows})
		resp, rest = read_json_line(sock)
		if resp is None or not resp.get("ok"):
			error = (resp or {}).get("error") if resp else "no response"
			if error == "no-session" and not self.fresh_new:
				return self._recreate(sock)
			die("attach failed: %s" % error)
		return resp, rest

	def _recreate(self, sock):
		argv = PROCESS.resume_command()
		send_json(sock, {"cmd": "start", "name": self.session,
						 "dir": self.dir_, "argv": argv,
						 "cols": self.cols, "rows": self.rows})
		start_resp, _ = read_json_line(sock)
		if start_resp is None or not start_resp.get("ok"):
			die("attach failed: start failed: %s"
				% (start_resp or {}).get("error", "no response"))
		print("pi-rc: recreated '%s' in %s (resuming latest session)"
			  % (self.session, self.dir_))
		send_json(sock, {"cmd": "attach", "name": self.session,
						 "cols": self.cols, "rows": self.rows})
		resp, rest = read_json_line(sock)
		if resp is None or not resp.get("ok"):
			error = (resp or {}).get("error") if resp else "no response"
			die("attach failed: %s" % error)
		return resp, rest

	@staticmethod
	def notice(session, resp):
		# The daemon only replies ok to an attach when the hosted session
		# is alive, so this line is the user's signal that streaming
		# continues behind the TUI — the cue a stale reattached frame used
		# to hide. The daemon's idea of the model run state and the
		# viewer count comes with the response.
		state = resp.get("state") or "idle"
		nclients = resp.get("clients") or 1
		note = "model working" if state == "busy" else "idle at prompt"
		shared = "" if nclients <= 1 else \
			" (%d terminals share this view)" % nclients
		print("pi-rc: attached to '%s' — session is active (%s)%s"
			  % (session, note, shared))

	def follow_response_handoffs(self, sock, resp, rest):
		# A duplicate that already handed its viewers to a live holder
		# (resume takeover) must not gain a new viewer: follow the
		# recorded handoff to the live holder of the conversation this
		# attach tried to open.
		while resp.get("ok") and resp.get("handoff"):
			follow = resp["handoff"]
			print("pi-rc: '%s' opened a conversation already live in '%s' "
				  "(%s); attaching there"
				  % (self.session, short_name(follow["name"]),
					 follow.get("state") or "idle"))
			self.session = follow["name"]
			rest = b""
			try:
				sock.close()
			except OSError:
				pass
			sock = self.client.connect()
			send_json(sock, {"cmd": "attach", "name": self.session,
							 "cols": self.cols, "rows": self.rows})
			resp, rest = read_json_line(sock)
			if resp is None or not resp.get("ok"):
				error = (resp or {}).get("error") if resp else "no response"
				die("attach failed: %s" % error)
		return sock, resp, rest

	def bridge_loop(self, sock, resp, rest):
		# The bridge ends when the child exits, the daemon closes it (a
		# /bg detach, a steal, or a resume handoff), or the connection
		# drops. A handoff points this viewer at the live holder of the
		# conversation it tried to open, so follow it with a fresh bridge
		# instead of reporting a detach from a session that must not keep
		# running.
		attempts = 0
		while True:
			status = Bridge(self.client, sock, self.session, rest).run()
			# Make the drop unmistakable: wipe the frozen TUI frame and
			# state where the session went — this is the exact gap that
			# made a detached session look like a stuck TUI.
			print("\x1b[H\x1b[2J\x1b[m", end="")
			attempts += 1
			handoff = (self._query_handoff()
					   if status == "closed" and attempts < 4 else None)
			if handoff is None:
				return status
			print("pi-rc: '%s' opened a conversation already live in '%s' "
				  "(%s); attaching there"
				  % (self.session, short_name(handoff["name"]),
					 handoff.get("state") or "idle"))
			self.session = handoff["name"]
			rest = b""
			sock = self.client.connect()
			send_json(sock, {"cmd": "attach", "name": self.session,
							 "cols": self.cols, "rows": self.rows})
			resp, rest = read_json_line(sock)
			if resp is None or not resp.get("ok"):
				# The holder died before we followed; report the closed
				# bridge for this session through the normal path below.
				return status
			AttachFlow.notice(self.session, resp)

	def _query_handoff(self):
		# A session the daemon handed off (resume takeover) names the live
		# holder its viewers should follow instead of staying detached.
		try:
			resp = self.client.control({"cmd": "handoff-target",
										"name": self.session})
		except SystemExit:
			return None
		if resp.get("ok") and resp.get("target"):
			return resp["target"]
		return None

	def report_exit(self, status):
		if status in ("detached", "closed"):
			note = "session keeps running in the background"
			if status == "closed":
				# daemon closed our bridge: a /bg detach, a steal, or the
				# child exiting — ask the daemon which one it was
				try:
					live = {s.get("name") for s in
							self.client.control({"cmd": "list"}).get("sessions") or []}
					note = (note if self.session in live
							else "session ended")
				except SystemExit:
					note = "session state unknown (daemon unreachable)"
			print("pi-rc: detached '%s' (%s; return with: pi-rc attach %s)"
				  % (self.session, note, short_name(self.session)))
		elif status == "lost":
			print("pi-rc: connection to '%s' lost" % self.session)


# ------------------------------------------------------------------ daemon

def cmd_daemon_start(_args, client):
	# already up: done silently
	if client.alive():
		return
	daemon = find_daemon()
	if daemon is None:
		die("cannot find the pi-daemon script next to %s"
			% os.path.realpath(__file__))
	os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
	logf = open(LOG_PATH, "ab")
	try:
		# Detach fully: own session, output only to the daemon log. On
		# Windows the interpreter is its windowless twin so no console
		# flashes.
		PROCESS.launch_detached(
			[PROCESS.windowless_python(sys.executable), daemon], logf)
	finally:
		logf.close()
	deadline = time.time() + DAEMON_START_WAIT
	while time.time() < deadline:
		if client.alive():
			return
		time.sleep(0.05)
	die("background daemon did not come up (see %s)" % LOG_PATH,
		EXIT_NO_DAEMON)


def cmd_daemon_stop(_args, client):
	# best-effort: a missing daemon is already the desired state
	try:
		sock = client.connect()
		send_json(sock, {"cmd": "shutdown"})
		read_json_line(sock)
		sock.close()
	except (OSError, SystemExit):
		pass


def cmd_daemon_restart(_args, client):
	# Hand the daemon over to a fresh successor of the installed build:
	# the daemon keeps its registry, spawns a detached successor and
	# exits; the successor publishes new endpoint coordinates and
	# respawns every hosted session. Old daemons that predate the
	# request answer bad-request, which is reported, not ambiguous.
	before = ENDPOINT.read()
	if not client.alive():
		die("background service is not running "
			"(systemctl --user start pi-daemon)", EXIT_NO_DAEMON)
	resp = client.control({"cmd": "daemon-restart"})
	if not resp.get("ok"):
		die("daemon restart refused: %s (update pi-daemon)"
			% resp.get("error"))
	# The endpoint rotates to the successor; wait until the new
	# coordinates answer before declaring success.
	deadline = time.time() + DAEMON_RESTART_WAIT
	while time.time() < deadline:
		data = ENDPOINT.read()
		if data != before and data.get("host") and client.alive():
			print("pi-daemon restarted (endpoint %s:%s)"
				  % (data.get("host"), data.get("port")))
			return
		time.sleep(0.1)
	die("daemon restart did not complete (see %s)" % LOG_PATH,
		EXIT_AMBIGUOUS)


# ---------------------------------------------------------------- commands

def cmd_start(args, client):
	name = None
	dir_arg = None
	fresh = False
	for arg in args:
		if arg == "--fresh":
			fresh = True
		elif name is None:
			name = arg
		elif dir_arg is None:
			dir_arg = arg
		else:
			usage_error("too many arguments for 'start'")
	dir_ = resolve_dir(dir_arg)
	session = session_for(name, dir_)
	# default command resumes the latest pi session on disk so
	# conversations survive the hosted process dying; --fresh starts empty
	argv = PROCESS.pi_argv() if fresh else PROCESS.resume_command()
	cols, rows = tty_size(0)
	resp = client.control({"cmd": "start", "name": session, "dir": dir_,
						   "argv": argv, "cols": cols, "rows": rows})
	if not resp.get("ok"):
		die("start failed: %s" % resp.get("error"))
	if not resp.get("created", True):
		print("pi-rc: session '%s' already exists (attach: pi-rc attach %s)"
			  % (session, short_name(session)))
		return
	print("pi-rc: started '%s' in %s (attach: pi-rc attach %s; background: /bg)"
		  % (session, dir_, short_name(session)))


def cmd_detach(args, client):
	if len(args) != 1:
		usage_error("detach takes exactly one session name")
	session = session_name(args[0])
	resp = client.control({"cmd": "detach", "name": session})
	if not resp.get("ok"):
		die("detach failed: %s" % resp.get("error"))
	print("pi-rc: detached '%s'" % session)


def cmd_ls(args, client):
	# --here filters to this process's own directory using the same
	# native realpath comparison the daemon uses, so no caller ever
	# compares path spellings itself (a shell may report "/c/..." where
	# the daemon recorded "C:\..." on Windows).
	here = False
	for arg in args:
		if arg == "--here":
			here = True
		else:
			usage_error("ls takes only --here")
	resp = client.control({"cmd": "list"})
	sessions = resp.get("sessions") or []
	if here:
		cwd = os.getcwd()
		sessions = [s for s in sessions
					if same_dir(s.get("dir", ""), cwd)]
	if not sessions:
		print("pi-rc: no hosted sessions")
		return
	for s in sessions:
		marker = "attached" if s.get("attached") else "detached"
		nclients = s.get("clients") or 0
		if nclients > 1:
			marker += " x%d" % nclients
		state = s.get("state") or "idle"
		file = s.get("file") or "-"
		print("%s\t%s\tpid %d\t%s\t%s\t%s"
			  % (short_name(s.get("name", "")), s.get("dir", ""),
				 s.get("pid", 0), marker, state, file))


def pick_owned_session(sessions, cwd):
	# Pure selection for cmd_owned: the newest real conversation file among
	# sessions whose dir is cwd (native realpath comparison), busy preferred
	# on a tie. Returns the session mapping, or None when none qualifies.
	newest = None
	newest_mtime = None
	for s in sessions:
		if not same_dir(s.get("dir", ""), cwd):
			continue
		file = s.get("file")
		if not file or file == "-":
			continue
		try:
			mtime = os.path.getmtime(file)
		except OSError:
			continue
		state = s.get("state") or "idle"
		if (newest is None or mtime > newest_mtime
				or (mtime == newest_mtime and state == "busy")):
			newest = s
			newest_mtime = mtime
	return newest


def cmd_owned(args, client):
	# The directory's daemon-owned session: a live session whose directory
	# is this process's own cwd (native realpath), backing a real
	# conversation file, newest first, busy preferred on a tie. Silent
	# when none. The wrapper delegates here so path comparison stays on
	# one OS-agnostic implementation (same_dir) instead of shell strings.
	if args:
		usage_error("owned takes no arguments")
	resp = client.control({"cmd": "list"})
	newest = pick_owned_session(resp.get("sessions") or [], os.getcwd())
	if newest is not None:
		print(short_name(newest.get("name", "")))


def cmd_which(args, client):
	# Used by the pi wrapper's resume guard: does any live hosted session
	# back this conversation file? Prints the short session name when one
	# does, stays silent with exit 0 otherwise, and reuses the existing
	# exit-code semantics (4 = daemon unreachable) on the way there.
	if len(args) != 1:
		usage_error("which takes exactly one session file")
	resp = client.control({"cmd": "which", "file": args[0]})
	if not resp.get("ok"):
		die("which failed: %s" % resp.get("error"))
	name = resp.get("name")
	if name:
		print(short_name(name))


def cmd_whichall(args, client):
	# Every live hosted session backing a conversation file, one
	# "<short-name>\t<state>" line each; silent with exit 0 when none.
	if len(args) != 1:
		usage_error("whichall takes exactly one session file")
	resp = client.control({"cmd": "whichall", "file": args[0]})
	if not resp.get("ok"):
		die("whichall failed: %s" % resp.get("error"))
	for h in resp.get("names") or []:
		print("%s\t%s" % (short_name(h.get("name", "")),
						  h.get("state", "idle")))


def cmd_state(args, client):
	# Published by the daemon extension: whether the model is
	# working or idle in this hosted session; surfaced by ls and attach.
	if len(args) != 2:
		usage_error("state takes exactly a session name and busy|idle|waiting")
	if args[1] not in ("busy", "idle", "waiting"):
		usage_error("state must be busy, idle, or waiting")
	session = session_name(args[0])
	resp = client.control({"cmd": "state", "name": session, "state": args[1]})
	if not resp.get("ok"):
		die("state failed: %s" % resp.get("error"))


def cmd_stop(args, client):
	if len(args) != 1:
		usage_error("stop takes exactly one session name")
	session = session_name(args[0])
	resp = client.control({"cmd": "stop", "name": session})
	if not resp.get("ok"):
		die("stop failed: %s" % resp.get("error"))
	print("pi-rc: stopped '%s'" % session)


def cmd_gc_reap_ack(args, client):
	# Extension-only: the daemon_gc_reap tool acknowledges the daemon's GC
	# reap request before shutting this session down. Best-effort from the
	# caller's side: the daemon's child-exit cleanup drops an unacknowledged
	# session anyway.
	if len(args) != 1:
		usage_error("gc-reap-ack takes exactly one session name")
	session = session_name(args[0])
	resp = client.control({"cmd": "gc-reap-ack", "name": session})
	if not resp.get("ok"):
		die("gc-reap-ack failed: %s" % resp.get("error"))


def cmd_daemon_purge(_args, client):
	# Operator-only: force-stop every detached, model-idle session past
	# the configured GC idle window. The automatic reaper only asks a
	# session to reap itself; this is the explicit manual purge. Prints
	# one tab-delimited line per purged session (the daemon extension
	# reads them) plus a human summary.
	resp = client.control({"cmd": "daemon-purge"})
	if not resp.get("ok"):
		die("daemon-purge failed: %s" % resp.get("error"))
	purged = resp.get("purged") or []
	for name in purged:
		# tab after the keyword: session names may contain spaces
		print("purged\t%s" % short_name(name))
	if purged:
		print("pi-daemon: purged %d idle session(s)" % len(purged))
	else:
		print("pi-daemon: no idle sessions past the configured GC window")


def cmd_carry(args, client):
	# Extension-only helper for /new: the daemon spawns a fresh hosted
	# session sized like the current view, moves this session's bridge
	# viewers onto it, and leaves this session running headless.
	if len(args) != 1:
		usage_error("carry takes exactly one session name")
	resp = client.control({"cmd": "carry", "name": session_name(args[0])})
	if not resp.get("ok"):
		die("carry failed: %s" % resp.get("error"))
	print("carried %s" % short_name(resp.get("name", "")))


def cmd_resume(args, client):
	# Extension-only helper for /resume: the daemon resolves the picked
	# conversation to its live holder (busy first) or a fresh session
	# resuming the file, and moves this session's viewers there; this
	# session keeps running headless instead of being switched or aborted.
	if len(args) != 2:
		usage_error("resume takes exactly a session name and a session file")
	name, file = args
	if not os.path.isabs(file):
		die("resume expects an absolute session file path")
	resp = client.control({"cmd": "resume", "name": session_name(name),
						   "file": file})
	if not resp.get("ok"):
		die("resume failed: %s" % resp.get("error"))
	print("resumed %s" % short_name(resp.get("name", "")))


def cmd_announce(args, client):
	takeover = False
	rest = []
	for arg in args:
		if arg == "--takeover":
			takeover = True
		else:
			rest.append(arg)
	if len(rest) != 2:
		usage_error("announce takes exactly a session name and a session file")
	name, file = rest
	if not os.path.isabs(file):
		die("announce expects an absolute session file path")
	req = {"cmd": "announce", "name": session_name(name), "file": file}
	if takeover:
		req["takeover"] = True
	resp = client.control(req)
	if not resp.get("ok"):
		die("announce failed: %s" % resp.get("error"))
	# With takeover the daemon may have decided this duplicate must not
	# keep running: it closed our session's bridges and recorded where its
	# viewers should follow; the extension shuts the duplicate down.
	handoff = resp.get("handoff") or None
	if handoff and handoff.get("name"):
		# tab separator: session names may contain spaces
		print("handoff %s\t%s" % (short_name(handoff["name"]),
								   handoff.get("state", "idle")))
	for h in resp.get("tookOver") or []:
		# tab after the keyword: session names may contain spaces
		print("took-over\t%s" % short_name(h))
	# Other live holders of the same conversation: the extension turns
	# these into a duplicate-open warning when no handoff happened.
	for h in resp.get("alsoLive") or []:
		print("also-live %s %s" % (short_name(h.get("name", "")),
								   h.get("state", "idle")))


def cmd_input(args, client):
	if len(args) < 2:
		usage_error("input takes a session name and text to type into it")
	name, text = args[0], " ".join(args[1:])
	resp = client.control({"cmd": "input", "name": name, "text": text})
	if not resp.get("ok"):
		die("input failed: %s" % resp.get("error"))
	print("pi-rc: typed %d bytes into '%s'" % (resp.get("bytes", 0), name))


def cmd_extensions_reload(args, client):
	if args not in ([], ["--force"], ["--all"]):
		usage_error("extensions-reload takes no arguments (or --force)")
	req = {"cmd": "extensions-reload", "force": args == ["--force"]}
	resp = client.control(req)
	if not resp.get("ok"):
		die("extensions-reload failed: %s" % resp.get("error"))
	if resp.get("unchanged"):
		print("pi-rc: extension roots unchanged; nothing to reload")
		return
	diff = resp.get("diff") or {}
	reloaded = resp.get("reloaded") or []
	if reloaded:
		print("pi-rc: reloaded %s" % ", ".join(reloaded))
	else:
		print("pi-rc: reloaded no sessions")
	if resp.get("deferred"):
		print("pi-rc: reload deferred for busy session(s); the watch retries them")
	if resp.get("skipped"):
		kids = []
		for entry in resp["skipped"]:
			if isinstance(entry, dict):
				kids.append("%s (%s)" % (entry.get("id", "?"), entry.get("reason", "?")))
			else:
				kids.append(str(entry))
		print("pi-rc: skipped %s" % ", ".join(kids))
	for p in diff.get("added") or []:
		print("pi-rc: + %s" % p)
	for p in diff.get("changed") or []:
		print("pi-rc: ~ %s" % p)
	for p in diff.get("removed") or []:
		print("pi-rc: - %s" % p)


def handover_check(client, dir_, file):
	# client-side preflight mirroring the daemon's target logic: the
	# directory's primary name when free or held from the same directory,
	# otherwise a hash-suffixed name derived from the session file
	resp = client.control({"cmd": "list"})
	live = {s.get("name"): s for s in (resp.get("sessions") or [])}
	base = session_base(os.path.basename(dir_))
	primary = "pi-" + base
	holder = live.get(primary)
	if holder is None or same_dir(holder.get("dir"), dir_):
		return "target:%s" % primary
	digest = hashlib.sha256(file.encode()).hexdigest()[:6]
	hashed = "pi-%s-%s" % (base, digest)
	if hashed in live:
		return "hosted:%s" % hashed
	return "target:%s" % hashed


def cmd_handover(args, client):
	check = False
	file = None
	dir_arg = None
	after_pid = None
	message = None
	hint = ("usage: pi-rc handover <file> [dir] [--check] "
			"[--after-exit <pid>] [--message <text>]")
	i = 0
	while i < len(args):
		arg = args[i]
		if arg == "--check":
			check = True
		elif arg == "--after-exit":
			i += 1
			if i >= len(args):
				usage_error(hint)
			try:
				after_pid = int(args[i])
			except ValueError:
				usage_error("--after-exit expects a pid")
		elif arg == "--message":
			i += 1
			if i >= len(args):
				usage_error(hint)
			message = args[i]
		elif file is None:
			file = arg
		elif dir_arg is None:
			dir_arg = arg
		else:
			usage_error("too many arguments for 'handover'")
		i += 1
	if file is None:
		usage_error(hint)
	if message is not None and not message:
		usage_error("--message expects non-empty text")
	dir_ = resolve_dir(dir_arg)
	if check:
		# read-only preflight used by the daemon extension
		print(handover_check(client, dir_, file))
		return
	if not os.path.isfile(file):
		die("session file not found: %s" % file)
	req = {"cmd": "handover", "file": file, "dir": dir_}
	if after_pid is not None:
		req["afterPid"] = after_pid
		req["hold"] = True
	if message:
		req["message"] = message
	sock = client.connect()
	try:
		send_json(sock, req)
		resp, _ = read_json_line(sock)
	except OSError as exc:
		sock.close()
		die("handover failed: %s" % exc, EXIT_AMBIGUOUS)
	if resp is None:
		sock.close()
		die("daemon closed the connection without a response",
			EXIT_AMBIGUOUS)
	if not resp.get("ok"):
		sock.close()
		die("handover failed: %s" % resp.get("error"))
	verdict = resp.get("verdict") or ""
	kind, _, session = verdict.partition(":")
	if kind == "hosted":
		sock.close()
		sys.stderr.write(
			"pi-rc: '%s' already hosts this session "
			"(attach: pi-rc attach %s)\n" % (session, short_name(session)))
		sys.exit(EXIT_HOSTED)
	if kind != "target":
		sock.close()
		die("unexpected handover verdict: %s" % verdict)
	print("pi-rc: hosting '%s' resumed from %s (attach: pi-rc attach %s; "
		  "background: /bg)"
		  % (session, os.path.basename(file), short_name(session)))
	if after_pid is not None:
		# Hold the control connection open until the handing-over pi has
		# exited; closing it is the daemon's exit signal and it hosts the
		# session then. No pid probe is involved.
		PROCESS.wait_for_parent_exit(after_pid)
	sock.close()


def cmd_attach(args, client):
	fresh_new = False
	pi_args = []
	name = None
	dir_arg = None
	i = 0
	while i < len(args):
		arg = args[i]
		if arg == "--new":
			fresh_new = True
		elif arg == "--fresh":
			die("--fresh is a 'start' option")
		elif arg == "--":
			pi_args = list(args[i + 1:])
			break
		elif name is None:
			name = arg
		elif dir_arg is None:
			dir_arg = arg
		else:
			usage_error("too many arguments for 'attach'")
		i += 1
	if fresh_new and (name is not None or dir_arg is not None):
		usage_error("--new takes only [-- <pi args...>]")
	if not os.isatty(0):
		die("attach requires a terminal on stdin; run 'pi-rc attach' "
			"inside a tty (see pi-rc help)")
	flow = AttachFlow(client, session_for(name, resolve_dir(dir_arg)),
					  tty_size(0)[0], tty_size(0)[1],
					  fresh_new=fresh_new, dir_=resolve_dir(dir_arg))
	flow.cols, flow.rows = tty_size(0)
	if fresh_new:
		sock = flow.start_new(pi_args)
	else:
		sock = client.connect()
	resp, rest = flow.handshake(sock)
	sock, resp, rest = flow.follow_response_handoffs(sock, resp, rest)
	AttachFlow.notice(flow.session, resp)
	status = flow.bridge_loop(sock, resp, rest)
	flow.report_exit(status)


# ------------------------------------------------------------- tickets

def cmd_ticket_submit(args, client):
	# Offload a shell command to the daemon as a ticket: it outlives the
	# submitting agent, output is captured daemon-side, and completion is
	# tracked in the persisted ticket store. Prints "ticket <id>".
	session_arg = None
	dir_arg = None
	env_overrides = []
	while args:
		arg = args.pop(0)
		if arg == "--":
			break
		if arg == "--session" and args:
			session_arg = args.pop(0)
		elif arg == "--cwd" and args:
			dir_arg = args.pop(0)
		elif arg == "--env" and args:
			env_overrides.append(args.pop(0))
		else:
			usage_error("bad argument %r for 'ticket-submit'" % arg)
	if not args:
		usage_error("ticket-submit needs a command after --")
	command = " ".join(args)
	session = short_name(session_arg or os.environ.get("PI_HOSTED_SESSION")
						 or "standalone")
	dir_ = resolve_dir(dir_arg)
	env = dict(os.environ)
	for pair in env_overrides:
		key, _, value = pair.partition("=")
		if not key:
			usage_error("--env needs KEY=VALUE")
		env[key] = value
	resp = client.control({"cmd": "ticket-submit", "session": session,
						   "cwd": dir_, "command": command, "env": env})
	if not resp.get("ok"):
		die("ticket-submit failed: %s" % resp.get("error"))
	print("ticket %s" % resp["id"])


def cmd_ticket_wait(args, client):
	# Block until the ticket finishes or the timeout passes; timeout 0
	# (default) just polls the record. Prints one JSON line.
	if len(args) not in (1, 2):
		usage_error("ticket-wait takes an id and an optional timeout")
	try:
		timeout = float(args[1]) if len(args) > 1 else 0.0
	except ValueError:
		usage_error("ticket-wait timeout must be a number")
	resp = client.control({"cmd": "ticket-wait", "id": args[0],
						   "timeout": timeout},
						  timeout=CONTROL_TIMEOUT + max(0.0, timeout) + 5.0)
	if not resp.get("ok"):
		die("ticket-wait failed: %s" % resp.get("error"))
	print(json.dumps(resp["ticket"]))


def cmd_ticket_output(args, client):
	# Without offset: fetches the ticket's final output text from daemon
	# control (or full JSON record with --json).
	# With offset: the incremental base64 payload from byte offset,
	# printed verbatim: decoding and re-encoding raw bytes through a
	# text pipe corrupted non-ASCII output and drifted client offsets,
	# so the base64 form is the byte-faithful wire format.
	if len(args) < 1 or len(args) > 3:
		usage_error("ticket-output takes an id and an optional offset (or --json)")
	tid = args[0]
	json_mode = "--json" in args
	non_flag = [a for a in args[1:] if a != "--json"]
	if not non_flag:
		resp = client.control({"cmd": "ticket-output", "id": tid})
		if not resp.get("ok"):
			die("ticket-output failed: %s" % resp.get("error"))
		if json_mode:
			print(json.dumps(resp))
		else:
			out = resp.get("output", "")
			if out:
				sys.stdout.write(out if out.endswith("\n") else out + "\n")
				sys.stdout.flush()
	else:
		try:
			offset = int(non_flag[0])
		except ValueError:
			usage_error("ticket-output offset must be an integer")
		resp = client.control({"cmd": "ticket-output", "id": tid,
							   "offset": offset})
		if not resp.get("ok"):
			die("ticket-output failed: %s" % resp.get("error"))
		sys.stdout.write(resp["data"])
		sys.stdout.flush()


def cmd_ticket_list(args, client):
	# One ticket record JSON line per ticket, oldest first; a session
	# argument filters to that owning session.
	if len(args) > 1:
		usage_error("ticket-list takes an optional session name")
	req = {"cmd": "ticket-list"}
	if args:
		req["session"] = args[0]
	resp = client.control(req)
	if not resp.get("ok"):
		die("ticket-list failed: %s" % resp.get("error"))
	for ticket in resp.get("tickets") or []:
		print(json.dumps(ticket))


def cmd_ticket_cancel(args, client):
	if len(args) != 1:
		usage_error("ticket-cancel takes exactly one ticket id")
	resp = client.control({"cmd": "ticket-cancel", "id": args[0]})
	if not resp.get("ok"):
		die("ticket-cancel failed: %s" % resp.get("error"))
	print("pi-rc: ticket '%s' status %s"
		  % (args[0], resp["ticket"].get("status", "?")))


def cmd_ticket_remove(args, client):
	# Drop a finished ticket and its artifacts from the store.
	if len(args) != 1:
		usage_error("ticket-remove takes exactly one ticket id")
	resp = client.control({"cmd": "ticket-remove", "id": args[0]})
	if not resp.get("ok"):
		die("ticket-remove failed: %s" % resp.get("error"))
	print("pi-rc: removed '%s'" % args[0])


def cmd_tickets_reset(_args, client):
	# Kill the ticketing state for a reset: cancel every running ticket,
	# wipe the store and artifacts, restart the id counter. Cancellation
	# includes TERM/KILL grace, so allow a generous round trip.
	resp = client.control({"cmd": "tickets-reset"}, timeout=60)
	if not resp.get("ok"):
		die("tickets-reset failed: %s" % resp.get("error"))
	print("pi-rc: reset: cancelled %d, removed %d"
		  % (resp.get("cancelled", 0), resp.get("removed", 0)))


# ------------------------------------------------------------------ help

def print_help():
	# print this file's leading comment banner as the help text
	try:
		with open(os.path.realpath(__file__)) as f:
			lines = f.read().splitlines()
	except OSError:
		lines = []
	out = []
	for line in lines[1:]:
		if not line.startswith("#"):
			break
		out.append(line[2:] if line.startswith("# ") else "#")
	print("\n".join(out))


# ------------------------------------------------------------------ main

def main():
	client = DaemonClient()
	argv = sys.argv[1:]
	cmd = argv[0] if argv else "help"
	rest = argv[1:]
	if cmd in ("ls", "list"):
		cmd_ls(rest, client)
	elif cmd in _COMMANDS:
		{"which": cmd_which, "whichall": cmd_whichall, "owned": cmd_owned,
		 "state": cmd_state,
		 "carry": cmd_carry, "resume": cmd_resume, "start": cmd_start,
		 "attach": cmd_attach, "announce": cmd_announce,
		 "detach": cmd_detach, "stop": cmd_stop,
		 "gc-reap-ack": cmd_gc_reap_ack,
		 "handover": cmd_handover,
		 "daemon-start": cmd_daemon_start, "daemon-stop": cmd_daemon_stop,
		 "daemon-restart": cmd_daemon_restart,
		 "daemon-purge": cmd_daemon_purge,
		 "input": cmd_input, "extensions-reload": cmd_extensions_reload,
		 "ticket-submit": cmd_ticket_submit, "ticket-wait": cmd_ticket_wait,
		 "ticket-output": cmd_ticket_output, "ticket-list": cmd_ticket_list,
		 "ticket-cancel": cmd_ticket_cancel, "ticket-remove": cmd_ticket_remove,
		 "tickets-reset": cmd_tickets_reset,
		 }[cmd](rest, client)
	elif cmd == "help":
		print_help()
	else:
		usage_error("unknown command: %s" % cmd)


if __name__ == "__main__":
	try:
		main()
	except KeyboardInterrupt:
		# the bridge tty restore already ran in its finally block
		sys.exit(EXIT_OK)
	sys.exit(EXIT_OK)
